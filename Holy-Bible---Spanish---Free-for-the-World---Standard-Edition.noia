016	NEH	010	015	Buni, Azgad, Bebai,
016	NEH	010	016	Adonías, Bigvai, Adín,
016	NEH	010	017	Ater, Ezequías, Azur,
016	NEH	010	018	Hodías, Hasum, Bezai,
016	NEH	010	019	Harif, Anatot, Nobai,
016	NEH	010	020	Magpías, Mesulam, Hezir,
016	NEH	010	021	Mesezabel, Sadoc, Jadúa,
016	NEH	010	022	Pelatías, Hanán, Anaías,
016	NEH	010	023	Oseas, Hananías, Hasub,
016	NEH	010	024	Halohes, Pilha, Sobec,
