# BOOK	025	LAM	Lamentations	איכה
025	LAM	001	001	איכה ישבה בדד העיר רבתי עם היתה כאלמנה רבתי בגוים שרתי במדינות היתה למס׃
025	LAM	001	002	בכו תבכה בלילה ודמעתה על לחיה אין לה מנחם מכל אהביה כל רעיה בגדו בה היו לה לאיבים׃
025	LAM	001	003	גלתה יהודה מעני ומרב עבדה היא ישבה בגוים לא מצאה מנוח כל רדפיה השיגוה בין המצרים׃
025	LAM	001	004	דרכי ציון אבלות מבלי באי מועד כל שעריה שוממין כהניה נאנחים בתולתיה נוגות והיא מר לה׃
025	LAM	001	005	היו צריה לראש איביה שלו כי יהוה הוגה על רב פשעיה עולליה הלכו שבי לפני צר׃
025	LAM	001	006	ויצא מן בת ציון כל הדרה היו שריה כאילים לא מצאו מרעה וילכו בלא כח לפני רודף׃
025	LAM	001	007	זכרה ירושלם ימי עניה ומרודיה כל מחמדיה אשר היו מימי קדם בנפל עמה ביד צר ואין עוזר לה ראוה צרים שחקו על משבתה׃
025	LAM	001	008	חטא חטאה ירושלם על כן לנידה היתה כל מכבדיה הזילוה כי ראו ערותה גם היא נאנחה ותשב אחור׃
025	LAM	001	009	טמאתה בשוליה לא זכרה אחריתה ותרד פלאים אין מנחם לה ראה יהוה את עניי כי הגדיל אויב׃
025	LAM	001	010	ידו פרש צר על כל מחמדיה כי ראתה גוים באו מקדשה אשר צויתה לא יבאו בקהל לך׃
025	LAM	001	011	כל עמה נאנחים מבקשים לחם נתנו מחמודיהם באכל להשיב נפש ראה יהוה והביטה כי הייתי זוללה׃
025	LAM	001	012	לוא אליכם כל עברי דרך הביטו וראו אם יש מכאוב כמכאבי אשר עולל לי אשר הוגה יהוה ביום חרון אפו׃
025	LAM	001	013	ממרום שלח אש בעצמתי וירדנה פרש רשת לרגלי השיבני אחור נתנני שממה כל היום דוה׃
025	LAM	001	014	נשקד על פשעי בידו ישתרגו עלו על צוארי הכשיל כחי נתנני אדני בידי לא אוכל קום׃
025	LAM	001	015	סלה כל אבירי אדני בקרבי קרא עלי מועד לשבר בחורי גת דרך אדני לבתולת בת יהודה׃
025	LAM	001	016	על אלה אני בוכיה עיני עיני ירדה מים כי רחק ממני מנחם משיב נפשי היו בני שוממים כי גבר אויב׃
025	LAM	001	017	פרשה ציון בידיה אין מנחם לה צוה יהוה ליעקב סביביו צריו היתה ירושלם לנדה ביניהם׃
025	LAM	001	018	צדיק הוא יהוה כי פיהו מריתי שמעו נא כל עמים וראו מכאבי בתולתי ובחורי הלכו בשבי׃
025	LAM	001	019	קראתי למאהבי המה רמוני כהני וזקני בעיר גועו כי בקשו אכל למו וישיבו את נפשם׃
025	LAM	001	020	ראה יהוה כי צר לי מעי חמרמרו נהפך לבי בקרבי כי מרו מריתי מחוץ שכלה חרב בבית כמות׃
025	LAM	001	021	שמעו כי נאנחה אני אין מנחם לי כל איבי שמעו רעתי ששו כי אתה עשית הבאת יום קראת ויהיו כמוני׃
025	LAM	001	022	תבא כל רעתם לפניך ועולל למו כאשר עוללת לי על כל פשעי כי רבות אנחתי ולבי דוי׃
025	LAM	002	001	איכה יעיב באפו אדני את בת ציון השליך משמים ארץ תפארת ישראל ולא זכר הדם רגליו ביום אפו׃
025	LAM	002	002	בלע אדני לא חמל את כל נאות יעקב הרס בעברתו מבצרי בת יהודה הגיע לארץ חלל ממלכה ושריה׃
025	LAM	002	003	גדע בחרי אף כל קרן ישראל השיב אחור ימינו מפני אויב ויבער ביעקב כאש להבה אכלה סביב׃
025	LAM	002	004	דרך קשתו כאויב נצב ימינו כצר ויהרג כל מחמדי עין באהל בת ציון שפך כאש חמתו׃
025	LAM	002	005	היה אדני כאויב בלע ישראל בלע כל ארמנותיה שחת מבצריו וירב בבת יהודה תאניה ואניה׃
025	LAM	002	006	ויחמס כגן שכו שחת מועדו שכח יהוה בציון מועד ושבת וינאץ בזעם אפו מלך וכהן׃
025	LAM	002	007	זנח אדני מזבחו נאר מקדשו הסגיר ביד אויב חומת ארמנותיה קול נתנו בבית יהוה כיום מועד׃
025	LAM	002	008	חשב יהוה להשחית חומת בת ציון נטה קו לא השיב ידו מבלע ויאבל חל וחומה יחדו אמללו׃
025	LAM	002	009	טבעו בארץ שעריה אבד ושבר בריחיה מלכה ושריה בגוים אין תורה גם נביאיה לא מצאו חזון מיהוה׃
025	LAM	002	010	ישבו לארץ ידמו זקני בת ציון העלו עפר על ראשם חגרו שקים הורידו לארץ ראשן בתולת ירושלם׃
025	LAM	002	011	כלו בדמעות עיני חמרמרו מעי נשפך לארץ כבדי על שבר בת עמי בעטף עולל ויונק ברחבות קריה׃
025	LAM	002	012	לאמתם יאמרו איה דגן ויין בהתעטפם כחלל ברחבות עיר בהשתפך נפשם אל חיק אמתם׃
025	LAM	002	013	מה אעודך מה אדמה לך הבת ירושלם מה אשוה לך ואנחמך בתולת בת ציון כי גדול כים שברך מי ירפא לך׃
025	LAM	002	014	נביאיך חזו לך שוא ותפל ולא גלו על עונך להשיב שביתך ויחזו לך משאות שוא ומדוחים׃
025	LAM	002	015	ספקו עליך כפים כל עברי דרך שרקו וינעו ראשם על בת ירושלם הזאת העיר שיאמרו כלילת יפי משוש לכל הארץ׃
025	LAM	002	016	פצו עליך פיהם כל אויביך שרקו ויחרקו שן אמרו בלענו אך זה היום שקוינהו מצאנו ראינו׃
