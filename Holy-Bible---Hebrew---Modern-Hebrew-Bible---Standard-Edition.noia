# BOOK	020	PRO	Proverbs	מִשְׁלֵי
020	PRO	001	001	משלי שלמה בן דוד מלך ישראל׃
020	PRO	001	002	לדעת חכמה ומוסר להבין אמרי בינה׃
020	PRO	001	003	לקחת מוסר השכל צדק ומשפט ומישרים׃
020	PRO	001	004	לתת לפתאים ערמה לנער דעת ומזמה׃
020	PRO	001	005	ישמע חכם ויוסף לקח ונבון תחבלות יקנה׃
020	PRO	001	006	להבין משל ומליצה דברי חכמים וחידתם׃
020	PRO	001	007	יראת יהוה ראשית דעת חכמה ומוסר אוילים בזו׃
020	PRO	001	008	שמע בני מוסר אביך ואל תטש תורת אמך׃
020	PRO	001	009	כי לוית חן הם לראשך וענקים לגרגרתיך׃
020	PRO	001	010	בני אם יפתוך חטאים אל תבא׃
020	PRO	001	011	אם יאמרו לכה אתנו נארבה לדם נצפנה לנקי חנם׃
020	PRO	001	012	נבלעם כשאול חיים ותמימים כיורדי בור׃
020	PRO	001	013	כל הון יקר נמצא נמלא בתינו שלל׃
020	PRO	001	014	גורלך תפיל בתוכנו כיס אחד יהיה לכלנו׃
020	PRO	001	015	בני אל תלך בדרך אתם מנע רגלך מנתיבתם׃
020	PRO	001	016	כי רגליהם לרע ירוצו וימהרו לשפך דם׃
020	PRO	001	017	כי חנם מזרה הרשת בעיני כל בעל כנף׃
020	PRO	001	018	והם לדמם יארבו יצפנו לנפשתם׃
020	PRO	001	019	כן ארחות כל בצע בצע את נפש בעליו יקח׃
020	PRO	001	020	חכמות בחוץ תרנה ברחבות תתן קולה׃
020	PRO	001	021	בראש המיות תקרא בפתחי שערים בעיר אמריה תאמר׃
020	PRO	001	022	עד מתי פתים תאהבו פתי ולצים לצון חמדו להם וכסילים ישנאו דעת׃
020	PRO	001	023	תשובו לתוכחתי הנה אביעה לכם רוחי אודיעה דברי אתכם׃
020	PRO	001	024	יען קראתי ותמאנו נטיתי ידי ואין מקשיב׃
020	PRO	001	025	ותפרעו כל עצתי ותוכחתי לא אביתם׃
020	PRO	001	026	גם אני באידכם אשחק אלעג בבא פחדכם׃
020	PRO	001	027	בבא כשאוה פחדכם ואידכם כסופה יאתה בבא עליכם צרה וצוקה׃
020	PRO	001	028	אז יקראנני ולא אענה ישחרנני ולא ימצאנני׃
020	PRO	001	029	תחת כי שנאו דעת ויראת יהוה לא בחרו׃
020	PRO	001	030	לא אבו לעצתי נאצו כל תוכחתי׃
020	PRO	001	031	ויאכלו מפרי דרכם וממעצתיהם ישבעו׃
020	PRO	001	032	כי משובת פתים תהרגם ושלות כסילים תאבדם׃
020	PRO	001	033	ושמע לי ישכן בטח ושאנן מפחד רעה׃
020	PRO	002	001	בני אם תקח אמרי ומצותי תצפן אתך׃
020	PRO	002	002	להקשיב לחכמה אזנך תטה לבך לתבונה׃
020	PRO	002	003	כי אם לבינה תקרא לתבונה תתן קולך׃
020	PRO	002	004	אם תבקשנה ככסף וכמטמונים תחפשנה׃
020	PRO	002	005	אז תבין יראת יהוה ודעת אלהים תמצא׃
020	PRO	002	006	כי יהוה יתן חכמה מפיו דעת ותבונה׃
020	PRO	002	007	וצפן לישרים תושיה מגן להלכי תם׃
020	PRO	002	008	לנצר ארחות משפט ודרך חסידו ישמר׃
020	PRO	002	009	אז תבין צדק ומשפט ומישרים כל מעגל טוב׃
020	PRO	002	010	כי תבוא חכמה בלבך ודעת לנפשך ינעם׃
020	PRO	002	011	מזמה תשמר עליך תבונה תנצרכה׃
020	PRO	002	012	להצילך מדרך רע מאיש מדבר תהפכות׃
020	PRO	002	013	העזבים ארחות ישר ללכת בדרכי חשך׃
020	PRO	002	014	השמחים לעשות רע יגילו בתהפכות רע׃
020	PRO	002	015	אשר ארחתיהם עקשים ונלוזים במעגלותם׃
020	PRO	002	016	להצילך מאשה זרה מנכריה אמריה החליקה׃
020	PRO	002	017	העזבת אלוף נעוריה ואת ברית אלהיה שכחה׃
020	PRO	002	018	כי שחה אל מות ביתה ואל רפאים מעגלתיה׃
020	PRO	002	019	כל באיה לא ישובון ולא ישיגו ארחות חיים׃
020	PRO	002	020	למען תלך בדרך טובים וארחות צדיקים תשמר׃
020	PRO	002	021	כי ישרים ישכנו ארץ ותמימים יותרו בה׃
020	PRO	002	022	ורשעים מארץ יכרתו ובוגדים יסחו ממנה׃
020	PRO	003	001	בני תורתי אל תשכח ומצותי יצר לבך׃
020	PRO	003	002	כי ארך ימים ושנות חיים ושלום יוסיפו לך׃
020	PRO	003	003	חסד ואמת אל יעזבך קשרם על גרגרותיך כתבם על לוח לבך׃
020	PRO	003	004	ומצא חן ושכל טוב בעיני אלהים ואדם׃
020	PRO	003	005	בטח אל יהוה בכל לבך ואל בינתך אל תשען׃
020	PRO	003	006	בכל דרכיך דעהו והוא יישר ארחתיך׃
020	PRO	003	007	אל תהי חכם בעיניך ירא את יהוה וסור מרע׃
020	PRO	003	008	רפאות תהי לשרך ושקוי לעצמותיך׃
020	PRO	003	009	כבד את יהוה מהונך ומראשית כל תבואתך׃
020	PRO	003	010	וימלאו אסמיך שבע ותירוש יקביך יפרצו׃
020	PRO	003	011	מוסר יהוה בני אל תמאס ואל תקץ בתוכחתו׃
020	PRO	003	012	כי את אשר יאהב יהוה יוכיח וכאב את בן ירצה׃
020	PRO	003	013	אשרי אדם מצא חכמה ואדם יפיק תבונה׃
020	PRO	003	014	כי טוב סחרה מסחר כסף ומחרוץ תבואתה׃
020	PRO	003	015	יקרה היא מפניים וכל חפציך לא ישוו בה׃
020	PRO	003	016	ארך ימים בימינה בשמאולה עשר וכבוד׃
020	PRO	003	017	דרכיה דרכי נעם וכל נתיבותיה שלום׃
020	PRO	003	018	עץ חיים היא למחזיקים בה ותמכיה מאשר׃
020	PRO	003	019	יהוה בחכמה יסד ארץ כונן שמים בתבונה׃
020	PRO	003	020	בדעתו תהומות נבקעו ושחקים ירעפו טל׃
020	PRO	003	021	בני אל ילזו מעיניך נצר תשיה ומזמה׃
020	PRO	003	022	ויהיו חיים לנפשך וחן לגרגרתיך׃
020	PRO	003	023	אז תלך לבטח דרכך ורגלך לא תגוף׃
020	PRO	003	024	אם תשכב לא תפחד ושכבת וערבה שנתך׃
020	PRO	003	025	אל תירא מפחד פתאם ומשאת רשעים כי תבא׃
020	PRO	003	026	כי יהוה יהיה בכסלך ושמר רגלך מלכד׃
020	PRO	003	027	אל תמנע טוב מבעליו בהיות לאל ידיך לעשות׃
020	PRO	003	028	אל תאמר לרעיך לך ושוב ומחר אתן ויש אתך׃
020	PRO	003	029	אל תחרש על רעך רעה והוא יושב לבטח אתך׃
020	PRO	003	030	אל תרוב עם אדם חנם אם לא גמלך רעה׃
020	PRO	003	031	אל תקנא באיש חמס ואל תבחר בכל דרכיו׃
020	PRO	003	032	כי תועבת יהוה נלוז ואת ישרים סודו׃
020	PRO	003	033	מארת יהוה בבית רשע ונוה צדיקים יברך׃
020	PRO	003	034	אם ללצים הוא יליץ ולעניים יתן חן׃
020	PRO	003	035	כבוד חכמים ינחלו וכסילים מרים קלון׃
