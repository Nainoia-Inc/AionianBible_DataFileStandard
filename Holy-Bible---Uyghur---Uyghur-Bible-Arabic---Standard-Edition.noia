040	MAT	021	015	لېكىن باش كاھىنلار بىلەن تەۋرات ئۇستازلىرى ئۇنىڭ ياراتقان مۆجىزىلىرىنى كۆرۈپ ۋە بالىلارنىڭ ئىبادەتخانىدا: «داۋۇتنىڭ ئوغلىغا ھوساننا-تەشەككۈرلەر بولغاي!» دەپ توۋلىغىنىنى ئاڭلاپ غەزەپلەندى.
040	MAT	021	016	ئۇلار ئۇنىڭغا: ــ بۇ بالىلارنىڭ نېمە دەۋاتقانلىقىنى ئاڭلاۋاتامسەن؟ ــ دەپ سورىدى. ئۇ ئۇلارغا: ــ ئاڭلاۋاتىمەن! سىلەر [مۇقەددەس يازمىلاردىن] شۇنى ئوقۇپ باقمىغانكى، «ئۆزۈڭگە كىچىك بالىلار ۋە بوۋاقلارنىڭ تىللىرىدىن مەدھىيە سۆزلىرىنى مۇكەممەل قىلدىڭ»» دېدى.
040	MAT	021	017	ئاندىن ئۇ ئۇلاردىن ئايرىلىپ، شەھەردىن چىقىپ بەيت-ئانىيا يېزىسىغا بېرىپ، شۇ يەردە قوندى.
040	MAT	021	018	ئەمدى سەھەردە، شەھەرگە قايتىپ كېتىۋاتقاندا، ئۇنىڭ قورسىقى ئاچقانىدى.
040	MAT	021	019	ئۇ يول بويىدىكى بىر تۈپ ئەنجۈر دەرىخىنى كۆرۈپ، ئۇنىڭ يېنىغا باردى. لېكىن دەرەختىن يوپۇرماقتىن باشقا ھېچ نەرسە تاپالماي، ئۇنىڭغا قاراپ: ــ ھازىردىن باشلاپ سەندىن مەڭگۈ مېۋە بولمىسۇن! ــ دېۋىدى، ئەنجۈر دەرىخى شۇئان قۇرۇپ كەتتى.
040	MAT	021	020	مۇخلىسلار بۇنى كۆرۈپ تەئەججۈپلىنىپ: ــ ئەنجۈر دەرىخى نېمانچە تېزلا قۇرۇپ كەتتى! ــ دېدى.
040	MAT	021	021	ئەيسا ئۇلارغا جاۋاب بەردى: ــ مەن سىلەرگە شۇنى بەرھەق ئېيتىپ قويايكى، ئەگەر ھېچ گۇمان بولماي ئىشەنچىڭلار بار بولسا، ئەنجۈر دەرىخىدە بولغان ئىشلار بولۇپلا قالماي، بەلكى سىلەر ھەتتا بۇ تاغقا: «بۇ يەردىن كۆتۈرۈلۈپ دېڭىزغا تاشلان!» دېسەڭلار، ئۇ شۇنداق بولىدۇ.
040	MAT	021	022	دۇئا قىلىپ نېمىنى تىلىسەڭلار، ئىشەنچىڭلار بولسىلا، شۇلارغا ئېرىشىسىلەر، دېدى.
040	MAT	021	023	ئۇ ئىبادەتخانا ھويلىلىرىغا كىرگەندىن كېيىن، كىشىلەرگە تەلىم بېرىۋاتقاندا، باش كاھىنلار ۋە ئاقساقاللار ئۇنىڭ ئالدىغا كېلىپ: ــ سەن قىلىۋاتقان بۇ ئىشلارنى قايسى ھوقۇققا تايىنىپ قىلىۋاتىسەن؟ ساڭا بۇ ھوقۇقنى كىم بەرگەن؟ ــ دەپ سوراشتى.
040	MAT	021	024	ئەيسا ئۇلارغا جاۋاب بېرىپ: ــ مەن ئاۋۋال سىلەرگە بىر سوئال قوياي. ئەگەر سىلەر جاۋاب بەرسەڭلار، مەنمۇ بۇ ئىشلارنى قايسى ھوقۇققا تايىنىپ قىلىۋاتقانلىقىمنى ئېيتىمەن.
040	MAT	021	025	يەھيا يۈرگۈزگەن چۆمۈلدۈرۈش نەدىن كەلگەن؟ ئەرشتىنمۇ، ياكى ئىنسانلاردىنمۇ؟ ــ دەپ سورىدى. ئۇلار ئۆزئارا مۇلاھىزە قىلىشىپ: ــ ئەگەر «ئەرشتىن كەلگەن» دېسەك، ئۇ بىزگە: «ئۇنداقتا، سىلەر نېمە ئۈچۈن ئۇنىڭغا ئىشەنمىدىڭلار؟» دەيدۇ.
040	MAT	021	026	ئەگەر: «ئىنسانلاردىن كەلگەن» دېسەك، خەلقتىن قورقىمىز، چۈنكى ئۇلار ھەممىسى يەھيانى پەيغەمبەر دەپ بىلىدۇ ــ دېيىشتى.
040	MAT	021	027	بۇنىڭ بىلەن، ئۇلار ئەيساغا: بىلمەيمىز، ــ دەپ جاۋاب بېرىشتى. ــ ئۇنداقتا، مەنمۇ بۇ ئىشلارنى قايسى ھوقۇققا تايىنىپ قىلىۋاتقانلىقىمنى ئېيتمايمەن، ــ دېدى ئۇ ئۇلارغا.
040	MAT	021	028	ئەمدى بۇ ئىشقا قانداق قارايسىلەر؟ بىر ئادەمنىڭ ئىككى ئوغلى بار ئىكەن. ئۇ بىرىنچى ئوغلىنىڭ يېنىغا كېلىپ: «ئوغلۇم، بۈگۈن ئۈزۈمزارلىقىمغا بېرىپ ئىشلىگىن» دەپتۇ.
040	MAT	021	029	«بارمايمەن» دەپتۇ ئۇ، لېكىن كېيىن پۇشايمان قىلىپ يەنىلا بېرىپتۇ.
040	MAT	021	030	ئۇ ئىككىنچى ئوغلىنىڭ يېنىغا كېلىپ ئۇنىڭغىمۇ شۇنداق دەپتۇ. ئۇ: «خوپ ئەپەندىم، باراي» دەپتۇ-يۇ، لېكىن بارماپتۇ.
040	MAT	021	031	بۇ ئىككىيلەننىڭ قايسىسى ئاتىسىنىڭ ئىرادىسىنى ئادا قىلغان بولىدۇ؟ ــ بىرىنچى ئوغلى، ــ دەپ جاۋاب بەردى ئۇلار. ئەيسا ئۇلارغا مۇنداق دېدى: ــ مەن سىلەرگە شۇنى بەرھەق ئېيتىپ قويايكى، باجگىرلار بىلەن پاھىشىلەر خۇدانىڭ پادىشاھلىقىغا سىلەردىن بۇرۇن كىرمەكتە.
040	MAT	021	032	چۈنكى گەرچە يەھيا [پەيغەمبەر] سىلەرگە ھەققانىيەت يولىنى ئايان قىلغىلى كەلگەن بولسىمۇ، سىلەر ئۇنىڭغا ئىشەنمىدىڭلار؛ لېكىن باجگىرلار بىلەن پاھىشىلەر ئۇنىڭغا ئىشەندى. سىلەر بۇنى كۆرۈپ تۇرۇپ، ھەتتا كېيىنكى ۋاقىتلاردا يولۇڭلاردىن پۇشايمان قىلماي ئۇنىڭغا ئىشەنمىدىڭلار.
040	MAT	021	033	يەنە بىر تەمسىلنى ئاڭلاڭلار: بىر يەر ئىگىسى بىر ئۈزۈمزارلىق بەرپا قىلىپ، ئەتراپىنى چىتلاپتۇ. ئۇ ئۇنىڭدا بىر شاراب كۆلچىكى قېزىپتۇ ۋە بىر كۆزەت مۇنارى ياساپتۇ. ئاندىن ئۇ ئۈزۈمزارلىقنى باغۋەنلەرگە ئىجارىگە بېرىپ، ئۆزى ياقا يۇرتقا كېتىپتۇ.
040	MAT	021	034	ئۈزۈم پەسلى يېقىنلاشقاندا، ئۆزىگە تېگىشلىك ھوسۇلنى ئېلىۋېلىش ئۈچۈن قۇللىرىنى باغۋەنلەرنىڭ يېنىغا ئەۋەتىپتۇ.
040	MAT	021	035	لېكىن باغۋەنلەر قۇللىرىنى تۇتۇپ، بىرىنى دۇمبالاپتۇ، بىرىنى ئۆلتۈرۈۋېتىپتۇ، يەنە بىرىنى چالما-كېسەك قىلىپتۇ.
040	MAT	021	036	ئۇ يەنە بىر قېتىم ئالدىنقىدىنمۇ كۆپ قۇللىرىنى ئەۋەتىپتۇ، بىراق باغۋەنلەر ئۇلارغىمۇ ئوخشاش مۇئامىلە قىلىپتۇ.
040	MAT	021	037	ئاخىردا، ئۇ «ئوغلۇمنىغۇ ھۆرمەت قىلار» دەپ، ئوغلىنى ئەۋەتىپتۇ.
040	MAT	021	038	لېكىن باغۋەنلەر ئوغۇلنى كۆرۈپ، ئۆزئارا: «بۇ بولسا مىراسخور؛ كېلىڭلار، ئۇنى ئۆلتۈرۈۋېتىپ مىراسىنى ئىگىلىۋالايلى» دېيىشىپتۇ.
040	MAT	021	039	شۇنىڭ بىلەن ئۇلار ئۇنى تۇتۇپ ئۈزۈمزارلىقنىڭ سىرتىغا تاشلاپ ئۆلتۈرۈۋېتىپتۇ.
040	MAT	021	040	ئەمدى ئۈزۈمزارلىقنىڭ ئىگىسى كەلگەندە، شۇ باغۋەنلەرنى قانداق قىلار؟
040	MAT	021	041	ئۇلار ئۇنىڭغا: ــ بۇ رەزىل ئادەملەرنى ۋەھشىيلىك بىلەن يوقىتىدۇ. ئۈزۈمزارلىقنى بولسا مېۋىلىرىنى ئۆز ۋاقتىدا ئۆزىگە تاپشۇرىدىغان باشقا باغۋەنلەرگە ئىجارىگە بېرىدۇ، ــ دەپ جاۋاب بېرىشتى.
040	MAT	021	042	ئەيسا ئۇلاردىن سورىدى: ــ مۇقەددەس يازمىلاردىكى مۇنۇ سۆزلەرنى ئوقۇپ باقمىغانمۇسىلەر؟: ــ «تامچىلار تاشلىۋەتكەن تاش بولسا، بۇرجەك تېشى بولۇپ تىكلەندى. بۇ ئىش پەرۋەردىگاردىندۇر، بۇ كۆزىمىز ئالدىدا كارامەت بىر ئىشتۇر».
040	MAT	021	043	شۇ سەۋەبتىن سىلەرگە شۇنى ئېيتىپ قويايكى، خۇدانىڭ پادىشاھلىقى سىلەردىن تارتىۋېلىنىپ، ئۇنىڭغا مۇۋاپىق مېۋىلەرنى بېرىدىغان باشقا بىر ئەلگە ئاتا قىلىنىدۇ.
040	MAT	021	044	بۇ «تاش»قا يىقىلغان كىشى پارە-پارە بولۇپ كېتىدۇ؛ لېكىن بۇ تاش ھەركىمنىڭ ئۈستىگە چۈشسە، ئۇنى كۇكۇم-تالقان قىلىۋېتىدۇ.
040	MAT	021	045	باش كاھىنلار ۋە پەرىسىيلەر ئۇنىڭ ئېيتقان تەمسىللىرىنى ئاڭلاپ، ئۇلارنى ئۆزلىرىگە قارىتىپ ئېيتقانلىقىنى چۈشەندى.
040	MAT	021	046	ئۇنى تۇتۇش يولىنى ئىزدىگەن بولسىمۇ، لېكىن خالايىق ئۇنى پەيغەمبەر دەپ قارىغاچقا، ئۇلاردىن قورقۇشتى.
040	MAT	022	001	ئەيسا ئۇلارغا يەنە تەمسىللەر بىلەن مۇنداق دېدى:
040	MAT	022	002	ئەرش پادىشاھلىقى خۇددى ئۆز ئوغلى ئۈچۈن توي زىياپىتىنى تەييارلىغان بىر پادىشاھقا ئوخشايدۇ.
040	MAT	022	003	ئۇ چاكارلىرىنى توي زىياپىتىگە تەكلىپ قىلىنغانلارنى چاقىرىشقا ئەۋەتىپتۇ، لېكىن ئۇلار كېلىشكە ئۇنىماپتۇ.
040	MAT	022	004	ئۇ يەنە باشقا چاكارلىرىنى ئەۋەتىپ، ئۇلارغا تاپىلاپ: «چاقىرىلغانلارغا: ــ مانا، مەن زىياپىتىمنى تەييار قىلدىم؛ مېنىڭ تورپاقلىرىم، بورداق ماللىرىم سويۇلدى، ھەممە نەرسە تەييار. زىياپەتكە مەرھەمەت قىلغاي، دەيدۇ، دەپ ئېيتىڭلار، ــ دەپتۇ.
040	MAT	022	005	بىراق ئۇلار تەكلىپىنى ئېتىبارغا ئالماي، بىرسى ئېتىزلىقىغا كەتسە، يەنە بىرى سودىسىغا كېتىپتۇ.
040	MAT	022	006	قالغانلىرى بولسا [پادىشاھنىڭ] چاكارلىرىنى تۇتۇۋېلىپ، خورلاپ ئۆلتۈرۈۋېتىپتۇ.
040	MAT	022	007	پادىشاھ بۇنى ئاڭلاپ قاتتىق غەزەپلىنىپ، ئەسكەرلىرىنى چىقىرىپ، ئۇ قاتىللارنى يوقىتىپ، ئۇلارنىڭ شەھىرىگە ئوت قويۇۋېتىپتۇ.
040	MAT	022	008	ئاندىن ئۇ چاكارلىرىغا: «توي زىياپىتى تەييار بولدى، لېكىن چاقىرىلغانلار [مېھمانلىققا] مۇناسىپ كەلمىدى.
040	MAT	022	009	ئەمدى سىلەر ئاچا يوللارغا بېرىپ، ئۇدۇل كەلگەن ئادەملەرنىڭ ھەممىسىنى توي زىياپىتىگە تەكلىپ قىلىڭلار» دەپتۇ.
040	MAT	022	010	بۇنىڭ بىلەن چاكارلار يوللارغا چىقىپ، ياخشى بولسۇن، يامان بولسۇن، ئۇدۇل كەلگەنلىكى ئادەملەرنىڭ ھەممىسىنى يىغىپ ئەكەپتۇ. توي سورۇنى مېھمانلار بىلەن لىق تولۇپتۇ.
040	MAT	022	011	پادىشاھ مېھمانلار بىلەن كۆرۈشكىلى كىرگەندە، ئۇ يەردە زىياپەت كىيىمى كىيمىگەن بىر كىشىنى كۆرۈپتۇ.
040	MAT	022	012	پادىشاھ ئۇنىڭدىن: «بۇرادەر، زىياپەت كىيىمى كىيمەي، بۇ يەرگە قانداق كىردىڭ؟» دەپ سوراپتۇ، بىراق ئۇ كىشى جاۋاب بېرەلمەي قاپتۇ.
040	MAT	022	013	پادىشاھ چاكارلىرىغا: «ئۇنى پۇت-قوللىرىدىن باغلاپ، تېشىدىكى قاراڭغۇلۇققا ئاچىقىپ تاشلاڭلار! ئۇ يەردە يىغا-زارلار كۆتۈرۈلىدۇ، چىشلىرى غۇچۇرلايدۇ» دەپتۇ.
040	MAT	022	014	چۈنكى چاقىرىلغانلار كۆپ، لېكىن تاللانغانلار ئازدۇر.
040	MAT	022	015	بۇنىڭ بىلەن پەرىسىيلەر ئۇ يەردىن چىقىپ، قانداق قىلىپ ئۇنى ئۆز سۆزى بىلەن تۇزاققا چۈشۈرۈش ھەققىدە مەسلىھەتلەشتى.
040	MAT	022	016	ئۇلار مۇخلىسلىرىنى ھېرودنىڭ تەرەپدارلىرى بىلەن بىللە ئۇنىڭ يېنىغا ئەۋەتىپ: ــ ئۇستاز، سىلىنى سەمىمىي ئادەم، كىشىلەرگە خۇدانىڭ يولىنى سادىقلىق بىلەن ئۆگىتىپ كېلىۋاتىدۇ ۋە ئادەملەرگە قەتئىي يۈز-خاتىرە قىلماي ھېچكىمگە يان باسمايدۇ، دەپ بىلىمىز.
040	MAT	022	017	قېنى، قانداق ئويلايلا؟ [رىم ئىمپېراتورى] قەيسەرگە باج-سېلىق تاپشۇرۇش تەۋرات قانۇنىغا ئۇيغۇنمۇ-يوق؟ ــ دېيىشتى.
040	MAT	022	018	لېكىن ئەيسا ئۇلارنىڭ رەزىل نىيىتىنى بىلىپ: ــ ئەي ساختىپەزلەر، مېنى نېمىشقا سىنىماقچىسىلەر؟
040	MAT	022	019	قېنى، باجغا تاپشۇرۇلىدىغان بىر تەڭگە ماڭا كۆرسىتىڭلار، ــ دېدى. ئۇلار بىر دىنار پۇلىنى ئەكەلدى.
040	MAT	022	020	ئۇ ئۇلاردىن: ــ بۇنىڭ ئۈستىدىكى سۈرەت ۋە نام-ئىسىم كىمنىڭ؟ ــ دەپ سورىدى.
040	MAT	022	021	قەيسەرنىڭ، ــ دەپ جاۋاب بەردى ئۇلار. ئۇ ئۇلارغا: ــ ئۇنداق بولسا، قەيسەرنىڭ ھەققىنى قەيسەرگە، خۇدانىڭ ھەققىنى خۇداغا تاپشۇرۇڭلار، ــ دېدى.
040	MAT	022	022	ئۇلار بۇ سۆزنى ئاڭلاپ، ھەيران بولۇپ قېلىشتى-دە، ئۇنىڭ يېنىدىن كېتىپ قالدى.
040	MAT	022	023	شۇ كۈنى، «ئۆلگەنلەر تىرىلمەيدۇ» دەيدىغان سادۇقىيلار ئۇنىڭ ئالدىغا كېلىپ قىستاپ سوئال قويدى:
040	MAT	022	024	ــ ئۇستاز، مۇسا [پەيغەمبەر تەۋراتتا]: «بىر كىشى پەرزەنتسىز ئۆلۈپ كەتسە، ئۇنىڭ ئاكا ياكى ئىنىسى تۇل يەڭگىسىنى ئەمرىگە ئېلىپ، قېرىندىشى ئۈچۈن نەسىل قالدۇرۇشى لازىم» دەپ تاپىلىغان.
040	MAT	022	025	بۇرۇن ئارىمىزدا يەتتە ئاكا-ئۇكا بار ئىدى. چوڭى ئۆيلەنگەندىن كېيىن ئۆلۈپ كەتتى. پەرزەنت كۆرمىگەنلىكتىن، ئايالىنى ئىككىنچى قېرىندىشىنىڭ ئەمرىگە قالدۇردى.
040	MAT	022	026	بىراق ئىككىنچىسىدىكى ئەھۋالمۇ ئۇنىڭكىگە ئوخشاش بولدى، ئاندىن بۇ ئىش ئۈچىنچىسىدە تاكى يەتتىنچى قېرىنداشقىچە ئوخشاش داۋاملاشتى.
040	MAT	022	027	ئاخىردا، ئۇ ئايالمۇ ئۆلۈپ كەتتى.
040	MAT	022	028	ئەمدى تىرىلىش كۈنىدە بۇ ئايال يەتتە ئاكا-ئۇكىنىڭ قايسىسىنىڭ ئايالى بولىدۇ؟ چۈنكى ئۇنى ھەممىسى ئەمرىگە ئالغان-دە!
040	MAT	022	029	ئەيسا ئۇلارغا مۇنداق جاۋاب بەردى: ــ سىلەر نە مۇقەددەس يازمىلارنى نە خۇدانىڭ قۇدرىتىنى بىلمىگەنلىكىڭلار ئۈچۈن ئازغانسىلەر.
040	MAT	022	030	چۈنكى ئۆلۈمدىن تىرىلگەندە ئىنسانلار ئۆيلەنمەيدۇ، ئەرگە تەگمەيدۇ، بەلكى خۇدانىڭ ئەرشتىكى پەرىشتىلىرىگە ئوخشاش بولىدۇ.
040	MAT	022	031	ئەمدى ئۆلۈمدىن تىرىلىش مەسىلىسى ھەققىدە خۇدانىڭ سىلەرگە ئېيتقان:
040	MAT	022	032	«مەن ئىبراھىم، ئىسھاق ۋە ياقۇپلارنىڭ خۇداسىدۇرمەن!» دېگەن شۇ سۆزىنى ئوقۇمىدىڭلارمۇ؟ خۇدا ئۆلۈكلەرنىڭ ئەمەس، بەلكى تىرىكلەرنىڭ خۇداسىدۇر!».
040	MAT	022	033	بۇ سۆزنى ئاڭلىغان خەلق ئۇنىڭ تەلىمىدىن ھەيرانۇھەس قېلىشتى.
040	MAT	022	034	پەرىسىيلەر ئۇنىڭ سادۇقىيلارنىڭ ئاغزىنى تۇۋاقلىغانلىقىنى ئاڭلاپ، بىر يەرگە جەم بولۇشتى.
040	MAT	022	035	ئۇلارنىڭ ئارىسىدىكى بىر تەۋرات-قانۇن ئۇستازى ئۇنى سىناش مەقسىتىدە ئۇنىڭدىن:
040	MAT	022	036	ــ ئۇستاز، تەۋرات قانۇنىدىكى ئەڭ مۇھىم ئەمر قايسى؟ ــ دەپ قىستاپ سورىدى.
040	MAT	022	037	ئۇ ئۇنىڭغا مۇنداق دېدى: ــ «پەرۋەردىگار خۇدايىڭنى پۈتۈن قەلبىڭ، پۈتۈن جېنىڭ، پۈتۈن زېھنىڭ بىلەن سۆيگىن»
040	MAT	022	038	ــ ئەڭ ئۇلۇغ، بىرىنچى ئورۇندا تۇرىدىغان ئەمر مانا شۇ.
040	MAT	022	039	ئۇنىڭغا ئوخشايدىغان ئىككىنچى ئەمر بولسا «قوشناڭنى ئۆزۈڭنى سۆيگەندەك سۆي».
040	MAT	022	040	پۈتۈن تەۋرات قانۇنى ۋە پەيغەمبەرلەرنىڭ سۆزلىرى بۇ ئىككى ئەمرگە ئېسىلغان ھالدا ماڭىدۇ.
040	MAT	022	041	پەرىسىيلەر جەم بولۇپ تۇرغان ۋاقىتتا، ئەيسا ئۇلاردىن:
040	MAT	022	042	ــ مەسىھ توغرىسىدا قانداق ئويلاۋاتىسىلەر؟ ئۇ كىمنىڭ ئوغلى؟ ــ دەپ سورىدى. داۋۇتنىڭ ئوغلى، ــ دېيىشتى ئۇلار.
040	MAT	022	043	ئۇ ئۇلارغا مۇنداق دېدى: ئۇنداقتا، نېمە ئۈچۈن [زەبۇردا] داۋۇت مەسىھنى روھتا «رەببىم» دەپ ئاتاپ، ــ
040	MAT	022	044	«پەرۋەردىگار مېنىڭ رەببىمگە ئېيتتىكى: ــ «مەن سېنىڭ دۈشمەنلىرىڭنى ئايىغىڭ ئاستىدا دەسسەتكۈچە، ئوڭ يېنىمدا ئولتۇرغىن!» ــ دەيدۇ؟
040	MAT	022	045	داۋۇت [مەسىھنى] شۇنداق «رەببىم» دەپ ئاتىغان تۇرسا، ئەمدى مەسىھ قانداقمۇ داۋۇتنىڭ ئوغلى بولىدۇ؟
040	MAT	022	046	ۋە ھېچكىم ئۇنىڭغا جاۋابەن بىر ئېغىزمۇ سۆز قايتۇرالمىدى؛ شۇ كۈندىن ئېتىبارەن، ھېچكىم ئۇنىڭدىن سوئال سوراشقىمۇ پېتىنالمىدى.
040	MAT	023	001	بۇ سۆزلەردىن كېيىن، ئەيسا توپ-توپ خالايىققا ۋە مۇخلىسلىرىغا مۇنداق دېدى:
040	MAT	023	002	ــ تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر مۇسا پەيغەمبەرنىڭ [ھۆكۈم چىقىرىش] ئورنىدا ئولتۇرغان بولىدۇ.
040	MAT	023	003	شۇڭا، ئۇلارنىڭ سىلەرگە ئېيتقان ھەممە سۆزلىرىگە كۆڭۈل قويۇپ، دېگەنلىرىنى قىلىڭلار. لېكىن ئۇلارنىڭ قىلغانلىرىدەك قىلماڭلار؛ چۈنكى ئۇلار ئۆزلىرىنىڭ دېگىنىگە ئۆزلىرى ئەمەل قىلمايدۇ،
040	MAT	023	004	بەلكى ئۇلار كۆتۈرەلمىگۈدەك ئېغىر يۈكلەرنى باغلاپ ئادەملەرنىڭ زىممىسىگە ئارتىپ قويىدۇ. ئەمما ئۆزلىرى بۇ يۈكلەرنى كۆتۈرۈشكە بىرمۇ بارمىقىنى مىدىرلىتىشنى خۇشياقمايدۇ.
040	MAT	023	005	ئۇلار ھەممە ئەمەللىرىنى ئىنسانلارغا كۆز-كۆز قىلىش ئۈچۈنلا قىلىدۇ؛ چۈنكى ئۇلار «ئايەت قاپلىرى»نى كەڭ قىلىپ چىگىۋېلىپ، تونلىرىنىڭ چۇچىلىرىنى ئۇزۇن ساڭگىلىتىپ قويىدۇ؛
040	MAT	023	006	ئۇلار زىياپەتلەردە تۆردە، سىناگوگلاردا ئالدىنقى ئورۇنلاردا ئولتۇرۇشقا،
040	MAT	023	007	بازارلاردا كىشىلەرنىڭ ئۇلارغا بولغان [ئۇزۇن] سالاملىرىغا ۋە ئۆزلىرىنى «ئۇستاز، ئۇستاز» دەپ ئاتاشلىرىغا ئامراق كېلىدۇ.
040	MAT	023	008	بىراق سىلەر بولساڭلار «ئۇستاز» دەپ ئاتىلىشنى قوبۇل قىلماڭلار؛ چۈنكى سىلەرنىڭ يالغۇز بىرلا ئۇستازىڭلار بار ۋە ھەممىڭلار قېرىنداشتۇرسىلەر.
040	MAT	023	009	يەر يۈزىدە ھېچقانداق كىشىنى «ئاتام» دېمەڭلار، چۈنكى پەقەت بىرلا ئاتاڭلار، يەنى ئەرشتە تۇرغۇچى باردۇر.
040	MAT	023	010	سىلەر «مۇئەللىم» دەپ ئاتىلىشنىمۇ قوبۇل قىلماڭلار، چۈنكى پەقەت بىرلا مۇئەللىم، يەنى مەسىھنىڭ ئۆزى باردۇر؛
040	MAT	023	011	بەلكى ئاراڭلاردا ئەڭ مەرتىۋىلىك بولغان كىشى سىلەرنىڭ خىزمىتىڭلاردا بولىدۇ.
040	MAT	023	012	ئۆزىنى يۇقىرى تۇتماقچى بولغىنى تۆۋەن قىلىنىدۇ، ئۆزىنى تۆۋەن تۇتقىنى يۇقىرى قىلىنىدۇ.
040	MAT	023	013	بىراق ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! سىلەر ئەرش پادىشاھلىقىنىڭ ئىشىكىنى ئىنسانلارغا تاقاپ كېلىۋاتىسىلەر! يا ئۆزۈڭلار كىرمەيسىلەر، يا كىرىشنى ئىستىگەنلەرنىڭ كىرىشىگە يول قويمايسىلەر.
040	MAT	023	014	ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! سىلەر تۇل ئاياللارنىڭ مال-دۇنياسىنى يەۋاتىسىلەر، شۇنداقتىمۇ باشقىلار ئالدىدا تەقۋادار كۆرۈنسەك دەپ، ئۇزۇندىن-ئۇزۇن دۇئا قىلىسىلەر. شۇڭا، سىلەر تېخىمۇ ئېغىر جازاغا تارتىلىسىلەر.
040	MAT	023	015	ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! سىلەر بىرلا ئادەمنى ئېتىقادىڭلارغا كىرگۈزۈش ئۈچۈن، دېڭىز ۋە قۇرۇقلۇقنى كېزىپ چىقىسىلەر. بىراق ئۇ كىشى كىرگۈزۈلگەندىن كېيىن، سىلەر ئۇنى ئۆزلىرىڭلاردىن ئىككى ھەسسە بەتتەر بولغان دوزاخنىڭ پەرزەنتى قىلىپ يېتىشتۈرۈپ چىقىسىلەر.
040	MAT	023	016	ھالىڭلارغا ۋاي، ئەي قارىغۇ يولباشچىلار! سىلەر: «ھەرقانداق كىشى ئىبادەتخانا بىلەن قەسەم قىلسا، ھېچنېمىسى يوق، بىراق ئىبادەتخانىدىكى ئالتۇننى تىلغا ئېلىپ قەسەم قىلغانلار قەسىمىدە تۇرۇشقا قەرزدار بولىدۇ» دەيسىلەر.
040	MAT	023	017	ئەي كور ئەخمەقلەر! ئالتۇن ئۇلۇغمۇ ياكى ئالتۇننى مۇقەددەس قىلغان ئىبادەتخانىمۇ؟
040	MAT	023	018	سىلەر يەنە: «ھەركىم قۇربانگاھ بىلەن قەسەم قىلسا، ھېچنېمىسى يوق، بىراق قۇربانگاھ ئۈستىدىكى ھەدىيەنى تىلغا ئېلىپ قەسەم قىلغانلار قەسىمىدە تۇرۇشقا قەرزدار بولىدۇ» دەيسىلەر.
040	MAT	023	019	ئەي كورلار! ھەدىيە ئۇلۇغمۇ ياكى ھەدىيىنى مۇقەددەس قىلغان قۇربانگاھمۇ؟
040	MAT	023	020	شۇڭا، قۇربانگاھنى تىلغا ئېلىپ قەسەم قىلغۇچى بولسا ھەم قۇربانگاھ بىلەن ھەم ئۇنىڭ ئۈستىدىكى بارلىق نەرسىلەر بىلەن قەسەم قىلغان بولىدۇ.
040	MAT	023	021	ئىبادەتخانىنى تىلغا ئېلىپ قەسەم قىلغۇچىمۇ ھەم ئىبادەتخانىنى، ھەم «ئىبادەتخانىدا تۇرغۇچى»نى تىلغا ئېلىپ قەسەم قىلغان بولىدۇ.
040	MAT	023	022	ئەرشنى تىلغا ئېلىپ قەسەم قىلغۇچى خۇدانىڭ تەختى ۋە تەختتە ئولتۇرغۇچىنىڭ نامى بىلەن قەسەم قىلغان بولىدۇ.
040	MAT	023	023	ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! چۈنكى سىلەر ھەتتا يالپۇز، ئارپىبەدىيان ۋە زىرىلەرنىڭ ئوندىن بىر ئۈلۈشىنى ئۆشرە قىلىپ خۇداغا ئاتايسىلەر-يۇ، بىراق تەۋرات قانۇنىنىڭ تېخىمۇ ۋەزىنلىك تەرەپلىرى بولغان ئادالەت، رەھىمدىللىق ۋە سادىقلىقنى ئېتىبارغا ھېچ ئالمايسىلەر. ئاۋۋال مۇشۇ ئىشلارنى ئورۇندىشىڭلار كېرەك، ئاندىن شۇ ئىشلارنىمۇ ئادا قىلماي قويماسلىقىڭلار كېرەك.
040	MAT	023	024	ئەي قارىغۇ يولباشچىلار! سىلەر [چىنەڭلەردىكى] پاشىنى سۈزۈپ ئېلىۋېتىسىلەر، لېكىن بىرەر تۆگىنى پۈتۈن پېتى يۇتۇۋېتىسىلەر!
040	MAT	023	025	ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! سىلەر چىنە-قاچىلارنىڭ تېشىنىلا يۇيۇپ پاكىزلىغىنىڭلار بىلەن ئۇلارنىڭ ئىچى ھەرتۈرلۈك ھېرىسلىك ۋە ئىشرەتپەرەسلىككە تولغان.
040	MAT	023	026	ئەي قارىغۇ پەرىسىي! ئاۋۋال چىنە-قاچىنىڭ ئىچىنى پاكلا، شۇنداقتا تېشىمۇ پاك بولىدۇ!
040	MAT	023	027	ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! سىلەر ئاقارتىپ قويۇلغان، سىرتى چىرايلىق كۆرۈنىدىغان لېكىن ئىچى ئۆلۈكلەرنىڭ ئۇستىخانلىرى ۋە ھەرخىل ناپاك نەرسىلەرگە تولغان قەبرىلەرگە ئوخشايسىلەر.
040	MAT	023	028	شۇنىڭدەك تېشىڭلاردىن ئىنسانلارنىڭ ئالدىدا ھەققانىي ئادەملەردەك كۆرۈنىسىلەر، لېكىن ئىچىڭلار ساختىپەزلىك ۋە ئىتائەتسىزلىك بىلەن تولغان.
040	MAT	023	029	ھالىڭلارغا ۋاي، ئەي تەۋرات ئۇستازلىرى ۋە پەرىسىيلەر، ساختىپەزلەر! چۈنكى سىلەر پەيغەمبەرلەرنىڭ قەبرىلىرىنى ياساپ كېلىۋاتىسىلەر، ھەققانىيلارنىڭ مازارلىرىنى بېزەپ كېلىۋاتىسىلەر
040	MAT	023	030	ۋە سىلەر: «ئاتا-بوۋىلىرىمىزنىڭ زامانىدا ياشىغان بولساق ئىدۇق، ئۇلارنىڭ پەيغەمبەرلەرنىڭ قېنىنى تۆكۈشلىرىگە شېرىك بولمايتتۇق» ــ دەيسىلەر.
040	MAT	023	031	شۇڭا سىلەر ئۆز سۆزۈڭلار بىلەن ئۆزۈڭلارنىڭ پەيغەمبەرلەرنى ئۆلتۈرگەنلەرنىڭ ئەۋلادلىرى ئىكەنلىكىڭلارغا گۇۋاھلىق بەردىڭلار.
040	MAT	023	032	ئۇنداقتا، ئاتا-بوۋىلىرىڭلار باشلىغان قىلمىشلىرىنى تولۇقلاڭلار!
040	MAT	023	033	ئەي يىلانلار! زەھەرلىك يىلانلارنىڭ نەسىللىرى! دوزاخ جازاسىدىن قانداقمۇ قۇتۇلالارسىلەر؟
040	MAT	023	034	شۇڭا مانا، سىلەرگە پەيغەمبەرلەر، دانىشمەنلەر ۋە ئالىملارنى ئەۋەتىپ تۇرىمەن. سىلەر ئۇلارنىڭ بەزىلىرىنى كرېستلەپ ئۆلتۈرىسىلەر، بەزىلىرىنى سىناگوگلىرىڭلاردا دەررىگە باسىسىلەر، شەھەردىن شەھەرگە قوغلايسىلەر.
040	MAT	023	035	شۇنداق قىلىپ، ھەققانىي ھابىلنىڭ قان قەرزىدىن تارتىپ تاكى سىلەر ئىبادەتخانىدىكى مۇقەددەس جاي بىلەن قۇربانگاھنىڭ ئارىلىقىدا ئۆلتۈرگەن بەرەكىيانىڭ ئوغلى زەكەرىيانىڭ قان قەرزىگىچە، ھەققانىيلارنىڭ يەر يۈزىدە ئېقىتىلغان بارلىق قان قەرزلىرى سىلەرنىڭ بېشىغا چۈشۈرۈلىدۇ.
040	MAT	023	036	مەن سىلەرگە بەرھەق شۇنى ئېيتىپ قويايكى، شۇ قىلمىشلارنىڭ جازاسىنىڭ ھەممىسى مۇشۇ دەۋرنىڭ بېشىغا چۈشىدۇ.
040	MAT	023	037	ئەي يېرۇسالېم، يېرۇسالېم! پەيغەمبەرلەرنى ئۆلتۈرىدىغان، ئۆزىگە ئەۋەتىلگەن ئەلچىلەرنى چالما-كېسەك قىلىدىغان شەھەر! مېكىيان چۈجىلىرىنى قانات ئاستىغا يىغقاندەك پەرزەنتلىرىڭنى قانچە قېتىم قوينۇمغا ئالماقچى بولدۇم، لېكىن سىلەر ئۇنىمىدىڭلار!
040	MAT	023	038	مانا، ئەمدى ئۆيۈڭلار سىلەرگە خارابە بولۇپ قالىدۇ!
040	MAT	023	039	چۈنكى مەن شۇنى سىلەرگە ئېيتىپ قويايكى، سىلەر: «پەرۋەردىگارنىڭ نامىدا كەلگۈچىگە مۇبارەك بولسۇن!» دېمىگۈچە، سىلەر مېنى قايتىدىن ھېچ كۆرەلمەيسىلەر.
040	MAT	024	001	ئەيسا ئىبادەتخانىدىن چىقىپ، ئالدىغا كېتىۋاتقاندا، مۇخلىسلىرى يېنىغا كېلىپ ئۇنىڭ دىققىتىنى ئىبادەتخانا بىنالىرىغا تارتماقچى بولدى. «مات.»
040	MAT	024	002	ئۇ ئۇلارغا: ــ مانا بۇلارنىڭ ھەممىسىنى كۆرۈۋاتامسىلەر؟ مەن سىلەرگە بەرھەق شۇنى ئېيتىپ قويايكى، بۇ يەردە بىر تال تاشمۇ تاش ئۈستىدە قالمايدۇ، ھەممىسى قالدۇرۇلماي گۇمران قىلىنىدۇ، ــ دېدى.
040	MAT	024	003	ئۇ زەيتۇن تېغىدا ئولتۇرغاندا، مۇخلىسلىرى ئاستىغىنا ئۇنىڭ يېنىغا كېلىپ: ــ بىزگە ئېيتقىنچۇ، بۇ دېگەنلىرىڭ قاچان يۈز بېرىدۇ؟ سېنىڭ [قايتىپ] كېلىشىڭ ۋە زاماننىڭ ئاخىرىنى كۆرسىتىدىغان قانداق ئالامەت بولىدۇ؟ ــ دەپ سوراشتى.
040	MAT	024	004	ئەيسا ئۇلارغا جاۋابەن مۇنداق دېدى: ــ ھېزى بولۇڭلاركى، ھېچكىم سىلەرنى ئازدۇرۇپ كەتمىسۇن.
040	MAT	024	005	چۈنكى نۇرغۇن كىشىلەر مېنىڭ نامىمدا كېلىپ: «مەسىھ مەن بولىمەن» دەپ، كۆپ ئادەملەرنى ئازدۇرىدۇ.
040	MAT	024	006	سىلەر ئۇرۇش خەۋەرلىرى ۋە ئۇرۇش شەپىلىرىنى ئاڭلايسىلەر، بۇلاردىن ئالاقزادە بولۇپ كەتمەڭلار؛ چۈنكى بۇ ئىشلارنىڭ يۈز بېرىشى مۇقەررەر. لېكىن بۇلار ئاخىرەت ئەمەس.
040	MAT	024	007	چۈنكى بىر مىللەت يەنە بىر مىللەت بىلەن ئۇرۇشقا چىقىدۇ، بىر پادىشاھلىق يەنە بىر پادىشاھلىق بىلەن ئۇرۇشقا چىقىدۇ. جاي-جايلاردا ئاچارچىلىق، ۋابالار ۋە يەر تەۋرەشلەر يۈز بېرىدۇ.
