002	EXO	021	020	ئەگەر بىرسى قۇلى ياكى دېدىكىنى تاياقتا ئۇرسا، شۇنداقلا قۇل ياكى دېدەك نەق مەيداندا ئۆلۈپ كەتسە، ئۇنىڭ ئۈچۈن [ئىگىسى] چوقۇم جازاغا تارتىلسۇن.
002	EXO	021	021	لېكىن ئەگەر تاياق يېگۈچى بىر-ئىككى كۈن تىرىك تۇرسا، ئۇنداقتا قۇل خوجايىنىنىڭ شەخسى مال-مۈلكى بولغىنى ئۈچۈن، قۇلنىڭ جازاسىغا تارتىلمىسۇن.
002	EXO	021	022	ئەگەر كىشىلەر بىر-بىرى بىلەن ئۇرۇشۇپ قېلىپ، ھامىلىدار بىر ئايالنى ئۇرۇپ سالسا، ھامىلىدار ئايالدا بالىسى بالدۇر تۇغۇلۇشىدىن باشقا زەخىملىنىش بولمىسا، ئايالنىڭ ئېرىنىڭ تۆلەم تەلىپى بويىچە ھاكىملارنىڭ تەستىقىدىن ئۆتكۈزۈلۈپ جەرىمانە تۆلىسۇن.
002	EXO	021	023	ئەگەر [ئايال ياكى بالا] زىيان-زەخەتكە ئۇچرىغان بولسا، ئۇنداقتا جېنىغا جان،
002	EXO	021	024	كۆزىگە كۆز، چىشىغا چىش، قولىغا قول، پۇتىغا پۇت،
002	EXO	021	025	كۆيۈككە كۆيۈك، زەخىمگە زەخىم، كۆككە كۆك تۆلەنسۇن.
002	EXO	021	026	ئەگەر بىرسى ئۆز قۇل يا دېدىكىنىڭ كۆزىنى ئۇرۇپ ناكار قىلىپ قويسا، كۆزى ۋەجىدىن ئۇنى ئازاد قىلسۇن.
002	EXO	021	027	شۇنىڭدەك بىرسى ئۆز قۇلى يا دېدىكىنىڭ چىشىنى ئۇرۇپ چىقىرىۋەتكەن بولسا، چىشى ۋەجىدىن ئۇنى ئازاد قىلسۇن».
002	EXO	021	028	ئەگەر بىر كالا بىر ئەر ياكى ئايال كىشىنى ئۈسۈپ ئۆلتۈرۈپ قويسا، شۇ كالا چوقۇم چالما-كېسەك قىلىنىشى كېرەك، ئۇنىڭ گۆشى يېيىلمىسۇن. لېكىن كالىنىڭ ئىگىسىگە گۇناھ كەلمىسۇن.
002	EXO	021	029	لېكىن بۇ ئۇينىڭ ئىلگىرىدىن ئۈسۈش ئادىتى بولۇپ، ئىگىسىگە بۇ ھەقتە ئاگاھ بېرىلگەن بولسا، لېكىن يەنىلا ئۇنى باغلىمىغىنى ئۈچۈن ئەر-ئايال كىشىلەرنى ئۈسۈپ ئۆلتۈرۈپ قويغان بولسا، ئۇنداقتا كالا چالما-كېسەك قىلىنسۇن، ئىگىسىمۇ ئۆلۈمگە مەھكۇم قىلىنسۇن.
002	EXO	021	030	لېكىن ئۇنىڭدىن خۇن ھەققى تەلەپ قىلىنسا، ئۆز جېنىنىڭ ئورنىدا ئۇنىڭغا قانچىلىك تۆلەم قويۇلغان بولسا شۇنى بەرسۇن.
002	EXO	021	031	كالىدىن ئۈسۈلگۈچى ئوغۇل ياكى قىز بالا بولسا، كالىنىڭ ئىگىسى ئوخشاشلا يۇقىرىقى ھۆكۈمدىكىدەك بىر تەرەپ قىلىنسۇن.
002	EXO	021	032	كالا قۇل ياكى دېدەكنى ئۈسكەن بولسا، كالىنىڭ ئىگىسى ئۈسۈلگۈچىنىڭ خوجىسىغا ئوتتۇز شەكەل كۈمۈش بەرسۇن؛ ئاندىن كالا چالما-كېسەك قىلىنسۇن.
002	EXO	021	033	ئەگەر بىرسى بىر ئورىنىڭ ئاغزىنى ئوچۇق قويۇپ ياكى كولاۋاتقان ئورىنىڭ ئاغزىنى ياپماي، كالا ياكى ئېشەك ئۇنىڭغا چۈشۈپ كەتسە،
002	EXO	021	034	ئۇنداقتا ئورىنىڭ ئىگىسى مال ئىگىسىنىڭ زىيىنىنى تولۇق تۆلەپ بەرسۇن؛ ئۆلگەن مال ئۇنىڭكى بولىدۇ.
002	EXO	021	035	ئەگەر بىرسىنىڭ كالىسى يەنە بىرسىنىڭ كالىسىنى ئۈسۈپ ئۆلتۈرۈپ قويغان بولسا، ئۇنداقتا ئۇلار تىرىك قالغان كالىنى سېتىپ، پۇلنى باراۋەر بۆلۈشسۇن ھەم ئۆلۈك كالىنىمۇ شۇنداق بۆلۈشسۇن.
002	EXO	021	036	لېكىن كالىنىڭ ئىلگىرىدىن ئۈسىدىغان ئادىتى بارلىقى ئېنىق تۇرۇپ، ئىگىسى ئۇنى باغلىماي قويۇۋەتكەن بولسا، ئۇنداقتا ئۈسكۈچى كالىنىڭ ئىگىسى كالىغا كالا تۆلەپ بەرسۇن، ئۆلۈك كالا ئۇنىڭ بولسۇن.
002	EXO	022	001	ئەگەر بىرسى بىر كالا ياكى قوينى ئوغرىلاپ، ئۇنى سويسا يا سېتىۋەتسە، ئۇ بىر كالىنىڭ ئورنىغا بەش كالا، بىر قوينىڭ ئورنىغا تۆت قوي تۆلىسۇن.
002	EXO	022	002	ئوغرى تام تەشكەندە تۇتۇلۇپ قېلىپ، تاياق يەپ ئۆلۈپ قالسا، ئۆلتۈرگۈچىگە خۇن جازاسى كەلمىسۇن.
002	EXO	022	003	لېكىن شۇ ۋەقە بولغان پەيتتە كۈن چىقىپ قالغان بولسا، ئۇنداقتا ئۆلتۈرگۈچى خۇن جازاسىغا تارتىلسۇن. ئوغرى ئوغرىلىغىنىنى تۆلەپ زىياننى تولۇقلاپ بېرىشى كېرەك؛ ئۇنىڭدا بىر نېمە بولمىسا، قۇللۇققا سېتىلىپ، ئوغرىلىغان نەرسىنى تۆلىشى كېرەك.
002	EXO	022	004	ئوغرى تۇتۇلغاندا ئوغرىلىغان نەرسە، كالا بولسۇن، ئېشەك بولسۇن، قوي بولسۇن ئۇنىڭ قولىدا تىرىك ھالەتتە تېپىلسا، ئۇ ئىككى ھەسسە قىممەتتە تۆلەپ بەرسۇن.
002	EXO	022	005	ئەگەر بىرسى ئۆز مال-چارۋىلىرىنى ئېتىزلىققا ياكى ئۈزۈمزارلىققا ئوتلاشقا قويۇۋېتىپ، باشقىلارنىڭ باغ-ئېتىزلىقىدا ئوتلاشقا يول قويسا، ئۇنداقتا ئۇ ئۆزىنىڭ ئەڭ ئېسىل مەھسۇلاتلىرىدىن ياكى ئۈزۈمزارلىقىنىڭ ئەڭ ئېسىل مېۋىسىدىن زىياننى تۆلەپ بەرسۇن.
002	EXO	022	006	ئەگەر ئوت كېتىپ، تىكەنلىككە تۇتىشىپ كېتىپ، ئاندىن ئۆنچىلەرنى، باش تارتىپ پىشقان زىرائەتنى كۆيدۈرۈپ، پۈتكۈل ئېتىزلىقنى كۈل قىلىۋەتسە، ئۇنداقتا ئوت قويغۇچى بارلىق زىياننى تۆلەپ بەرسۇن.
002	EXO	022	007	ئەگەر بىرسى قوشنىسىغا پۇل ياكى مال-دۇنياسىنى ئامانەت قىلغان بولسا، بۇلار ئۆيىدىن ئوغرىلىنىپ كەتسە، شۇنداقلا ئوغرى كېيىن تۇتۇلسا، ئۇ ئوغرىلىغىنىنى ئىككى ھەسسە قىممەتتە تۆلەپ بەرسۇن.
002	EXO	022	008	لېكىن ئوغرى تېپىلمىسا، ئۆي ئىگىسىنىڭ قوشنىسىنىڭ مېلىغا قول تەگكۈزگەن يا تەگكۈزمىگەنلىكى مەلۇم بولسۇن دەپ، ھاكىملارنىڭ ئالدىغا كەلتۈرۈلسۇن.
002	EXO	022	009	ھەرخىل خىيانەت، ئۇ مەيلى كالا، ئېشەك، قوي، كىيىم-كېچەك بولسۇن، يىتتۈرۈپ قويغان نەرسە بولسۇن، ئۇلار توغرۇلۇق بىر قوشنىسى: «ئەمەلىيەتتە مۇنداق ئىدى» دەپ تالاشقان بولسا، ھەر ئىككىسىنىڭ دەۋاسى ھاكىملارنىڭ ئالدىغا كەلتۈرۈلسۇن؛ ھاكىملار قايسىغا گۇناھ بېكىتسە، شۇ قوشنىسىغا ئىككى ھەسسە قىممەتتە تۆلەپ بەرسۇن.
002	EXO	022	010	ئەگەر بىرسى قوشنىسىغا ئېشەك، كالا، قوي ياكى باشقا بىر چارپاينى ئامانەت قىلسا، بۇ ئامانەت مېلى كىشى كۆرمەي ئۆلۈپ كەتسە، ياكى زەخىملەنسە، ياكى ھەيدەپ ئەكىتىلسە،
002	EXO	022	011	ئۇنداقتا قوشنىسىنىڭ مېلىغا قول تەگكۈزگەن يا تەگكۈزمىگەنلىكى مەلۇم بولسۇن دەپ، پەرۋەردىگارنىڭ ئالدىدا ئۇلارنىڭ ئوتتۇرىسىدا بىر قەسەم ئىچۈرۈلسۇن. مال ئىگىسى بۇ قەسەمنى قوبۇل قىلسۇن؛ قوشنىسى ئۇنىڭغا تۆلەم تۆلەپ بەرمىسۇن.
002	EXO	022	012	لېكىن مال ئوغرىلانغان بولسا، ئۇ ئىگىسىگە تۆلەپ بەرسۇن.
002	EXO	022	013	ئەگەر ئۇنى ۋەھشىي ھايۋان بوغۇپ قويغان بولسا، ئۇ مالنىڭ قالدۇقىنى گۇۋاھلىق ئۈچۈن كۆرسىتىپ، ئۇنى تۆلەپ بەرمىسىمۇ بولىدۇ.
002	EXO	022	014	ئەگەر بىرسى قوشنىسىدىن بىر ئۇلاغنى ئۆتنە ئېلىپ، ئۇلاغ ئىگىسى يوق يەردە زەخىملەنسە ياكى ئۆلۈپ قالسا، ئۆتنە ئالغۇچى تولۇق تۆلەپ بەرسۇن.
002	EXO	022	015	لېكىن ئىگىسى نەق مەيداندا بولسا، ئۆتنە ئالغۇچى تۆلەپ بەرمىسۇن؛ ئۇلاغ ئىجارىگە ئېلىنغان بولسا، ئالغۇچى تۆلەم تۆلىمىسۇن؛ چۈنكى ئۇنى ئىجارە تۆلەپ ئەكەلگەن.
002	EXO	022	016	ئەگەر بىر ئادەم تېخى ياتلىق بولمىغان بىر قىزنى ئازدۇرۇپ، ئۇنىڭ بىلەن بىللە ياتسا، ئۇنداقتا ئۇ ئۇنىڭ تويلۇقىنى بېرىشى كېرەك، ئاندىن ئۇنى خوتۇنلۇققا ئالسۇن.
002	EXO	022	017	لېكىن قىزنىڭ ئاتىسى ئۇنى ئۇنىڭغا بەرگىلى ئۇنىمىسا، زىنا قىلغۇچى پاك قىزلارنىڭ تويلۇقىغا باراۋەر كېلىدىغان كۈمۈش پۇلنى تارازىدا ئۆلچەپ بەرسۇن.
002	EXO	022	018	جادۇگەر خوتۇننى تىرىك قويمىغىن.
002	EXO	022	019	ھايۋان بىلەن جىنسىي مۇناسىۋەت ئۆتكۈزگەن ھەربىرى جەزمەن ئۆلۈمگە مەھكۇم قىلىنسۇن.
002	EXO	022	020	كىمدەكىم بىردىنبىر پەرۋەردىگاردىن باشقا ھەرقانداق ئىلاھغا قۇربانلىق سۇنسا، ھارام دەپ مۇتلەق ھالاكەتكە مەھكۇم قىلىنسۇن.
002	EXO	022	021	سىلەرمۇ مىسىردا مۇساپىر بولۇپ تۇرغانىكەنسىلەر، مۇساپىر بولغان كىشىنى ھېچ خارلىماڭلار ۋە ياكى ئۇنىڭغا ھېچ زۇلۇم قىلماڭلار.
002	EXO	022	022	ھەرقانداق تۇل خوتۇن ياكى يېتىم بالىنى خورلىماڭلار.
002	EXO	022	023	سەن ئۇلارنى ھەرقانداق تەرەپتە خورلىساڭ، ئۇلار ماڭا پەرياد كۆتۈرسە، مەن ئۇلارنىڭ ئاۋازىنى چوقۇم ئاڭلايمەن؛
002	EXO	022	024	شۇنىڭ بىلەن غەزىپىم تۇتىشىپ، سىلەرنى قىلىچلاپ ئۆلتۈرىمەن، سىلەرنىڭ خوتۇنلىرىڭلار تۇل قىلىنىپ، بالىلىرىڭلار يېتىم بولۇپ قالىدۇ.
002	EXO	022	025	ئەگەر سەن مېنىڭ خەلقىمنىڭ ئىچىدىن ساڭا قوشنا بولغان كەمبەغەلگە قەرز بەرگەن بولساڭ، ئۇنىڭغا جازانىخورلاردەك مۇئامىلە قىلمىغىن؛ ئۇنىڭدىن ئۆسۈم ئالماڭلار.
002	EXO	022	026	ئەگەر سەن قوشناڭنىڭ چاپىنىنى گۆرۈگە ئالغان بولساڭ، كۈن ئولتۇرماستا ئۇنىڭغا ياندۇرۇپ بەر.
002	EXO	022	027	چۈنكى چاپىنى ئۇنىڭ بىردىنبىر يېپىنچىسى بولۇپ، بەدىنىنى ياپىدىغان كىيىم شۇدۇر. ئۇ بولمىسا، ئۇ نېمىنى يېپىنىپ ياتىدۇ؟ بۇ سەۋەبتىن ماڭا پەرياد قىلسا، پەريادىنى ئاڭلايمەن؛ چۈنكى مەن شەپقەتلىكتۇرمەن.
002	EXO	022	028	ھاكىملارغا كۇپۇرلۇق قىلما، ۋە خەلقىڭنىڭ ئەمىرلىرىنىمۇ قارغاپ تىللىما.
002	EXO	022	029	خامىنىڭنىڭ ھوسۇلىنىڭ ئاشقىنىدىن ۋە شاراب-زەيتۇن مېيى كۆلچىكىڭدىن تاشقىنىدىن ماڭا ھەدىيە سۇنۇشنى ھايال قىلمىغىن. سەن ئوغۇللىرىڭنىڭ تۇنجىسىنى ماڭا ئاتىغىن.
002	EXO	022	030	كالا بىلەن قويلىرىڭنىڭ تۇنجى بالىلىرىنىمۇ ھەم شۇنداق ئاتىغىن؛ تۇنجى بالا يەتتە كۈنگىچە ئانىسى بىلەن بىللە تۇرسۇن؛ ئەمما سەككىزىنچى كۈنى ئۇنى ماڭا ئاتاپ سۇنغىن.
002	EXO	022	031	سىلەر ماڭا ئاتالغان مۇقەددەس كىشىلەر بولىسىلەر؛ شۇڭا دالادا يىرتقۇچ ھايۋان تەرىپىدىن بوغۇلغان ھايۋاننىڭ گۆشىنى يېمەڭلار، بەلكى ئۇنى ئىتلارغا تاشلاپ بېرىڭلار.
002	EXO	023	001	يالغان گەپنى يايمىغىن ۋە يا يالغان گۇۋاھلىق بېرىپ رەزىل ئادەمگە يان باسمىغىن.
002	EXO	023	002	توپقا ئەگىشىپ رەزىل ئىشتا بولما ياكى دەۋا-دەستۇرلاردا گۇۋاھلىق بەرگەندە توپقا ئەگىشىپ ھەقىقەتنى بۇرمىلىما.
002	EXO	023	003	كەمبەغەل دەۋا قىلسا، ئۇنىڭغا يان باسما.
002	EXO	023	004	دۈشمىنىڭنىڭ كالا يا ئېشىكى ئېزىپ كېتىپ، ساڭا ئۇچراپ قالسا، ئۇنى ئېلىپ كېلىپ، ئىگىسىگە چوقۇم تاپشۇرۇپ بەر.
002	EXO	023	005	ئەگەر ساڭا ئۆچ بولغاننىڭ ئېشىكى يۈكنى كۆتۈرەلمەي يۈكنىڭ ئاستىدا ياتقىنىنى كۆرسەڭ، ئۇنى ياردەمسىز تاشلىماي، بەلكى ئۇنىڭغا ياردەملىشىپ ئېشىكىنى قوپۇرۇشۇپ بېرىشىڭ زۆرۈر.
002	EXO	023	006	ئاراڭدىكى كەمبەغەلنىڭ دەۋاسىدا ئادالەتنى بۇرمىلىما.
002	EXO	023	007	ھەرقانداق ساختا ئىشتىن ئۆزۈڭنى نېرى تارت؛ بىگۇناھ ئادەم بىلەن ھەققانىي ئادەمنى ئۆلتۈرمىگىن؛ چۈنكى مەن رەزىل ئادەمنى ھەرگىز ئادىل دەپ ئاقلىمايمەن.
002	EXO	023	008	شۇنىڭدەك ھېچقانداق پارا يېمە؛ چۈنكى پارا كۆزى ئوچۇقلارنى كور قىلىپ، ھەققانىيلارنىڭ سۆزلىرىنى بۇرمىلايدۇ.
002	EXO	023	009	مۇساپىر كىشىلەرگە زۇلۇم قىلما؛ چۈنكى ئۆزۈڭلار مىسىر زېمىنىدا مۇساپىر بولۇپ تۇرغان بولغاچقا، مۇساپىرنىڭ روھىي ھالىنى بىلىسىلەر.
002	EXO	023	010	ئالتە يىل ئۆز يېرىڭنى تېرىپ، ھوسۇللىرىنى ئال.
002	EXO	023	011	لېكىن يەتتىنچى يىلى يەرگە ئارام بېرىپ ئۇنى بوش قوي؛ خەلقىڭنىڭ نامراتلىرى ئۇنىڭدىن يىغىپ يېسۇن، ئۇلاردىن ئاشقىنىنى جاڭگالدىكى ھايۋانلار يېسۇن؛ شۇنداقلا ئۈزۈمزارلىقىڭ بىلەن زەيتۇنزارلىقىڭنىمۇ شۇنداق قىلغىن.
002	EXO	023	012	ئالتە كۈن ئىچىدە ئۆز ئىشىڭنى ئادا قىلىپ، يەتتىنچى كۈنى ئارام ئېلىشىڭ زۆرۈر. بۇنىڭ بىلەن كالا-ئېشەكلىرىڭ ئارام تاپىدۇ، دېدىكىڭنىڭ ئوغلى بىلەن مۇساپىر كىشىمۇ ھاردۇقىنى چىقىرىدۇ.
002	EXO	023	013	مەن ساڭا ئېيتقىنىمنىڭ ھەممىسىنى كۆڭۈل بۆلۈپ ئادا قىل؛ باشقا ئىلاھلارنىڭ نامىنى تىلىڭغا ئالما؛ بۇلار ھەتتا ئاغزىڭغىمۇ چىقمىسۇن.
002	EXO	023	014	ھەر يىلدا ئۈچ قېتىم مېنىڭ ئۈچۈن ھېيت ئۆتكۈزگىن.
002	EXO	023	015	ئالدى بىلەن «پېتىر نان ھېيتى»نى ئۆتكۈز؛ ساڭا ئەمر قىلغىنىمدەك ئابىب ئېيىدىكى بېكىتىلگەن كۈنلەردە يەتتە كۈن پېتىر نان يېگىن؛ چۈنكى شۇ ئايدا سەن مىسىردىن چىققانىدىڭ. شۇ ھېيتتا ھېچكىشى ئالدىمغا قۇرۇق قول كەلمىسۇن.
002	EXO	023	016	سەن ئەجىر قىلىپ تېرىغان ئېتىزدىكى زىرائىتىڭنىڭ تۇنجى ھوسۇلىنى ئورغاندا «ئورما ھېيتى»نى ئۆتكۈز؛ شۇنداقلا سەن ئەجىر سىڭدۈرۈپ يەردىن ئاخىرقى ھوسۇل-مەھسۇلاتلىرىڭنى يىل ئاخىرىدا يىغقاندا «ھوسۇل يىغىش ھېيتى»نى ئۆتكۈز.
002	EXO	023	017	يىلدا ئۈچ قېتىم ئەركەكلىرىڭنىڭ ھەممىسى رەب پەرۋەردىگارنىڭ ھۇزۇرىغا ھازىر بولسۇن.
002	EXO	023	018	سەن ماڭا ئاتالغان قۇربانلىقنىڭ قېنىنى خېمىرتۇرۇچ سېلىنغان نان بىلەن سۇنمىغىن؛ ھېيت قۇربانلىقىنىڭ يېغىنى بولسا كېچىچە قوندۇرۇپ ئەتىگىچىگە ساقلىما.
002	EXO	023	019	زېمىنىڭدىكى دەسلەپكى ھوسۇلنىڭ ئەڭ ياخشسىنى پەرۋەردىگار خۇدايىڭنىڭ ئۆيىگە ئېلىپ كەل. ئوغلاقنى ئانىسىنىڭ سۈتىدە قاينىتىپ پىشۇرما.
002	EXO	023	020	مانا، مەن بىر پەرىشتىنى يولدا سېنى قوغداپ، مەن ساڭا تەييارلىغان يەرگە ئېلىپ بارسۇن دەپ، ئالدىڭدا يۈرۈشكە ئەۋەتىمەن.
002	EXO	023	021	سەن ئۇنىڭ ئالدىدا ئۆزۈڭگە ئاگاھ بول، ئۇنىڭ ئاۋازىغا قۇلاق سال. ئۇنىڭ زىتىغا تەگمە؛ بولمىسا، ئۇ ئىتائەتسىزلىكلىرىڭنى كەچۈرمەيدۇ؛ چۈنكى مېنىڭ نامىم ئۇنىڭدىدۇر.
002	EXO	023	022	لېكىن ئەگەر سەن ئۇنىڭ ئاۋازىغا قۇلاق سېلىپ، مېنىڭ بارلىق بۇيرۇغانلىرىمغا ئەمەل قىلساڭ، مەن دۈشمەنلىرىڭگە دۈشمەن، كۈشەندىلىرىڭگە كۈشەندە بولىمەن.
002	EXO	023	023	چۈنكى مېنىڭ پەرىشتەم ئالدىڭدا يۈرۈپ، سېنى ئامورىي، ھىتتىي، پەرىززىي، قانائانىي، ھىۋىي ۋە يەبۇسىيلارنىڭ زېمىنىغا باشلاپ كىرىدۇ؛ مەن ئۇلارنى يوقىتىمەن.
002	EXO	023	024	سەن ئۇلارنىڭ ئىلاھلىرىغا باش ئۇرۇپ ئىبادەت قىلما ۋە ياكى ئۇلار قىلغاندەك قىلما؛ بەلكى ئۇلارنىڭ [بۇتلىرىنى] ئۈزۈل-كېسىل چېقىۋەت، بۇت تۈۋرۈكلىرىنى ئۈزۈل-كېسىل كۇكۇم-تالغان قىلىۋەت؛
002	EXO	023	025	لېكىن خۇدايىڭلار پەرۋەردىگارنىڭ ئىبادىتىدە بولۇڭلار. شۇنداق قىلساڭلار ئۇ نان بىلەن سۈيۈڭلارنى بەرىكەتلەيدۇ؛ مەن بارلىق كېسەللىكنى ئاراڭلاردىن چىقىرىپ تاشلايمەن.
002	EXO	023	026	بۇنىڭ بىلەن زېمىنىڭدا بويىدىن ئاجراپ كېتىدىغان ياكى تۇغماس ھېچبىر ئايال ياكى چارپاي بولمايدۇ؛ ئۆمرۈڭنىڭ كۈنلىرىنى تولۇق قىلىمەن.
002	EXO	023	027	مەن سېنىڭ ئالدىڭدا ۋەھىمىمنى ئەۋەتىمەن، قايسى تائىپىگە يېقىنلاشساڭ شۇلارنى پاراكەندە قىلىمەن؛ شۇنىڭ بىلەن ھەممە دۈشمەنلىرىڭنى كەينىگە ياندۇرۇپ قاچۇرىمەن.
002	EXO	023	028	ھىۋىيلار، قانائانىيلار ۋە ھىتتىيلارنى ئالدىڭدىن قوغلاپ چىقىرىۋېتىشكە سېرىق ھەرىلەرنى ئالدىڭدا يۈرۈشكە ئەۋەتىمەن.
002	EXO	023	029	ئەمما زېمىننىڭ خارابىلىشىپ، دالادا ۋەھشىي ھايۋانلار ئاۋۇپ ساڭا خەۋپ بولۇپ قالماسلىقى ئۈچۈن، شۇ ئەللەرنى ئالدىڭدىن بىر يىلغىچە ھەيدىۋەتمەيمەن،
002	EXO	023	030	بەلكى سەن ئاۋۇپ، زېمىننى [پۈتۈنلەي] مىراس قىلىپ بولغۇچە، ئاز-ئازدىن ھەيدەپ تۇرىمەن.
002	EXO	023	031	سېنىڭ زېمىنىڭنىڭ چېگرىلىرىنى قىزىل دېڭىزدىن تارتىپ فىلىستىيلەرنىڭ دېڭىزىغىچە، شۇنىڭدەك چۆلدىن تارتىپ [ئەفرات] دەرياسىغىچە بېكىتىمەن؛ چۈنكى زېمىندا تۇرۇۋاتقانلارنى ھەيدىۋېتىپ يېرىنى ئىگىلىشىڭ ئۈچۈن، ئۇلارنى قولۇڭغا تاپشۇرىمەن.
002	EXO	023	032	سەن ئۇلار بىلەن ۋە ياكى ئىلاھلىرى بىلەن ھېچقانداق بىر ئەھدە تۈزمە.
002	EXO	023	033	ئۇلارنىڭ سېنى ئالدىمدا گۇناھقا پاتقۇزماسلىقى ئۈچۈن ئۇلارنى زېمىنىڭدا قەتئىي تۇرغۇزما. چۈنكى مۇبادا سەن ئۇلارنىڭ ئىلاھلىرىنىڭ ئىبادىتىدە بولساڭ، بۇ ئىش ساڭا تۇزاق بولىدۇ.
002	EXO	024	001	ئۇ مۇساغا يەنە: ــ «سەن بېرىپ، ئۆزۈڭ بىلەن بىللە ھارۇن، ناداب، ئابىھۇنى ۋە ئىسرائىللارنىڭ ئاقساقاللىرى ئارىسىدىن يەتمىش ئادەمنى ئېلىپ، پەرۋەردىگارنىڭ ھۇزۇرىغا چىقىپ، يىراقتا تۇرۇپ سەجدە قىلىڭلار.
002	EXO	024	002	پەقەت مۇسالا پەرۋەردىگارنىڭ ئالدىغا يېقىن كەلسۇن؛ باشقىلار يېقىن كەلمىسۇن، خەلق ئۇنىڭ بىلەن بىللە ئۈستىگە چىقمىسۇن، ــ دېدى.
002	EXO	024	003	مۇسا كېلىپ پەرۋەردىگارنىڭ بارلىق سۆزلىرى بىلەن ھۆكۈملىرىنى خالايىققا دەپ بەردى؛ پۈتكۈل خالايىق بىر ئاۋازدا: ــ پەرۋەردىگارنىڭ ئېيتقان سۆزلىرىنىڭ ھەممىسىگە ئەمەل قىلىمىز! ــ دەپ جاۋاب بېرىشتى.
002	EXO	024	004	ئاندىن مۇسا پەرۋەردىگارنىڭ ھەممە سۆزىنى خاتىرىلىۋېلىپ، ئەتىسى سەھەر قوپۇپ تاغنىڭ تۈۋىدە بىر قۇربانگاھنى ياساپ، شۇ يەردە ئىسرائىلنىڭ ئون ئىككى قەبىلىسىنىڭ سانى بويىچە ئون ئىككى تاش تۈۋرۈكنى تىكلىدى.
002	EXO	024	005	يەنە ئىسرائىللارنىڭ بىرنەچچە يىگىتلىرىنى ئەۋەتتى، ئۇلار بېرىپ پەرۋەردىگارغا كۆيدۈرمە قۇربانلىقلار سۇندى، ئىناقلىق قۇربانلىقى سۈپىتىدە بىرنەچچە تورپاقنىمۇ سويۇپ سۇندى.
002	EXO	024	006	ئاندىن مۇسا قاننىڭ يېرىمىنى قاچىلارغا قاچىلىدى، يەنە يېرىمىنى قۇربانگاھ ئۈستىگە چاچتى.
002	EXO	024	007	ئاندىن ئۇ ئەھدىنامىنى قولىغا ئېلىپ، خەلققە ئوقۇپ بەردى. ئۇلار جاۋابەن: ــ پەرۋەردىگارنىڭ ئېيتقىنىنىڭ ھەممىسىگە قۇلاق سېلىپ، ئىتائەت قىلىمىز! ــ دېيىشتى.
002	EXO	024	008	شۇنىڭ بىلەن مۇسا قاچىلاردىكى قاننى ئېلىپ، خەلققە سېپىپ: ــ مانا، بۇ پەرۋەردىگار مۇشۇ سۆزلەرنىڭ ھەممىسىگە ئاساسەن سىلەر بىلەن باغلىغان ئەھدىنىڭ قېنىدۇر، دېدى.
002	EXO	024	009	ئاندىن كېيىن مۇسا ۋە ھارۇن، ناداب ۋە ئابىھۇ ئىسرائىللارنىڭ ئاقساقاللىرىدىن يەتمىش ئادەم بىلەن بىللە تاغ ئۈستىگە چىقىشتى.
002	EXO	024	010	ئۇلار شۇ يەردە ئىسرائىلنىڭ خۇداسىنى كۆردى؛ ئۇنىڭ ئايىغىنىڭ ئاستىدا خۇددى كۆك ياقۇتتىن ياسالغان نەپىس پاياندازدەك، ئاسمان گۈمبىزىدەك سۈپسۈزۈك بىر جىسىم بار ئىدى.
002	EXO	024	011	لېكىن ئۇ ئىسرائىللارنىڭ مۆتىۋەرلىرىگە قول تەگكۈزمىدى؛ ئۇلار خۇدانى كۆرۈپ تۇردى ھەمدە يەپ-ئىچىشتى.
002	EXO	024	012	پەرۋەردىگار مۇساغا: ــ تاغ ئۈستىگە، قېشىمغا چىقىپ شۇ يەردە تۇرغىن. ساڭا ئۇلارغا ئۆگىتىشكە تاش تاختايلارنى، يەنى مەن يېزىپ قويغان قانۇن-ئەمرنى بېرىمەن، دېدى.
002	EXO	024	013	شۇنىڭ بىلەن مۇسا قوپۇپ، ياردەمچىسى يەشۇئانى ئېلىپ ماڭدى. مۇسا خۇدانىڭ تېغىغا چىقتى.
002	EXO	024	014	ئۇ ئاۋۋال ئاقساقاللارغا: بىز يېنىپ كەلگۈچە مۇشۇ يەردە بىزنى ساقلاپ تۇرۇڭلار. مانا، ھارۇن بىلەن خۇر سىلەرنىڭ يېنىڭلاردا قالىدۇ؛ ئەگەر بىرسىنىڭ ئىش-دەۋاسى چىقسا، ئۇلارنىڭ ئالدىغا بارسۇن، ــ دېدى.
002	EXO	024	015	شۇنىڭ بىلەن مۇسا تاغنىڭ ئۈستىگە چىقتى ۋە تاغنى بۇلۇت قاپلىدى.
002	EXO	024	016	پەرۋەردىگارنىڭ جۇلاسى سىناي تېغىنىڭ ئۈستىدە توختىدى؛ بۇلۇت ئۇنى ئالتە كۈنگىچە قاپلاپ تۇردى؛ يەتتىنچى كۈنى، پەرۋەردىگار بۇلۇت ئىچىدىن مۇسانى چاقىردى؛
002	EXO	024	017	پەرۋەردىگارنىڭ جۇلاسىنىڭ قىياپىتى ئىسرائىللارنىڭ كۆز ئالدىدا تاغنىڭ چوققىسىدا ھەممىنى يۇتقۇچى ئوتتەك كۆرۈندى.
002	EXO	024	018	مۇسا بۇلۇتنىڭ ئىچىگە كىرىپ، تاغنىڭ ئۈستىگە چىقىپ كەتتى. مۇسا قىرىق كېچە-كۈندۈز تاغدا تۇردى.
002	EXO	025	001	پەرۋەردىگار مۇساغا مۇنداق دېدى: ــ
002	EXO	025	002	سەن ئىسرائىللارغا ئېيتقىن، ئۇلار ماڭا بىر «كۆتۈرمە ھەدىيە»نى كەلتۈرسۇن؛ كىمنىڭ كۆڭلى ھەدىيە سۇنۇشقا خۇش بولسا، ئۇنىڭدىن ماڭا سۇنۇلىدىغان «كۆتۈرمە ھەدىيە»نى تاپشۇرۇۋېلىڭلار.
002	EXO	025	003	سىلەر ئۇلاردىن تاپشۇرۇۋالىدىغان كۆتۈرمە ھەدىيە: ــ ئالتۇن، كۈمۈش، مىس،
002	EXO	025	004	كۆك، سۆسۈن ۋە قىزىل رەڭلىك يىپ، كاناپ رەخت، تىۋىت،
002	EXO	025	005	قىزىل بويالغان قوچقارنىڭ تېرىلىرى، دېلفىننىڭ تېرىلىرى، ئاكاتسىيە ياغىچى،
002	EXO	025	006	چىراغ ئۈچۈن زەيتۇن مېيى، «مەسىھلەش مېيى» ۋە خۇشبۇي ئۈچۈن خۇشبۇي دورا-دەرمەكلەر،
002	EXO	025	007	ئەفود بىلەن «قوشېن»غا ئورنىتىلىدىغان ئاق ھېقىق ۋە باشقا ئېسىل تاشلار بولسۇن.
002	EXO	025	008	مېنىڭ ئۆزلىرى ئارىسىدا ماكان قىلىشىم ئۈچۈن [شۇلاردىن] ماڭا بىر مۇقەددەس تۇرالغۇنى ياسىسۇن.
002	EXO	025	009	ئۇنى مەن ساڭا بارلىق كۆرسەتمەكچى بولغىنىمغا ئاساسەن، يەنى ئىبادەت چېدىرىنىڭ نۇسخىسى ۋە بارلىق ئەسۋاب-سايمانلىرىنىڭ نۇسخىسىغا ئوپئوخشاش قىلىپ ياساڭلار.
002	EXO	025	010	ئۇلار ئاكاتسىيە ياغىچىدىن بىر ساندۇق ياسىسۇن. ئۇنىڭ ئۇزۇنلۇقى ئىككى يېرىم گەز، كەڭلىكى بىر يېرىم گەز، ئېگىزلىكى بىر يېرىم گەز بولسۇن.
002	EXO	025	011	سەن ئۇنى ساپ ئالتۇن بىلەن قاپلىغىن؛ ئىچى ۋە سىرتىنى ئالتۇن بىلەن قاپلاپ، ئۇنىڭ ئۈستۈنكى قىسمىنىڭ چۆرىسىگە ئالتۇندىن گىرۋەك چىقار.
002	EXO	025	012	ئۇنىڭغا ئالتۇندىن تۆت ھالقا قۇيدۇرۇپ، تۆت چېتىقىغا بېكىتكىن. بىر تەرىپىگە ئىككى ھالقا، يەنە بىر تەرىپىگە ئىككى ھالقا بولسۇن.
002	EXO	025	013	سەن ھەم ئاكاتسىيە ياغىچىدىن ئىككى بالداق ياساپ، ھەر ئىككىسىنى ئالتۇن بىلەن قاپلىغىن؛
002	EXO	025	014	ئاندىن ساندۇق ئۇلار ئارقىلىق كۆتۈرۈلسۇن دەپ، بالداقلارنى ساندۇقنىڭ ئىككى يېنىدىكى ھالقىلىرىدىن ئۆتكۈزۈپ قويغىن.
002	EXO	025	015	بالداقلار ھەمىشە ساندۇقتىكى ھالقىدا تۇرسۇن؛ ئۇلار ئۇنىڭدىن چىقىرىلمىسۇن.
002	EXO	025	016	مەن ساڭا بېرىدىغان ھۆكۈم-گۇۋاھلىقنى ساندۇققا قويغىن.
002	EXO	025	017	ساندۇقنىڭ [ياپقۇچى سۈپىتىدە] سەن ئالتۇندىن ئۇزۇنلۇقى ئىككى يېرىم گەز، كەڭلىكى بىر يېرىم گەز بولغان بىر «كەفارەت تەختى» ياسىغىن.
002	EXO	025	018	ئىككى كېرۇبنى ئالتۇندىن سوقۇپ ياسىغىن. ئۇلارنى كەفارەت تەختىنىڭ ئىككى تەرىپىگە ئورناتقىن.
002	EXO	025	019	بىر كېرۇبنى بىر تەرىپىگە، يەنە بىر كېرۇبنى يەنە بىر تەرىپىگە ئورنىتىش ئۈچۈن ياسىغىن. ئىككى تەرىپىدىكى كېرۇبلارنى كافارەت تەختى بىلەن بىر گەۋدە قىلىڭلار.
002	EXO	025	020	كېرۇبلار بىر-بىرىگە يۈزلەنسۇن، قاناتلىرىنى كەفارەت تەختىنىڭ ئۈستىگە كېرىپ، قاناتلىرى بىلەن ئۇنى ياپسۇن؛ كېرۇبلارنىڭ يۈزى كەفارەت تەختىگە قارىتىلسۇن.
002	EXO	025	021	سەن كەفارەت تەختىنى ساندۇقنىڭ ئۈستىگە قويۇپ، مەن ساڭا بېرىدىغان ھۆكۈم-گۇۋاھلىقنى ساندۇقنىڭ ئىچىگە قويغىن.
002	EXO	025	022	مەن شۇ يەردە سەن بىلەن كۆرۈشىمەن؛ كەفارەت تەختى ئۈستىدە، يەنى ھۆكۈم-گۇۋاھلىق ساندۇقىنىڭ ئۈستىدىكى ئىككى كېرۇبنىڭ ئوتتۇرىسىدا تۇرۇپ ساڭا ئىسرائىللارغا يەتكۈزۈشكە تاپشۇرىدىغان بارلىق ئەمرلىرىم توغرىسىدا سۆز قىلىمەن.
002	EXO	025	023	ھەم ئاكاتسىيە ياغىچىدىن ئۇزۇنلۇقى ئىككى گەز، كەڭلىكى بىر گەز، ئېگىزلىكى بىر يېرىم گەز بولغان بىر شىرە ياسىغىن.
002	EXO	025	024	ئۇنى ساپ ئالتۇن بىلەن قاپلاپ، ئۇنىڭ ئۈستۈنكى قىسمىنىڭ چۆرىسىگە ئالتۇندىن گىرۋەك چىقار.
002	EXO	025	025	سەن شىرەنىڭ چۆرىسىگە تۆت ئىلىك ئېگىزلىكتە بىر لەۋ ياسىغىن؛ بۇ لەۋنىڭ چۆرىسىگىمۇ ئالتۇندىن بىر گىرۋەك چىقار.
002	EXO	025	026	سەن ئۇ شىرەگە ئالتۇندىن تۆت ھالقا ياساپ، بۇ ھالقىلارنى شىرەنىڭ تۆت بۇرجىكىدىكى چېتىققا ئورناتقىن.
002	EXO	025	027	شىرەنى كۆتۈرۈشكە بالداقلار ئۆتكۈزۈلسۇن دەپ، ھالقىلار شىرە لېۋىگە يېقىن بېكىتىلسۇن.
002	EXO	025	028	بالداقلارنى ئاكاتسىيە ياغىچىدىن ياساپ، ئالتۇن بىلەن قاپلىغىن؛ شىرە ئۇلار ئارقىلىق كۆتۈرىلىدۇ.
002	EXO	025	029	شىرەگە يانداپ لېگەن، قاچا-تەخسە، پىيالە ۋە شاراب ھەدىيەلىرىنى چاچىدىغان قەدەھلەرنى ياسىغىن؛ ئۇلارنى ساپ ئالتۇندىن ياسىغىن.
002	EXO	025	030	مېنىڭ ھۇزۇرۇمدا تۇرۇشقا سەن شىرەگە ھەمىشە «تەقدىم نان»نى قويغىن.
002	EXO	025	031	سەن ھەم ساپ ئالتۇندىن بىر چىراغدان ياسىغىن. ئۇ چىراغدان سوقۇپ ياسالسۇن؛ چىراغداننىڭ پۇتى، غولى، قەدەھلىرى، غۇنچە ۋە چېچەكلىرى پۈتۈن بىر ئالتۇندىن سوقۇلسۇن.
002	EXO	025	032	چىراغداننىڭ غولىنىڭ ئىككى يېنىدىن ئالتە شاخچە چىقىرىلسۇن ــ چىراغداننىڭ بىر يېنىدىن ئۈچ شاخچە، چىراغداننىڭ يەنە بىر يېنىدىن ئۈچ شاخچە چىقىرىلسۇن؛
002	EXO	025	033	بىر يېنىدىكى ھەربىر شاخچىدە بادام گۈلى شەكلىدە غۇنچىسى ۋە چېچىكى بولغان ئۈچ قەدەھ چىقىرىلسۇن، يەنە بىر يېنىدىكى ھەربىر شاخچىدە بادام گۈلى شەكلىدە غۇنچىسى ۋە چېچىكى بولغان ئۈچ قەدەھ چىقىرىلسۇن. چىراغدانغا چىقىرىلغان ئالتە شاخچىنىڭ ھەممىسى شۇنداق ياسالسۇن.
002	EXO	025	034	چىراغداننىڭ [غولىدىن] بادام گۈلى شەكلىدە غۇنچىسى ۋە چېچىكى بولغان تۆت قەدەھ چىقىرىلسۇن.
002	EXO	025	035	بۇلاردىن باشقا [بىرىنچى] ئىككى شاخچىنىڭ ئاستىدا بىر غۇنچە، [ئىككىنچى] ئىككى شاخچىنىڭ ئاستىدا بىر غۇنچە، [ئۈچىنچى] ئىككى شاخچىنىڭ ئاستىدا بىر غۇنچە بولسۇن؛ چىراغدانغا چىقىرىلغان ئالتە شاخچىنىڭ ئاستى ھەممىسى شۇنداق بولسۇن.
002	EXO	025	036	ئۇنىڭ شۇ غۇنچىلىرى ھەم شاخچىلىرى چىراغدان بىلەن بىر گەۋدە قىلىنسۇن ــ بىر پۈتۈن ساپ ئالتۇندىن سوقۇپ ياسالسۇن.
002	EXO	025	037	سەن چىراغداننىڭ يەتتە چىرىغىنى ياسىغىن؛ چىراغلار ئۇدۇلغا يورۇق چۈشۈرەلىشى ئۈچۈن ئۈستى تەرەپكە ئورنىتىلسۇن.
002	EXO	025	038	ئۇنىڭ پىلىك قايچىلىرى بىلەن كۈلدانلىرى ساپ ئالتۇندىن ياسالسۇن.
002	EXO	025	039	چىراغدان ۋە ئۇنىڭ بارلىق ئەسۋابلىرى بىر تالانت ساپ ئالتۇندىن ياسالسۇن.
002	EXO	025	040	ساڭا تاغدا ئايان قىلىنغان نۇسخا بويىچە بۇلارنى ئېھتىيات بىلەن ياسىغىن.
002	EXO	026	001	مۇقەددەس چېدىرنى ئون پارچە يوپۇقتىن ياساتقىن؛ يوپۇقلار نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ ئىشلەنسۇن؛ ئۇنىڭغا كېرۇبلارنىڭ سۈرىتىنى چېۋەر قوللارغا نەپىس قىلىپ كەشتىلەپ چىقارغۇزغىن.
002	EXO	026	002	ھەربىر يوپۇقنىڭ ئۇزۇنلۇقى يىگىرمە سەككىز گەز، كەڭلىكى تۆت گەز بولۇپ، ھەربىر يوپۇق ئوخشاش چوڭ-كىچىكلىكتە بولسۇن.
002	EXO	026	003	يوپۇقلارنىڭ بەشى بىر-بىرىگە ئۇلانسۇن، قالغان بەش يوپۇقمۇ ھەم بىر-بىرىگە ئۇلانسۇن.
002	EXO	026	004	سەن ئۇلاپ چىقىلغان بىرىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا بىر تەرىپىگە رەڭگى كۆك ئىزمە قادىغىن، شۇنىڭدەك ئۇلاپ چىقىلغان ئىككىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكىسىنىڭ بىر تەرىپىگىمۇ ھەم شۇنداق قىلغىن.
002	EXO	026	005	بىرىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا ئەللىك ئىزمە قادىغىن، ئىككىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكىسىگىمۇ ئەللىك ئىزمە قادىغىن. ئىزمىلەر بىر-بىرىگە ئۇدۇلمۇئۇدۇل بولسۇن.
002	EXO	026	006	مۇقەددەس چېدىر بىر پۈتۈن بولسۇن ئۈچۈن ئالتۇندىن ئەللىك ئىلغۇ ياساپ، ئىككى چوڭ پارچە يوپۇقنى شۇ ئىلغۇلار بىلەن بىر-بىرىگە تۇتاشتۇرغىن.
002	EXO	026	007	مۇقەددەس چېدىرنى يېپىش ئۈچۈن ئۆچكە تىۋىتىدىن يوپۇقلارنى ياسىغىن؛ يوپۇقتىن ئون بىر پارچە ياسىغىن.
002	EXO	026	008	يوپۇقلارنىڭ ھەربىرىنىڭ ئۇزۇنلۇقى ئوتتۇز گەز، كەڭلىكى تۆت گەز بولۇپ، ئون بىر يوپۇقنىڭ ھەممىسى ئوخشاش چوڭ-كىچىكلىكتە بولسۇن.
002	EXO	026	009	يوپۇقلارنىڭ بەشىنى ئۇلاپ بىر قىلىپ، قالغان ئالتە يوپۇقنىمۇ ئۇلاپ بىر قىلىپ، ئالتىنچى يوپۇقنى ئىككى قات قىلىپ، چېدىرنىڭ ئالدى تەرىپىگە ساڭگىلىتىپ قويغىن.
002	EXO	026	010	سەن بىرىنچى ئۇلاپ چىقىلغان چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا ئەللىك ئىزمە، ئىككىنچى ئۇلاپ چىقىلغان چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا ئەللىك ئىزمە قادىغىن.
002	EXO	026	011	سەن ھەم مىستىن ئەللىك ئىلغۇ ياساپ، چېدىر بىر پۈتۈن بولسۇن ئۈچۈن ئۇلارنى ئىزمىلەرگە ئۆتكۈزۈپ ئىككى چوڭ پارچىنى ئۇلاپ قويغىن.
002	EXO	026	012	لېكىن يوپۇقنىڭ چېدىرنىڭ كەينىدىن ئېشىپ قالغان قىسمى، يەنى ئېشىپ قالغان يېرىم پارچىسى چېدىرنىڭ كەينى تەرىپىدە ساڭگىلاپ تۇرسۇن.
002	EXO	026	013	چېدىر يوپۇقلىرىنىڭ چېدىرنىڭ بويىدىن ئارتۇق قىسمى، يەنى ئۇ تەرىپىدىن بىر گەز، بۇ تەرىپىدىن بىر گەز، چېدىرنىڭ ئىككى تەرىپىدىن ساڭگىلاپ، ئۇنى [تولۇق] ياپسۇن.
002	EXO	026	014	بۇنىڭدىن باشقا، چېدىرغا قىزىل بويالغان قوچقار تېرىسىدىن يوپۇق ياساپ ياپقىن، ئاندىن ئۇنىڭ ئۈستىدىنمۇ دېلفىن تېرىسىدىن ياسالغان يەنە بىر يوپۇقنى قاپلىغىن.
002	EXO	026	015	مۇقەددەس چېدىرنىڭ تىك تاختايلىرىنى ئاكاتسىيە ياغىچىدىن ياساپ تىكلىگىن.
002	EXO	026	016	ھەربىر تاختاينىڭ ئۇزۇنلۇقى ئون گەز، كەڭلىكى بىر يېرىم گەز بولسۇن.
002	EXO	026	017	ھەربىر تاختاينىڭ ئىككىدىن تۇرۇمى بولسۇن، ھەر ئىككى تاختاي شۇلار بىلەن بىر-بىرىگە چېتىلسۇن؛ چېدىرنىڭ بارلىق تاختايلىرىنى شۇنداق ياسىغىن.
002	EXO	026	018	چېدىرنىڭ تاختايلىرىنى شۇنداق ياسىغىن؛ يىگىرمىسىنى جەنۇب تەرەپكە تىكلىگىن؛
002	EXO	026	019	بۇ يىگىرمە تاختاينىڭ تېگىگە كۈمۈشتىن قىرىق تەگلىك ياسىغىن؛ بىر تاختاينىڭ [ئاستىدىكى] ئىككى تۇرۇمى ئۈچۈن ئىككىدىن تەگلىك، يەنە بىر تاختاينىڭ ئىككى تۇرۇمى ئۈچۈن ئىككىدىن تەگلىك ياسىغىن.
002	EXO	026	020	شۇنىڭدەك چېدىرنىڭ ئۇدۇل تەرىپىدە، يەنى شىمال تەرىپىدە يىگىرمە تاختاي بولسۇن؛
002	EXO	026	021	بۇلارنىڭ قىرىق تەگلىكى كۈمۈشتىن بولسۇن؛ بىر تاختاينىڭ تېگىگە ئىككىدىن تەگلىك، يەنە بىر تاختاينىڭ تېگىگە ئىككىدىن تەگلىك ئورۇنلاشتۇرۇلسۇن.
002	EXO	026	022	چېدىرنىڭ كەينى تەرىپىگە، يەنى غەرب تەرەپكە ئالتە تاختاي ياساپ تىكلىگىن.
002	EXO	026	023	چېدىرنىڭ كەينى تەرىپىدىكى ئىككى بۇلۇڭغا ئىككى تاختاي ياساپ ئورناتقىن.
002	EXO	026	024	بۇ [بۇلۇڭ تاختايلىرى] ئاستىدىن ئۈستىگىچە ئىككى قات قىلىنىپ [تاختايلارنى] ئۆزئارا چېتىشتۇرسۇن، ئۈستى بىر ھالقىغا بېكىتىلسۇن. ھەر ئىككىسى شۇنداق قىلىنىپ، ئىككى بۇلۇڭغا تىكلەنسۇن.
002	EXO	026	025	ئارقا تەرەپتە سەككىز تاختاي بولىدۇ، ئۇلارنىڭ كۈمۈشتىن ياسالغان ئون ئالتە تەگلىكى بولىدۇ؛ بىر تاختاينىڭ تېگىدە ئىككى تەگلىك، يەنە بىر تاختاينىڭ تېگىدە ئىككى تەگلىك بولىدۇ.
002	EXO	026	026	بۇنىڭدىن باشقا سەن ئاكاتسىيە ياغىچىدىن بالداق ياسىغىن؛ چېدىرنىڭ بۇ تەرىپىدىكى تاختايلارغا بەش بالداقنى،
002	EXO	026	027	چېدىرنىڭ ئۇ تەرىپىدىكى تاختايلارغا بەش بالداقنى، چېدىرنىڭ ئارقا تەرىپىدىكى تاختايلارغا، يەنى غەرب تەرىپىدىكى تاختايلارغا بەش بالداقنى ياسىغىن.
002	EXO	026	028	تاختايلارنىڭ ئوتتۇرىسىدىكى ئوتتۇرا بالداق بۇ تەرەپتىن ئۇ تەرەپكە يېتىدىغان بولسۇن.
002	EXO	026	029	تاختايلارنى ئالتۇن بىلەن قاپلاپ، بالداقلار ئۆتكۈزۈلىدىغان ھالقىلارنى ئالتۇندىن ياساپ، بالداقلارنى ئالتۇن بىلەن قاپلىغىن.
002	EXO	026	030	چېدىرنى ساڭا تاغدا ئايان قىلىنغان نۇسخا بويىچە ياساپ تىكلىگىن.
002	EXO	026	031	سەن نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ ئىشلەنگەن بىر پەردە ياسىغىن؛ ئۇنى چېۋەر قوللار كېرۇبلارنىڭ سۈرىتىنى نەپىس قىلىپ چۈشۈرۈپ كەشتىلەپ چىقسۇن.
002	EXO	026	032	ئۇنى ئاكاتسىيە ياغىچىدىن ياسالغان تۆت خادىغا ئېسىپ قويغىن. بۇ خادىلار ئالتۇن بىلەن قاپلانسۇن، ھەربىرىنىڭ ئالتۇن ئىلمىكى بولسۇن؛ خادىلار كۈمۈشتىن ياسالغان تۆت تەگلىككە ئورنىتىلسۇن.
002	EXO	026	033	پەردە چېدىر يوپۇقىدىكى ئىلمەكلەرگە ئېسىلىپ ساڭگىلىتىپ قويۇلسۇن؛ ئاندىن ھۆكۈم-گۇۋاھلىق ساندۇقىنى شۇ يەرگە كەلتۈرۈپ، پەردىنىڭ ئىچىگە ئېلىپ كىرگىن. شۇنىڭ بىلەن پەردە سىلەر ئۈچۈن مۇقەددەس جاي بىلەن ئەڭ مۇقەددەس جاينىڭ ئوتتۇرىسىدىكى بىر ئايرىما پەردە بولسۇن.
002	EXO	026	034	ئاندىن سەن «كەفارەت تەختى»نى ئەڭ مۇقەددەس جايدىكى ھۆكۈم-گۇۋاھلىق ساندۇقىنىڭ ئۈستىگە قويغىن.
002	EXO	026	035	شىرە بولسا پەردىنىڭ تېشىغا ئورۇنلاشتۇرۇلسۇن؛ چىراغداننى شىرەنىڭ ئۇدۇلىغا، چېدىرنىڭ جەنۇب تەرىپىگە قويغىن؛ شىرەنى شىمال تەرىپىگە قويغىن.
002	EXO	026	036	بۇنىڭدىن باشقا سەن چېدىرنىڭ كىرىش ئېغىزىغا نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ ئىشلەنگەن بىر پەردە ياسىغىن؛ ئۇ كەشتىچى تەرىپىدىن كەشتىلەنسۇن.
002	EXO	026	037	بۇ پەردە ئۈچۈن ئاكاتسىيە ياغىچىدىن بەش خادا ياساپ، ئۇلارنى ئالتۇن بىلەن قاپلىغىن؛ ھەربىرىنىڭ ئالتۇن ئىلمىكى بولسۇن؛ ئۇلارنىڭ تېگىگە بەش دانە تەگلىكنى مىستىن قۇيۇپ تەييارلاتقىن.
002	EXO	027	001	سەن قۇربانگاھنى ئاكاتسىيە ياغىچىدىن ياسىغىن. قۇربانگاھ تۆت چاسا بولسۇن؛ ئۇزۇنلۇقى بەش گەز، كەڭلىكى بەش گەز، ئېگىزلىكى ئۈچ گەز قىلىنسۇن.
002	EXO	027	002	ئۇنىڭ تۆت بۇرجىكىگە قويۇلىدىغان مۈڭگۈزلىرىنى ياسىغىن؛ مۈڭگۈزلىرى قۇربانگاھ بىلەن بىر گەۋدە قىلىنسۇن. قۇربانگاھنى مىس بىلەن قاپلىغىن.
002	EXO	027	003	قۇربانگاھنىڭ ياغ [ۋە كۈلىنى] ئېلىشقا داسلارنى ياسىغىن؛ ئۇنىڭغا خاس بولغان گۈرجەكلەرنى، كورىلارنى، لاخشىگىرلارنى ۋە ئوتدانلارنىمۇ ياسىغىن؛ ئۇنىڭ بارلىق ئەسۋابلىرىنى ياساشقا مىس ئىشلەتكىن.
002	EXO	027	004	قۇربانگاھ ئۈچۈن مىستىن بىر شالا ياسىغىن؛ شالانىڭ تۆت بۇرجىكىگە تۆت مىس ھالقا ياساپ بېكىتىپ قويغىن.
002	EXO	027	005	شالانى قۇربانگاھنىڭ قاپ بېلىنىڭ ئاستىدىكى گىرۋەكتىن تۆۋەنرەك تۇرىدىغان قىلغىن، شۇنداقتا شالا قۇربانگاھنىڭ دەل ئوتتۇرىسىدا بولىدۇ.
002	EXO	027	006	قۇربانگاھقا ئىككى بالداق ياسىغىن؛ ئۇلار ئاكاتسىيە ياغىچىدىن بولسۇن، ئۇلارنى مىس بىلەن قاپلىغىن.
002	EXO	027	007	قۇربانگاھنى كۆتۈرگەندە، بالداقلار ئۇنىڭ ئىككى يېنىدا بولۇشى ئۈچۈن، ئۇلارنى ھالقىلارغا ئۆتكۈزۈپ قويغىن.
002	EXO	027	008	قۇربانگاھنى تاختايلاردىن ياسىغىن، ئىچى بوش بولسۇن؛ ئۇ تاغدا ساڭا ئايان قىلىنغان نۇسخا بويىچە [ھۈنەرۋەنلەر] تەييار قىلسۇن.
002	EXO	027	009	مۇقەددەس چېدىرنىڭ ھويلىسىنىمۇ ياسىغىن. ھويلىنىڭ جەنۇبىغا، يەنى جەنۇبقا يۈزلەنگەن تەرىپىگە نېپىز توقۇلغان ئاق كاناپ رەختتىن پەردىلەرنى توقۇغىن؛ شۇ تەرىپىنىڭ ئۇزۇنلۇقى يۈز گەز بولسۇن.
002	EXO	027	010	پەردىلەرنى ئېسىشقا يىگىرمە خادا ياسالسۇن؛ ئۇلارنىڭ تېگىگە قويۇشقا يىگىرمە مىس تەگلىك ياسالسۇن؛ خادىلارنىڭ ئىلمىكى بىلەن بالداقلار بولسا كۈمۈشتىن ياسالسۇن.
002	EXO	027	011	شۇنىڭغا ئوخشاش شىمال تەرىپىدىمۇ ئۇزۇنلۇقى يۈز گەز كېلىدىغان پەردە بولسۇن. پەردىلەرنى ئېسىشقا يىگىرمە خادا ياسالسۇن؛ ئۇلارنىڭ تېگىگە قويۇشقا يىگىرمە مىس تەگلىك ياسالسۇن؛ خادىلارنىڭ ئىلمىكى بىلەن بالداقلار بولسا كۈمۈشتىن ياسالسۇن.
002	EXO	027	012	ھويلىنىڭ غەرب تەرىپىدە ئۇزۇنلۇقى ئەللىك گەز كېلىدىغان پەردە بولسۇن؛ ئۇنىڭ ئون خادىسى ۋە ئون تەگلىكى بولسۇن.
002	EXO	027	013	ھويلىنىڭ شەرق تەرىپى، يەنى كۈن چىقىشقا يۈزلەنگەن تەرىپىنىڭ كەڭلىكى ئەللىك گەز بولسۇن.
002	EXO	027	014	بىر تەرىپىدە ئون بەش گەز كېلىدىغان پەردە بولسۇن؛ ئۇنىڭ ئۈچ خادىسى بىلەن ئۈچ تەگلىكى بولسۇن.
002	EXO	027	015	يەنە بىر تەرىپىدە ئون بەش گەز كېلىدىغان پەردە بولسۇن؛ ئۇنىڭ ئۈچ خادىسى بىلەن ئۈچ تەگلىكى بولسۇن.
002	EXO	027	016	ھويلىنىڭ كىرىش ئېغىزىغا يىگىرمە گەز كېلىدىغان بىر پەردە قويۇلسۇن؛ پەردە نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ، كەشتىچى تەرىپىدىن كەشتىلەنسۇن. ئۇنىڭ تۆت خادىسى بىلەن تۆت تەگلىكى بولسۇن.
002	EXO	027	017	ھويلىنىڭ چۆرىسىدىكى ھەممە خادىلار كۈمۈشتىن ياسالغان بالداقلار بىلەن بىر-بىرىگە چېتىلسۇن؛ ئۇلارنىڭ ئىلمەكلىرى كۈمۈشتىن، تەگلىكلىرى مىستىن ياسالسۇن.
002	EXO	027	018	ھويلىنىڭ ئۇزۇنلۇقى يۈز گەز، كەڭلىكى ھەر ئىككى تەرىپى ئەللىك گەز بولسۇن؛ نېپىز توقۇلغان ئاق كاناپ رەختتىن ئىشلەنگەن پەردىنىڭ ئېگىزلىكى بەش گەز قىلىنسۇن؛ خادىلارنىڭ تەگلىكلىرى مىستىن ياسالسۇن.
002	EXO	027	019	مۇقەددەس چېدىرنىڭ ئىش-خىزمىتىدە ئىشلىتىلىدىغان بارلىق ئەسۋاب-سايمانلىرى ھەمدە بارلىق مىق-قوزۇقلىرى، شۇنداقلا ھويلىنىڭ بارلىق مىق-قوزۇقلىرى مىستىن بولسۇن.
002	EXO	027	020	ــ چىراغنىڭ ھەمىشە يېنىق تۇرۇشى ئۈچۈن، چىراغقا ئىشلىتىشكە زەيتۇندىن سوقۇپ چىقىرىلغان ساپ ماينى قېشىڭغا كەلتۈرۈشكە ئىسرائىللارنى بۇيرۇغىن.
002	EXO	027	021	جامائەت چېدىرىنىڭ ئىچىدە، ھۆكۈم-گۇۋاھلىق ساندۇقىنىڭ ئۇدۇلىدىكى پەردىنىڭ تاشقىرىدا ھارۇن ۋە ئوغۇللىرى ھەر كېچىسى ئەتىگەنگىچە پەرۋەردىگارنىڭ ئالدىدا چىراغلارنىڭ يېنىق تۇرغۇزۇش ئىشىدا بولسۇن. بۇ ئىش دەۋردىن-دەۋرگىچە ئىسرائىللارغا ئەبەدىي بىر قانۇن-بەلگىلىمە بولسۇن.
002	EXO	028	001	سەن ئىسرائىللارنىڭ ئىچىدىن ئاكاڭ ھارۇن ۋە ئۇنىڭ ئوغۇللىرىنى ئۆز قېشىڭغا كەلتۈرگىن؛ ئۇلارنى، يەنى ھارۇن ۋە ئوغۇللىرى ناداب، ئابىھۇ، ئەلىئازار ۋە ئىتامارلارنىڭ مېنىڭ كاھىنلىق خىزمىتىمدە بولۇشى ئۈچۈن يېنىڭغا كەلتۈرگىن.
002	EXO	028	002	ئاكاڭ ھارۇنغا ھەم شەرەپ ھەم گۈزەللىك ئۈچۈن مۇقەددەس كىيىملەرنى تەييارلىغىن.
002	EXO	028	003	ھارۇننىڭ ماڭا مۇقەددەس قىلىنىپ، مېنىڭ كاھىنلىق خىزمىتىمدە بولۇشى ئۈچۈن، مەن ئەقىل-پاراسەتنىڭ روھى بىلەن قەلبلىرىنى تولدۇرغان چېۋەر كىشىلەرنىڭ ھەربىرىگە سۆز قىلىپ، ئۇلارنى ئالاھىدە كىيىملەرنى تىكىشكە بۇيرۇغىن.
002	EXO	028	004	ئۇلار تىكىدىغان كىيىملەر مۇنۇلاردىن ئىبارەت: ــ بىر قوشېن، بىر ئەفود، بىر تون، كەشتىلەنگەن بىر خالتا كۆڭلەك، بىر سەللە ۋە بىر بەلۋاغ. مېنىڭ كاھىنلىق خىزمىتىمدە بولۇشى ئۈچۈن، ئۇلار ئاكاڭ ھارۇنغا ۋە ئوغۇللىرىغا مۇقەددەس كىيىملەرنى تىكسۇن.
002	EXO	028	005	ئۇنىڭغا ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار بىلەن نېپىز توقۇلغان ئاق كاناپ رەخت ئىشلىتىلسۇن؛
002	EXO	028	006	ئەفودنى ئۇلار ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار بىلەن نېپىز توقۇلغان ئاق كاناپ رەختلەرنى تەييارلاپ، چېۋەر قوللارغا نەپىس قىلىپ [كەشتىلىتىپ] ئىشلەتسۇن.
002	EXO	028	007	ئەفودنىڭ ئىككى بېشىنى بىر-بىرگە تۇتاشتۇرۇش ئۈچۈن ئىككى دولىسىدا مۈرىلىك تاسما بولسۇن.
002	EXO	028	008	ئەفودنىڭ ئۈستىدىن باغلايدىغان، كەشتىلەنگەن بەلۋاغ ئەفود بىلەن بىر پۈتۈن قىلىنسۇن ۋە ئۇنىڭغا ئوخشاش سىپتا ئىشلىنىپ، ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار ۋە نېپىز توقۇلغان ئاق كاناپ رەختتىن ياسالسۇن.
002	EXO	028	009	ئىككى ئاق ھېقىقنى تېپىپ، ئۇلارنىڭ ئۈستىگە ئىسرائىلنىڭ ئوغۇللىرىنىڭ ناملىرىنى ئويدۇرغىن؛
002	EXO	028	010	ئۇلارنىڭ ناملىرىنىڭ ئالتىسى بىر ياقۇتقا ئويۇلسۇن، قالغان ئالتىسى بولسا يەنە بىر ياقۇتقا ئويۇلسۇن، ھەممىسى تۇغۇلۇش تەرتىپى بويىچە پۈتۈلسۇن.
002	EXO	028	011	خۇددى ياقۇت نەقىشچىلىرى ئىشلىگەندەك، مۆھۈر ئويۇلغاندەك ئىسرائىلنىڭ ئوغۇللىرىنىڭ ناملىرىنى ئىككى ياقۇتقا ئويدۇرغىن؛ ئۇلار ئالتۇندىن ياسالغان كۆزلۈككە بېكىتىلسۇن.
002	EXO	028	012	ئىسرائىلنىڭ ئوغۇللىرىغا ئەسلەتمە تاش بولسۇن ئۈچۈن، ئىككى ياقۇتنى ئەفودنىڭ ئىككى مۈرىلىك تاسمىسىغا قادىغۇزغىن؛ شۇنداق بولغاندا، ھارۇن پەرۋەردىگارنىڭ ئالدىدا ئۇلارنىڭ ناملىرىنى ئەسلەتمە سۈپىتىدە مۈرىلىرىدە كۆتۈرۈپ يۈرىدۇ.
002	EXO	028	013	بۇنىڭدىن باشقا، سەن ئالتۇندىن يەنە ئىككى كۆزلۈك ۋە ساپ ئالتۇندىن شوينىدەك ئېشىپ ئېتىلگەن ئىككى زەنجىر ياساتقىن؛ ئاندىن ئېشىلمە زەنجىرلەر كۆزلۈكلەرگە بېكىتىلسۇن.
002	EXO	028	015	«ھۆكۈم قوشېنى»نى چېۋەر قوللارغا نەپىس قىلىپ كەشتىلىتىپ ياساتقىن؛ ئۇنى ھەم ئەفودنى ئىشلىگەن ئۇسۇلدا ياسىغان، ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار بىلەن نېپىز توقۇلغان ئاق كاناپ رەختتىن ياسىغىن.
002	EXO	028	016	ئۇ ئىككى قات، تۆت چاسا قىلىنسۇن؛ ئۇزۇنلۇقى بىر غېرىچ، كەڭلىكىمۇ بىر غېرىچ بولسۇن.
002	EXO	028	017	ئۇنىڭ ئۈستىگە تۆت قاتار قىلىپ گۆھەرلەرنى ئورناتقىن: ــ بىرىنچى قاتارغا قىزىل ياقۇت، سېرىق گۆھەر ۋە زۇمرەت ئورنىتىلسۇن؛
002	EXO	028	018	ئىككىنچى قاتارغا كۆك قاشتېشى، كۆك ياقۇت ۋە ئالماس ئورنىتىلسۇن؛
002	EXO	028	019	ئۈچىنچى قاتارغا سۆسۈن ياقۇت، پىروزا ۋە سۆسۈن كۋارتس ئورنىتىلسۇن؛
002	EXO	028	020	تۆتىنچى قاتارغا بېرىل ياقۇت، ئاق ھېقىق ۋە ئانارتاش ئورنىتىلسۇن؛ بۇلارنىڭ ھەممىسى ئالتۇن كۆزلۈك ئىچىگە ئورنىتىلسۇن.
002	EXO	028	021	بۇ گۆھەرلەر ئىسرائىلنىڭ ئوغۇللىرىنىڭ ناملىرىغا ۋەكىل قىلىنىپ، ئۇلارنىڭ سانىدەك ئون ئىككى بولۇپ، مۆھۈر ئويغاندەك ھەربىر گۆھەرگە ئون ئىككى قەبىلىنىڭ نامى بىردىن-بىردىن پۈتۈلسۇن.
002	EXO	028	022	قوشېنغا شوينىدەك ئېشىلگەن ساپ ئالتۇندىن [ئىككى] ئېشىلمە زەنجىر ياسىغىن.
002	EXO	028	023	قوشېنغا ئالتۇندىن ئىككى ھالقا ئېتىپ، ئىككى ھالقىنى قوشېننىڭ [يۇقىرىقى] ئىككى بۇرجىكىگە بېكىتكىن؛
002	EXO	028	024	ئاندىن ئالتۇندىن ئېشىلىپ ياسالغان ئىككى زەنجىرنى قوشېننىڭ [يۇقىرىقى] ئىككى بۇرجىكىدىكى ھالقىدىن ئۆتكۈزۈپ،
002	EXO	028	025	ئېشىلگەن شۇ زەنجىرلەرنىڭ ئىككى ئۇچىنى ئىككى كۆزلۈككە بېكىتىپ، [كۆزلۈكلەرنى] ئەفودنىڭ ئىككى مۈرىلىك تاسمىسىنىڭ ئالدى قىسمىغا ئورناتقىن.
002	EXO	028	026	بۇنىڭدىن باشقا سەن ئالتۇندىن ئىككى ھالقا ياساپ، ئۇلارنى قوشېننىڭ [ئاستى تەرىپىدىكى] ئىككى بۇرجىكىگە بېكىتكىن؛ ئۇلار ئەفودقا تېگىشىپ تۇرىدىغان قىلىنىپ ئىچىگە قادالسۇن.
002	EXO	028	027	مۇندىن باشقا سەن ئالتۇندىن [يەنە] ئىككى ھالقا ياساپ، ئۇلارنى ئەفودنىڭ ئىككى مۈرىلىك تاسمىسىنىڭ ئالدى تۆۋەنكى قىسمىغا، يەنى ئەفودقا ئۇلىنىدىغان جايغا يېقىن قىلىپ، كەشىتىلەنگەن بەلۋاغدىن ئېگىزرەك قىلىپ بېكىتكىن.
002	EXO	028	028	قوشېننىڭ ئەفودنىڭ كەشىتىلەنگەن بەلۋېغىدىن يۇقىرىراق تۇرۇشى، قوشېننىڭ ئەفودتىن ئاجراپ كەتمەسلىكى ئۈچۈن قوشېننىڭ ھالقىسىنى كۆك شوينا بىلەن ئەفودنىڭ ھالقىسىغا چېتىپ قويغىن.
002	EXO	028	029	شۇنداق قىلغاندا، ھارۇن مۇقەددەس جايغا كىرگەندە، ھۆكۈم قوشېنىنى تاقىغاچقا، ئىسرائىلنىڭ ئوغۇللىرىنىڭ ناملىرىنى ئەسلەتمە سۈپىتىدە يۈرىكىنىڭ ئۈستىدە پەرۋەردىگارنىڭ ئالدىدا دائىم كۆتۈرۈپ يۈرگەن بولىدۇ.
002	EXO	028	030	ھارۇن پەرۋەردىگارنىڭ ئالدىغا كىرگەندە، ئۇرىم بىلەن تۇممىم ئۇنىڭ يۈرىكى ئۈستىدە بولۇشى ئۈچۈن، بۇلارنى ھۆكۈم قوشېنىنىڭ ئىچىگە ئالغىن؛ مۇشۇنداق قىلغاندا، ھارۇن ئىسرائىللارغا باغلىق ھۆكۈملەرنى ھەمىشە پەرۋەردىگارنىڭ ھۇزۇرىدا ئۆز يۈرىكى ئۈستىدە كۆتۈرۈپ يۈرگەن بولىدۇ.
002	EXO	028	031	ئەفودنىڭ [ئىچىدىكى] توننى پۈتۈنلەي كۆك رەڭلىك قىلغىن.
002	EXO	028	032	توننىڭ باشقا كىيىلىدىغان تۆشۈكى دەل ئوتتۇرىسىدا بولسۇن؛ ئۇنىڭ يىرتىلىپ كەتمەسلىكى ئۈچۈن خۇددى باپكار توقۇغاندەك، ساۋۇتنىڭ ياقىسىغا ئوخشاش چۆرىسىگە پەۋاز چىقىرىلسۇن.
002	EXO	028	033	ئۇنىڭ ئېتىكىنىڭ چۆرىسىگە كۆك، سۆسۈن ۋە قىزىل يىپتىن ئانارلارنى توقۇپ ئاسقىن ھەمدە ئالتۇن قوڭغۇراقلارنى ياساپ، چۆرىسىدىكى ئانارلارنىڭ ئارىلىقىغا بىردىن ئېسىپ قويغىن؛ توننىڭ ئېتىكىنىڭ پۈتكۈل چۆرىسىگە بىر ئالتۇن قوڭغۇراق، بىر ئانار، يەنە بىر ئالتۇن قوڭغۇراق، بىر ئانار... بېكىتىلسۇن.
002	EXO	028	035	ھارۇن خىزمەت قىلغان ۋاقتىدا شۇ توننى كىيسۇن؛ بۇنىڭ بىلەن ھارۇن پەرۋەردىگارنىڭ ئالدىغا بارغاندا، يەنى مۇقەددەس جايغا، پەرۋەردىگارنىڭ ئالدىغا كىرىپ-چىققاندا ئۇنىڭ ئاۋازى ئاڭلىنىپ تۇرىدۇ-دە، ئۇ ئۆلۈمدىن ئامان قالىدۇ.
002	EXO	028	036	ئاندىن كېيىن سەن ساپ ئالتۇندىن نەپىس بىر ئوتۇغاتنى ياساپ، ئۇنىڭ ئۈستىگە مۆھۈرگە نەقىشلەنگەندەك: «پەرۋەردىگارغا مۇقەددەس قىلىندى» دەپ ئويغىن؛
002	EXO	028	037	ئۇنى كۆك رەڭلىك يىپ بىلەن سەللىسىگە چىگكىن؛ ئۇ سەللىنىڭ ئالدى تەرىپىگە تاقالسۇن؛
002	EXO	028	038	ئۇ ھارۇننىڭ پېشانىسىدە تۇرسۇن. بۇنىڭ بىلەن ھارۇن ئىسرائىللارنىڭ مۇقەددەس قىلىپ كەلتۈرگەن بارلىق مۇقەددەس ھەدىيەلىرىگە چاپلاشقان گۇناھلارنى ئۆز ئۈستىگە ئېلىپ كۆتۈرىدۇ؛ ھەدىيەلەرنىڭ پەرۋەردىگارنىڭ ئالدىدا قوبۇل قىلىنىشى ئۈچۈن ئوتۇغات ھەمىشە ئۇنىڭ پېشانىسىگە تاقاقلىق تۇرسۇن.
002	EXO	028	039	بۇنىڭدىن باشقا ئاق كاناپ رەختتىن بىر كۆڭلەك توقۇغىن، شۇنىڭدەك كاناپ رەختتىن توقۇلغان بىر سەللە تەييارلىغىن؛ كەشتىلەنگەن بىر بەلۋاغ ياسىغىن.
002	EXO	028	040	ھارۇننىڭ ئوغۇللىرىغا خالتا كۆڭلەكلەرنى تىككىن؛ ئۇلارغىمۇ بەلۋاغلارنى تەييارلا، ئۇلارغا ئېگىز بۆكلەرنىمۇ تىككىن؛ بۇلار ئۇلارغا ھەم شەرەپ ھەم گۈزەللىك بولسۇن.
002	EXO	028	041	بۇلارنىڭ ھەممىسىنى سەن ئاكاڭ ھارۇن ۋە ئۇنىڭ ئوغۇللىرىغا كىيدۈرگىن؛ ئاندىن ئۇلارنىڭ مېنىڭ ئالدىمدا كاھىنلىق خىزمىتىمدە بولۇشى ئۈچۈن ئۇلارنى مەسىھلەپ، ماڭا مۇقەددەس قىلىپ ئايرىغىن.
002	EXO	028	042	ئۇلارنىڭ ئەۋرەتلىرىنىڭ يېپىق تۇرۇشى ئۈچۈن ئۇلارغا كاناپ رەختتىن تامبال ئەتتۈرگىن؛ ئۇ بېلىدىن يوتىسىغىچە يېپىپ تۇرسۇن.
002	EXO	028	043	ھارۇن ۋە ئوغۇللىرى جامائەت چېدىرىغا كىرگەندە ياكى مۇقەددەس جايدا خىزمەتتە بولۇش ئۈچۈن قۇربانگاھقا يېقىنلاشقاندا، ئۇلار گۇناھكار بولۇپ ئۆلۈپ كەتمەسلىكى ئۈچۈن [تامبالنى] كىيىۋالسۇن. بۇ ئۇنىڭغا ۋە ئۇنىڭدىن كېيىنكى نەسىللىرى ئۈچۈن ئەبەدىي بىر بەلگىلىمە بولسۇن.
002	EXO	029	001	ئۇلارنىڭ ماڭا مۇقەددەس قىلىنىپ، كاھىنلىق خىزمىتىمدە بولۇشى ئۈچۈن مۇنداق ئىشنى ئادا قىلىشىڭ كېرەك: ــ سەن بىر ياش ئەركەك تورپاق بىلەن ئىككى قوچقارنى تاللا (ھەممىسى بېجىرىم بولسۇن)
002	EXO	029	002	ھەمدە پېتىر نان، زەيتۇن مېيى ئىلەشتۈرۈلگەن پېتىر توقاچ ۋە زەيتۇن مېيى سۈرۈلۈپ مەسىھلەنگەن پېتىر ھەمەك نانلارنى تەييارلا، بۇلارنىڭ ھەممىسىنى بۇغداي ئۇنىدىن قىلغىن؛
002	EXO	029	003	نانلارنىڭ ھەممىسىنى بىر سېۋەتكە سېلىپ، سېۋەتنى، تورپاقنى ۋە ئىككى قوچقارنى بىللە ھەدىيە قىلىپ كەلتۈرگىن.
002	EXO	029	004	سەن ھارۇن ۋە ئۇنىڭ ئوغۇللىرىنى جامائەت چېدىرىنىڭ كىرىش ئېغىزىغا يېقىن ئېلىپ كېلىپ، ئۇلارنى سۇ بىلەن يۇغىن؛
002	EXO	029	005	ئاندىن كىيىملىرىنى ئېلىپ كېلىپ، ھارۇنغا خالتا كۆڭلەك، ئەفود تونى ۋە ئەفودنى كىيدۈرگىن، قوشېننى تاقىغىن؛ ئاندىن بېلىگە ئەفودنىڭ كەشتىلەنگەن بەلۋېغىنى باغلىغىن.
002	EXO	029	006	بېشىغا سەللىنى يۆگەپ، سەللىگە مۇقەددەس ئوتۇغاتنى تاقاپ قويغىن.
002	EXO	029	007	ئاندىن مەسىھلەش مېيىنى ئېلىپ، بېشىغا قۇيۇپ ئۇنى مەسىھلىگىن.
002	EXO	029	008	ئاندىن سەن ئۇنىڭ ئوغۇللىرىنى ئېلىپ كېلىپ، ئۇلارغا خالتا كۆڭلەكلەرنى كىيدۈرگىن؛
002	EXO	029	009	ئۇلارغا، يەنى ھارۇن ۋە ئۇنىڭ ئوغۇللىرىغا بەلۋاغلارنى باغلاپ، ئېگىز بۆكلەرنى كىيدۈرگىن. شۇنىڭ بىلەن ئەبەدىي بەلگىلىمە بويىچە، كاھىنلىق خىزمىتى ئۇلارنىڭكى بولىدۇ؛ شۇنداق قىلىپ، سەن ھارۇن بىلەن ئۇنىڭ ئوغۇللىرىنى خۇداغا مۇقەددەس قىلىپ ئايرىپ تەيىنلىگىن.
002	EXO	029	010	— سەن تورپاقنى جامائەت چېدىرىنىڭ ئالدىغا ئېلىپ كەلگىن؛ ئېلىپ كەلگىنىڭدە ھارۇن بىلەن ئۇنىڭ ئوغۇللىرى قوللىرىنى تورپاقنىڭ بېشىغا قويسۇن.
002	EXO	029	011	ئاندىن سەن بۇ تورپاقنى پەرۋەردىگارنىڭ ئالدىدا، جامائەت چېدىرىنىڭ كىرىش ئېغىزىنىڭ يېنىدا بوغۇزلىغىن؛
002	EXO	029	012	تورپاقنىڭ قېنىدىن ئېلىپ بارمىقىڭ بىلەن ئۇنى قۇربانگاھنىڭ مۈڭگۈزلىرىگە سۈرۈپ، قالغان قاننىڭ ھەممىسىنى قۇربانگاھنىڭ تۈۋىگە تۆكۈپ قۇيغىن.
002	EXO	029	013	ئىچ قارنىنى يۆگەپ تۇرغان بارلىق ماينى، شۇنداقلا جىگەرنىڭ ئۈستىدىكى چاۋا ماي، ئىككى بۆرەك ۋە ئۇلارنىڭ ئۈستىدىكى ماينى ئاجرىتىپ بۇلارنى قۇربانگاھتا كۆيدۈرگىن.
002	EXO	029	014	تورپاقنىڭ گۆشى، تېرىسى ۋە تېزىكىنى بولسا چېدىرگاھنىڭ سىرتىغا ئېلىپ چىقىپ، ئوتتا كۆيدۈرۈۋەتكىن؛ بۇ گۇناھ قۇربانلىقى بولىدۇ.
002	EXO	029	015	ئاندىن سەن قوچقارلارنىڭ بىرىنى ئېلىپ كەلگىن؛ ھارۇن بىلەن ئۇنىڭ ئوغۇللىرى قوللىرىنى قوچقارنىڭ بېشىغا قويسۇن؛
002	EXO	029	016	ئاندىن سەن بۇ قوچقارنى بوغۇزلاپ، ئۇنىڭ قېنىدىن قۇربانگاھنىڭ ئۈستى قىسمىنىڭ ئەتراپىغا سەپكىن.
002	EXO	029	017	قوچقارنى پارچىلاپ، ئۇنىڭ ئىچ قارنى بىلەن پاچاقلىرىنى يۇيۇپ، ئۇلارنى گۆش پارچىلىرى ۋە باشنىڭ ئۈستىگە قويۇپ،
002	EXO	029	018	پۈتۈن قوچقارنى قۇربانگاھتا كۆيدۈرگىن. بۇ پەرۋەردىگارغا ئاتالغان كۆيدۈرمە قۇربانلىق ــ ئوت ئارقىلىق سۇنۇلىدىغان، پەرۋەردىگارغا خۇشبۇي يەتكۈزىدىغان ھەدىيە بولىدۇ.
002	EXO	029	019	كېيىن سەن ئىككىنچى قوچقارنى ئېلىپ كەلگىن؛ ھارۇن ۋە ئۇنىڭ ئوغۇللىرى قوللىرىنى قوچقارنىڭ بېشىغا قويسۇن.
002	EXO	029	020	ئاندىن بۇ قوچقارنى بوغۇزلاپ قېنىدىن ئېلىپ، ھارۇننىڭ ئوڭ قۇلىقىنىڭ يۇمشىقىغا، ئۇنىڭ ئوغۇللىرىنىڭ ئوڭ قۇلىقىنىڭ يۇمشىقىغا، ئۇلارنىڭ ئوڭ قوللىرىنىڭ چوڭ بارمىقى بىلەن ئوڭ پۇتلىرىنىڭ چوڭ بارمىقىغا سۈركەپ قويغىن، قالغان قاننى قۇربانگاھنىڭ ئۈستى قىسمىنىڭ ئەتراپىغا سەپكىن.
002	EXO	029	021	ئاندىن قۇربانگاھ ئۈستىدىكى قاندىن ۋە مەسىھلەش مېيىدىن ئېلىپ، ھارۇننىڭ ئۈستىگە، ئۇنىڭ كىيىملىرىگە، شۇنىڭدەك ئۇنىڭ ئوغۇللىرىنىڭ ئۈستىگە ۋە ئۇلارنىڭ كىيىملىرىگىمۇ سەپكىن. شۇنداق قىلىپ ئۇ ۋە ئۇنىڭ كىيىملىرى، ئۇنىڭ ئوغۇللىرى ۋە ئۇلارنىڭ كىيىملىرىمۇ ئۇنىڭ بىلەن تەڭ خۇداغا ئاتاپ مۇقەددەس قىلىنغان بولىدۇ.
002	EXO	029	022	ئاندىن سەن قوچقارنىڭ مېيى، قۇيرۇق مېيى، ئىچ قارنىنى يۆگەپ تۇرغان بارلىق ماي، جىگەرنىڭ ئۈستىدىكى چاۋا ماي، ئىككى بۆرەك ۋە ئۇلارنىڭ ئۈستىدىكى ماينى چىقار ھەمدە ئوڭ ئارقا پۇتىنى ئالغىن ــ (چۈنكى بۇ قوچقار كاھىنلىققا تىكلەش [قۇربانلىقىغا ئاتالغان] قوچقاردۇر) ــ
002	EXO	029	023	— بۇنىڭدىن باشقا سەن پەرۋەردىگارنىڭ ئالدىدا قويۇلغان پېتىر نان سېۋىتىدىن بىر گىردىنى، زەيتۇن مېيى ئىلەشتۈرۈلگەن پېتىر توقاچتىن بىرنى ۋە پېتىر ھەمەك ناندىن بىرنى ئېلىپ،
002	EXO	029	024	بۇلارنىڭ ھەممىسىنى ھارۇننىڭ قوللىرىغا ۋە ئۇنىڭ ئوغۇللىرىنىڭ قوللىرىغا قويۇپ، ئۇلارنى «پۇلاڭلاتما ھەدىيە» سۈپىتىدە پەرۋەردىگارنىڭ ئالدىدا پۇلاڭلاتقۇزغىن.
002	EXO	029	025	ئاندىن سەن بۇلارنى ئۇلارنىڭ قوللىرىدىن تاپشۇرۇپ ئېلىپ، پەرۋەردىگارنىڭ ئالدىدا خۇشبۇي چىقارسۇن دەپ، قۇربانگاھتىكى كۆيدۈرمە قۇربانلىقنىڭ ئۈستىدە قويۇپ كۆيدۈرگىن. بۇ ئوت ئارقىلىق پەرۋەردىگارغا سۇنۇلغان ھەدىيە بولىدۇ.
002	EXO	029	026	سەن ھارۇننى كاھىنلىققا تىكلەش قۇربانلىقىغا ئاتالغان قوچقارنىڭ تۆشىنى ئېلىپ «پۇلاڭلاتما ھەدىيە» سۈپىتىدە پەرۋەردىگارنىڭ ھۇزۇرىدا پۇلاڭلاتقىن؛ بۇ سېنىڭ ئۈلۈشۈڭ بولىدۇ.
002	EXO	029	027	شۇنىڭدەك، سەن كاھىنلىققا تىكلەش قۇربانلىقىغا ئاتالغان قوچقارنىڭ «پۇلاڭلاتما ھەدىيە» سۈپىتىدە پۇلاڭلىتىلغان تۆشى بىلەن «كۆتۈرمە ھەدىيە» سۈپىتىدە ئېگىز كۆتۈرۈپ پۇلاڭلىتىلغان ئارقا پۇتىنى، يەنى ھارۇن ۋە ئۇنىڭ ئوغۇللىرىغا بېغىشلانغان شۇ ئۈلۈشلەرنى «مۇقەددەس» دەپ ئايرىپ بېكىتكىن.
002	EXO	029	028	شۇنىڭ بىلەن بۇ نەرسىلەر ئەبەدىي بەلگىلىمە بويىچە ئىسرائىللار تەرىپىدىن ھارۇن ۋە ئوغۇللىرىغا بېغىشلانغان نېسىۋە بولىدۇ؛ چۈنكى ئۇ كۆتۈرمە ھەدىيەدۇر. بۇلار ئىسرائىللار تەرىپىدىن سۇنۇلىدىغان ئىناقلىق قۇربانلىقلىرىدىن ئايرىپ چىقىلىپ، ئۇلارنىڭ پەرۋەردىگارغا ئاتاپ «ئېگىز كۆتۈرگەن ھەدىيە»سى ھېسابلىنىپ، «كۆتۈرمە ھەدىيە» بولىدۇ.
002	EXO	029	029	ھارۇننىڭ مۇقەددەس كىيىملىرىگە كېيىن ئوغۇللىرى ۋارىسلىق قىلىدۇ. ئۇلار مەسىھلىنىپ، كاھىنلىققا تەيىنلەنگەندە شۇ كىيىملەرنى كىيسۇن.
002	EXO	029	030	ئوغۇللىرىنىڭ قايسىسى ئۇنىڭ ئورنىنى بېسىپ كاھىن بولسا، جامائەت چېدىرىغا كىرىپ مۇقەددەس جاينىڭ ئىچىدە خىزمەتكە كىرىشكەندە، بۇ كىيىملەرنى ئۇدا يەتتە كۈن كىيىپ يۈرسۇن.
002	EXO	029	031	سەن كاھىنلىققا تىكلەش قۇربانلىقىغا ئاتالغان قوچقارنى ئېلىپ، ئۇنىڭ گۆشىنى مۇقەددەس جايدا پىشۇرغىن؛
002	EXO	029	032	ئاندىن ھارۇن ۋە ئوغۇللىرى قوچقارنىڭ گۆشى بىلەن سېۋەتتىكى نانلارنى جامائەت چېدىرىنىڭ كىرىش ئېغىزىدا يېسۇن؛
002	EXO	029	033	ئۇلار ئۆزلىرىنىڭ كاھىنلىققا تەيىنلىنىشىدە خۇداغا ئاتاپ مۇقەددەس قىلىنغاندا كەفارەتكە ئىشلىتىلگەن نەرسىلەرنى يېسۇن، لېكىن بۇلار مۇقەددەس بولغاچقا، يات كىشى بۇنىڭدىن ھېچنېمىنى يېمىسۇن.
002	EXO	029	034	ئەگەر كاھىنلىققا تىكلەش قۇربانلىق گۆشىدىن ياكى ناندىن ئەتىگە ئازراق ئېشىپ قالسا، ئېشىپ قالغاننى ئوتتا كۆيدۈرۈۋەت؛ بۇلار مۇقەددەس بولغاچقا، ھېچكىم ئۇنىڭدىن يېسە بولمايدۇ.
002	EXO	029	035	سەن شۇ تەرىقىدە ھارۇن ۋە ئۇنىڭ ئوغۇللىرى توغرىسىدا بۇيرۇغىنىمنىڭ ھەممىسىنى بەجا كەلتۈرۈپ، ئۇدا يەتتە كۈنگىچە ئۇلارنى كاھىنلىققا تىكلەش ۋەزىپىسىنى ئادا قىلغىن.
002	EXO	029	036	ھەر كۈنى كەفارەت قىلىنىشقا گۇناھ قۇربانلىقى سۈپىتىدە بىر تورپاقنى سۇنغىن. قۇربانگاھنىڭ ئۆزىنى گۇناھتىن پاك قىلىشقا ئۇنىڭ ئۈچۈنمۇ كەفارەت كەلتۈرگىن، مۇقەددەس قىلىنسۇن دەپ، ئۇنى زەيتۇن مېيى بىلەن مەسىھلىگىن.
002	EXO	029	037	يەتتە كۈنگىچە سەن قۇربانگاھ ئۈچۈن كەفارەت كەلتۈرۈپ، ئۇنى مۇقەددەس قىلغىن. بۇنىڭ بىلەن ئۇ «ئەڭ مۇقەددەس نەرسىلەرنىڭ بىرى» ھېسابلىنىدۇ؛ ئۇنىڭغا تەگكەن ھەممە نەرسە مۇقەددەس ھېسابلىنىدۇ.
002	EXO	029	038	مانا، قۇربانگاھتا ھەمىشە سۇنىدىغانلىرىڭ مۇنۇلار: ــ ھەر كۈنى بىر ياشلىق ئىككى قوزا قۇربانلىق قىلىنسۇن.
002	EXO	029	039	بىرىنى ئەتىگەندە، يەنە بىرىنى گۇگۇمدا قۇربانلىق قىلىپ سۇنغىن.
002	EXO	029	040	بىرىنچى قوزا بىلەن بىرگە زەيتۇن مېيىدىن بىر ھىننىڭ تۆتتىن بىرى ئىلەشتۈرۈلگەن بۇغداي ئۇنىدىن [ئەفاھنىڭ] ئوندىن بىرى ۋە يەنە شاراب ھەدىيەسى سۈپىتىدە تۆتتىن بىر ھىن شاراب قوشۇپ سۇنۇلسۇن.
002	EXO	029	041	ئىككىنچى قوزىنى گۇگۇمدا سۇنغىن؛ ئۇنى ئەتىگەنلىك قۇربانلىقنىڭكىدەك، خۇشبۇي بولۇشى ئۈچۈن ئوت ئارقىلىق پەرۋەردىگارغا ئاتالغان قۇربانلىق سۈپىتىدە ئاشلىق ھەدىيەسى ۋە شاراب ھەدىيەسى بىلەن قوشۇپ سۇنغىن.
002	EXO	029	042	شۇ تەرىقىدە بۇ كۆيدۈرمە قۇربانلىق نەسىلدىن-نەسىلگە جامائەت چېدىرىنىڭ كىرىش ئېغىزىدا پەرۋەردىگارنىڭ ھۇزۇرىدا ئۆتكۈزۈلۈپ دائىملىق قۇربانلىق بولسۇن؛ مەن [پەرۋەردىگار] شۇ يەردە سىلەر بىلەن كۆرۈشۈپ، سەن بىلەن سۆزلىشىمەن.
002	EXO	029	043	شۇنىڭدەك مەن شۇ يەردە ئىسرائىللار بىلەن ئۇچرىشىمەن، شۇنىڭ بىلەن ئۇ جاي مېنىڭ شان-شەرىپىم بىلەن مۇقەددەس قىلىنىدۇ.
002	EXO	029	044	مەن جامائەت چېدىرى بىلەن قۇربانگاھنى ئۆزۈمگە ئاتاپ مۇقەددەس قىلىمەن؛ ھارۇن ۋە ئۇنىڭ ئوغۇللىرىنىمۇ ئۆزۈمگە كاھىنلىق خىزمەتتە بولۇشقا ئايرىپ مۇقەددەس قىلىمەن.
002	EXO	029	045	شۇنداق قىلىپ مەن ئىسرائىللارنىڭ ئارىسىدا ماكان قىلىپ، ئۇلارنىڭ خۇداسى بولىمەن.
002	EXO	029	046	ئۇ ۋاقىتتا ئۇلار مېنىڭ ئۇلارنىڭ ئارىسىدا ماكان قىلىشىم ئۈچۈن ئۇلارنى مىسىر زېمىنىدىن چىقىرىپ كەلگەن خۇداسى پەرۋەردىگار ئىكەنلىكىمنى بىلىدۇ؛ مەن ئۇلارنىڭ خۇداسى پەرۋەردىگاردۇرمەن.
002	EXO	030	001	سەن يەنە خۇشبۇي ياندۇرۇش ئۈچۈن بىر خۇشبۇيگاھنى ياساتقىن؛ ئۇنى ئاكاتسىيە ياغىچىدىن تەييارلىغىن.
002	EXO	030	002	ئۇ تۆت چاسا، ئۇزۇنلۇقى بىر گەز، كەڭلىكى بىر گەز، ئېگىزلىكى ئىككى گەز بولسۇن. ئۇنىڭ [تۆت بۇرجىكىدىكى] مۈڭگۈزلەر ئۇنىڭ بىلەن بىر پۈتۈن قىلىپ ياسالسۇن.
002	EXO	030	003	سەن ئۇنى، يەنى ئۇنىڭ ئۈستىنى، تۆت ئەتراپىنى ھەم مۈڭگۈزلىرىنى ساپ ئالتۇن بىلەن قاپلاتقىن؛ ئۇنىڭ ئۈستى قىسمىنىڭ چۆرىسىگە ئالتۇندىن گىرۋەك چىقارغىن.
002	EXO	030	004	ئۇنىڭغا ئالتۇندىن ئىككى ھالقا ياساپ، ئۇنىڭ گىرۋىكىنىڭ ئاستىغا بېكىتكىن؛ ئۇلارنى ئىككى يېنىغا ئۇدۇلمۇئۇدۇل بېكىتكىن. خۇشبۇيگاھنى كۆتۈرىدىغان ئىككى بالداقنى سېلىش ئۈچۈن بۇلارنى خۇشبۇيگاھنىڭ ئىككى تەرىپىگە ئورۇنلاشتۇرغىن.
002	EXO	030	005	بالداقلىرىنى ئاكاتسىيە ياغىچىدىن ياساپ، ئالتۇن بىلەن قاپلىغىن.
002	EXO	030	006	خۇشبۇيگاھنى ھۆكۈم-گۇۋاھلىق ساندۇقىنىڭ ئۇدۇلىدىكى پەردىنىڭ سىرتىغا، يەنى مەن سەن بىلەن كۆرىشىدىغان جاي بولغان ھۆكۈم-گۇۋاھلىق ساندۇقىنىڭ ئۈستىدىكى كەفارەت تەختىنىڭ ئۇدۇلىغا قويغىن.
002	EXO	030	007	ھارۇن شۇنىڭ ئۈستىدە ئېسىل خۇشبۇي ئەتىرنى ياندۇرسۇن؛ ھەر كۈنى ئەتىگەنلىكى چىراغلارنى پەرلىگىلى كەلگەندە، خۇشبۇيلارنى ياندۇرسۇن.
002	EXO	030	008	شۇنىڭدەك ھارۇن گۇگۇمدا چىراغلارنى تىزىپ ياققاندا، خۇشبۇي ياندۇرسۇن. شۇنداق قىلىپ پەرۋەردىگارنىڭ ئالدىدا نەسىلدىن-نەسىلگە خۇشبۇي ھەمىشە ئۆچۈرۈلمەي يېنىق بولىدۇ.
002	EXO	030	009	سىلەر ئۇنىڭ ئۈستىدە نە ھېچقانداق غەيرىي خۇشبۇي ياندۇرماڭلار، نە كۆيدۈرمە قۇربانلىق نە ئاشلىق ھەدىيەسى سۇنماڭلار، شۇنداقلا ئۇنىڭ ئۈستىگە ھېچقانداق شاراب ھەدىيەسىنى تۆكمەڭلار.
002	EXO	030	010	ھەر يىلدا ھارۇن بىر قېتىم [خۇشبۇيگاھنىڭ] مۈڭگۈزلىرىگە كەفارەت كەلتۈرسۇن؛ ھەر قېتىم كەفارەت كەلتۈرىدىغان گۇناھ قۇربانلىقىنىڭ قېنى بىلەن ئۇنىڭ ئۈچۈن كەفارەت كەلتۈرسۇن. نەسىلدىن-نەسىلگە شۇنداق قىلىڭلار؛ بۇ [خۇشبۇيگاھ] پەرۋەردىگارغا «ئەڭ مۇقەددەس» ھېسابلىنىدىغان نەرسىلەرنىڭ قاتارىدىندۇر.
002	EXO	030	011	پەرۋەردىگار مۇساغا مۇنداق دېدى: ــ
002	EXO	030	012	سەن ئىسرائىللارنىڭ سانىنى ئېنىقلاش ئۈچۈن ئۇلارنى سانىغىنىڭدا، ئۇلارنىڭ سانىلىشى ۋەجىدىن ئارىسىغا بالايىئاپەت كەلمەسلىكى ئۈچۈن، ئۇلارنى سانىغىنىڭدا ھەربىر ئادەم ئۆز جېنى ئۈچۈن پەرۋەردىگارغا كەفارەت پۇلى تاپشۇرسۇن.
002	EXO	030	013	رويخەتكە ئېلىنىپ، ساناقتىن ئۆتكەنلەرنىڭ ھەممىسى بېرىشى كېرەك بولغىنى شۇكى، ھەربىرى مۇقەددەس جايدىكى شەكەلنىڭ ئۆلچەم بىرلىكى بويىچە يېرىم شەكەل بەرسۇن (بىر شەكەل يىگىرمە گەراھقا باراۋەر كېلىدۇ). بۇ يېرىم شەكەل پەرۋەردىگارغا «كۆتۈرمە ھەدىيە» بولىدۇ.
002	EXO	030	014	رويخەتكە ئېلىنىپ، ساناقتىن ئۆتكەنلەر، يەنى يىگىرمە ياش ياكى ئۇنىڭدىن چوڭلارنىڭ ھەربىرى پەرۋەردىگارغا شۇ «كۆتۈرمە ھەدىيە»نى بەرسۇن.
002	EXO	030	015	ئۆز جېنىڭلارغا كەفارەت كەلتۈرۈش ئۈچۈن پەرۋەردىگارغا كۆتۈرمە ھەدىيە بەرگىنىڭلاردا باي كىشى يېرىم شەكەلدىن ئارتۇق بەرمىسۇن، كەمبەغەل كىشىمۇ يېرىم شەكەلدىن كەم بەرمىسۇن.
002	EXO	030	016	سەن ئىسرائىللاردىن شۇ كەفارەت پۇلىنى تاپشۇرۇپ ئېلىپ، جامائەت چېدىرىنىڭ خىزمىتىگە بېغىشلاپ ئىشلەتكىن؛ ئۇ پۇل ئىسرائىللارغا پەرۋەردىگارنىڭ ھۇزۇرىدا ئەسلەتمە سۈپىتىدە جېنىڭلارغا كەفارەت كەلتۈرىدىغان بولىدۇ.
002	EXO	030	017	پەرۋەردىگار مۇساغا مۇنداق دېدى: ــ
002	EXO	030	018	سەن يۇيۇنۇشقا ئىشلىتىشكە مىستىن [يوغان] بىر داس ۋە ئۇنىڭغا مىستىن بىر تەگلىك ياساتقىن؛ ئۇنى جامائەت چېدىرى بىلەن قۇربانگاھنىڭ ئوتتۇرىسىغا ئورۇنلاشتۇرۇپ، ئىچىگە سۇ توشتۇرۇپ قويغىن.
002	EXO	030	019	ھارۇن بىلەن ئۇنىڭ ئوغۇللىرى ئۇنىڭدىكى سۇ بىلەن پۇت-قوللىرىنى يۇسۇن.
002	EXO	030	020	ئۇلار جامائەت چېدىرىغا كىرگەندە ئۆلمەسلىكى ئۈچۈن سۇ بىلەن ئۆزىنى يۇيۇشى كېرەك؛ ئۇلار خىزمەت قىلىش ئۈچۈن، قۇربانگاھقا يېقىن بېرىپ پەرۋەردىگارغا ئوت ئارقىلىق ئاتىلىدىغان قۇربانلىق سۇنماقچى بولغىنىدىمۇ، شۇنداق قىلسۇن.
002	EXO	030	021	ئۇلار ئۆلمەسلىكى ئۈچۈن پۇت-قوللىرىنى يۇسۇن؛ بۇ ئىش ئۇلارغا، يەنى ئۆزى ۋە ئۇنىڭ نەسىللىرى ئۈچۈن ئەۋلادتىن ئەۋلادقىچە ئەبەدىي بىر بەلگىلىمە بولىدۇ.
002	EXO	030	022	پەرۋەردىگار مۇساغا مۇنداق دېدى: ــ
002	EXO	030	023	سەن ھەممىدىن ئېسىل خۇشبۇي دورا-دەرمەكلەردىن تەييارلا، يەنى مۇرمەككى سۇيۇقلۇقىدىن بەش يۈز شەكەل، دارچىندىن ئىككى يۈز ئەللىك شەكەل، ئېگىردىن ئىككى يۈز ئەللىك شەكەل،
002	EXO	030	024	قوۋزاقدارچىندىن بەش يۈز شەكەل ئېلىپ (بۇ ئۆلچەملەر مۇقەددەس جايدىكى شەكەلنىڭ ئۆلچەم بىرلىكى بويىچە بولسۇن) ۋە زەيتۇن مېيىدىنمۇ بىر ھىن تەييارلا؛
002	EXO	030	025	بۇ دورا-دەرمەكلەر بىلەن مەسىھ قىلىش ئۈچۈن بىر مۇقەددەس ماي ــ ئەتىرچى چىقارغاندەك بىر خۇشبۇي ماي چىقارغۇزغىن. بۇ «مۇقەددەس مەسىھلەش مېيى» بولىدۇ.
002	EXO	030	026	سەن ئۇنىڭ بىلەن جامائەت چېدىرىنى، ھۆكۈم-گۇۋاھلىق ساندۇقىنى،
002	EXO	030	027	شىرە ۋە ئۇنىڭ بارلىق قاچا-قۇچىلىرىنى، چىراغدان ۋە ئۇنىڭ ئەسۋابلىرىنى، خۇشبۇيگاھنى،
002	EXO	030	028	كۆيدۈرمە قۇربانلىق قۇربانگاھى ۋە ئۇنىڭ ئەسۋابلىرىنى، يۇيۇنۇش دېسى ۋە ئۇنىڭ تەگلىكىنى مەسىھلىگىن؛
002	EXO	030	029	سەن شۇ تەرزدە ئۇلارنى «ئەڭ مۇقەددەس نەرسىلەر» قاتارىدا مۇقەددەس قىلغىن. ئۇلارغا تەگكەن ھەرقانداق نەرسىمۇ «مۇقەددەس» ھېسابلىنىدۇ.
002	EXO	030	030	ھارۇن بىلەن ئۇنىڭ ئوغۇللىرىنى بولسا ماڭا كاھىنلىق خىزمەتتە بولۇشى ئۈچۈن مەسىھلەپ مۇقەددەس قىلغىن.
002	EXO	030	031	ئىسرائىللارغا سۆز قىلىپ مۇنداق ئېيتقىن: ــ بۇ ماي ئەۋلادتىن ئەۋلادقىچە ماڭا ئاتالغان مۇقەددەس مەسىھلەش مېيى بولىدۇ.
002	EXO	030	032	ئۇنى ئادەمنىڭ بەدىنىگە قۇيسا بولمايدۇ؛ شۇنىڭدەك ئۇنىڭغا ئوخشايدىغان ياكى تەركىبى ئوخشىشىدىغان ھېچقانداق مايلارنى ياسىماڭلار. ئۇ مۇقەددەس بولغىنى ئۈچۈن سىلەرگىمۇ مۇقەددەس بولۇشى كېرەك.
002	EXO	030	033	كىمكى تەركىبى شۇنىڭغا ئوخشايدىغان ماي تەڭشىسە، ياكى ئۇنى ئېلىپ يات بىرسىگە سۈرسە، ئۇ ئۆز خەلقى ئارىسىدىن ئۈزۈپ تاشلىنىدۇ.
002	EXO	030	034	پەرۋەردىگار مۇساغا مۇنداق دېدى: ــ سەن خۇشبۇي دورا-دەرمەكلەر، يەنى خۇشبۇي يېلىم، دېڭىز قۇلۇلىسى مېيى، ئاق دېۋىرقاي ۋە ساپ مەستىكى تەييارلىغىن. بۇلارنىڭ ھەممىسى ئوخشاش مىقداردا بولسۇن؛
002	EXO	030	035	خۇددى ئەتىرچى ماي چىقارغانغا ئوخشاش، ئۇلارنى تەڭشەپ خۇشبۇي ياسىغىن؛ ئۇ تۇزلانغان، ساپ ۋە مۇقەددەس پۇراقلىق ئەتىر بولىدۇ.
002	EXO	030	036	سەن ئۇنىڭدىن ئازراق ئېلىپ، تالقاندەك ئوبدان ئېزىپ، جامائەت چېدىرىدىكى ھۆكۈم-گۇۋاھلىق [ساندۇقىنىڭ] ئۇدۇلىغا، يەنى مەن سىلەر بىلەن كۆرۈشىدىغان جاينىڭ ئالدىغا قويغىن. بۇ سىلەرگە پەرۋەردىگارغا ئاتالغان «ئەڭ مۇقەددەس نەرسىلەر» قاتارىدا ھېسابلانسۇن.
002	EXO	030	037	سىلەر ياسىغان بۇ خۇشبۇينىڭ رېتسېپى بىلەن ئۆزۈڭلارغىمۇ ئوخشاش بىر خۇشبۇينى ياسىۋالساڭلار بولمايدۇ. ئۇ ساڭا نىسبەتەن ئېيتقاندا پەرۋەردىگارغا خاس قىلىنغان مۇقەددەس بولىدۇ.
002	EXO	030	038	كىمكى ئۇنىڭ پۇرىقىنى پۇراپ ھۇزۇرلىنىش ئۈچۈن ئۇنىڭغا ئوخشاپ كېتىدىغان ھەرقانداق بىر خۇشبۇينى ياسىسا، ئۇ ئۆز خەلقى ئارىسىدىن ئۈزۈپ تاشلانسۇن.
002	EXO	031	001	پەرۋەردىگار خۇدا مۇساغا مۇنداق دېدى: ــ
002	EXO	031	002	مانا، مەن ئۆزۈم يەھۇدا قەبىلىسىدىن بولغان خۇرنىڭ نەۋرىسى، ئۇرىنىڭ ئوغلى بەزالەلنى ئىسمىنى ئاتاپ چاقىردىم؛
002	EXO	031	003	ئۇنى خۇدانىڭ روھى بىلەن تولدۇرۇپ، ئۇنىڭغا دانالىق، ئەقىل-پاراسەت، ئىلىم-ھېكمەت ئىگىلىتىپ، ئۇنى ھەرتۈرلۈك ئىشنى قىلىشقا قابىلىيەتلىك قىلىپ،
002	EXO	031	004	تۈرلۈك-تۈرلۈك ھۈنەرلەرنى قىلالايدىغان، يەنى ئالتۇن، كۈمۈش ۋە مىس ئىشلىرىنى قىلالايدىغان،
002	EXO	031	005	ياقۇتلارنى كېسىپ-ئويالايدىغان، ئۇلارنى زىننەت بۇيۇملىرىغا ئورنىتالايدىغان، ياغاچلارغا نەقىش چىقىرالايدىغان، ھەرخىل ھۈنەر ئىشلىرىنى قاملاشتۇرالايدىغان قىلدىم.
002	EXO	031	006	شۇنىڭدەك مانا، مەن يەنە دان قەبىلىسىدىن ئاھىساماقنىڭ ئوغلى ئوھولىيابنى ئۇنىڭغا ياردەمچىلىككە تەيىنلىدىم، شۇنداقلا مەن ساڭا بۇيرۇغان ھەممە نەرسىلەرنى ياسىسۇن دەپ، بارلىق پەم-پاراسەتلىك كىشىكەرنىڭ كۆڭلىگە تېخىمۇ ئەقىل-پاراسەت ئاتا قىلدىم؛
002	EXO	031	007	شۇنىڭ بىلەن ئۇلار جامائەت چېدىرىنى، ھۆكۈم-گۇۋاھلىق ساندۇقىنى، ئۇنىڭ ئۈستىدىكى كەفارەت تەختىنى، چېدىرىنىڭ ھەممە ئەسۋابلىرىنى،
002	EXO	031	008	شىرە بىلەن ئۇنىڭ قاچا-قۇچىلىرىنى، ساپ ئالتۇندىن ياسىلىدىغان چىراغدان بىلەن ئۇنىڭ بارلىق ئەسۋابلىرىنى، خۇشبۇيگاھنى،
002	EXO	031	009	كۆيدۈرمە قۇربانلىق قۇربانگاھى بىلەن ئۇنىڭ بارلىق ئەسۋابلىرىنى، يۇيۇش دېسى بىلەن ئۇنىڭ تەگلىكىنى ياسىيالايدىغان،
002	EXO	031	010	خىزمەت كىيىملىرى، يەنى كاھىنلىق خىزمىتىدە كىيىلىدىغان، ھارۇن كاھىننىڭ مۇقەددەس كىيىملىرى ۋە ئۇنىڭ ئوغۇللىرىنىڭ كاھىنلىق كىيىملىرىنى توقۇيالايدىغان،
002	EXO	031	011	مەسىھلەش مېيى ۋە مۇقەددەس جايغا تەييارلىنىدىغان ئېسىل دورا-دەرمەكلەردىن خۇشبۇينى ياسىيالايدىغان بولدى. مەن ساڭا ئەمر قىلغىنىم بويىچە ئۇلار بارلىق ئىشنى بەجا كەلتۈرىدۇ.
002	EXO	031	012	پەرۋەردىگار مۇساغا ئەمر قىلىپ مۇنداق دېدى: ــ
002	EXO	031	013	سەن ئىسرائىللارغا ئەمر قىلىپ ئۇلارغا: ــ «سىلەر مېنىڭ شابات كۈنلىرىمنى چوقۇم تۇتۇڭلار؛ چۈنكى بۇلار سىلەرنىڭ ئۆزۈڭلارنى پاك-مۇقەددەس قىلغۇچىنىڭ مەن پەرۋەردىگار ئىكەنلىكىنى بىلىشىڭلار ئۈچۈن مەن بىلەن سىلەرنىڭ ئوتتۇراڭلاردىكى بىر نىشانە-بەلگە بولىدۇ.
002	EXO	031	014	شابات كۈنى سىلەرگە مۇقەددەس قىلىپ بېكىتىلگىنى ئۈچۈن، ئۇنى تۇتۇڭلار؛ كىمكى ئۇنى بۇزسا، ئۆلۈم جازاسىغا تارتىلمىسا بولمايدۇ؛ بەرھەق، كىمكى ئۇ كۈنىدە ھەرقانداق ئىشنى قىلسا، ئۆز خەلقى ئارىسىدىن ئۈزۈپ تاشلانسۇن.
002	EXO	031	015	ئالتە كۈن ئىچىدە ئىش قىلىنسۇن؛ لېكىن يەتتىنچى كۈنى پەرۋەردىگارغا ئاتالغان مۇقەددەس كۈن بولۇپ، ئارام ئالىدىغان شابات كۈنى بولىدۇ؛ كىمكى شابات كۈنىدە بىرەر ئىش قىلسا، ئۆلۈم جازاسىغا تارتىلمىسا بولمايدۇ.
002	EXO	031	016	ئىسرائىللار شابات كۈنىنى تۇتۇشى كېرەك؛ ئۇلار ئەبەدىي ئەھدە سۈپىتىدە ئۇنى ئەۋلادتىن ئەۋلادقىچە تۇتسۇن.
002	EXO	031	017	بۇ مەن بىلەن ئىسرائىللارنىڭ ئوتتۇرىسىدا ئەبەدىي بىر نىشانە-بەلگە بولىدۇ؛ چۈنكى پەرۋەردىگار ئالتە كۈن ئىچىدە ئاسمان بىلەن زېمىننى يارىتىپ، يەتتىنچى كۈنىدە ئارام ئېلىپ راھەت تاپقانىدى»، ــ دېگىن.
002	EXO	031	018	خۇدا سىناي تېغىدا مۇساغا بۇ سۆزلەرنى قىلىپ بولغاندىن كېيىن، ئىككى ھۆكۈم-گۇۋاھلىق تاختىيىنى ئۇنىڭغا تاپشۇردى. تاختايلار تاشتىن بولۇپ، [سۆزلەر] خۇدانىڭ بارمىقى بىلەن ئۇلارغا پۈتۈلگەنىدى.
002	EXO	032	001	خەلق مۇسانىڭ تاغدىن چۈشمەي ھايال بولۇپ قالغىنىنى كۆرۈپ، ھارۇننىڭ قېشىغا يىغىلىپ ئۇنىڭغا: ــ سەن قوپۇپ، بىزگە ئالدىمىزدا يول باشلاپ ماڭىدىغان بىر ئىلاھ ياساپ بەرگىن! چۈنكى بىزنى مىسىر زېمىنىدىن چىقىرىپ كەلگەن مۇسا دېگەن ھېلىقى كىشىگە نېمە بولۇپ كەتكەنلىكىنى بىلمەيمىز، ــ دېيىشتى.
002	EXO	032	002	ھارۇن ئۇلارغا: ــ خوتۇنلىرىڭلار بىلەن ئوغۇل-قىزلىرىڭلارنىڭ قۇلاقلىرىدىكى ئالتۇن زىرە ھالقىلارنى چىقىرىپ، مېنىڭ قېشىمغا ئېلىپ كېلىڭلار، دېدى.
002	EXO	032	003	شۇنىڭ بىلەن پۈتكۈل خەلق ئۆز قۇلاقلىرىدىكى ئالتۇن زىرە ھالقىلارنى چىقىرىپ ھارۇننىڭ قېشىغا ئېلىپ كەلدى.
002	EXO	032	004	ئۇ بۇلارنى ئۇلارنىڭ قولىدىن ئېلىپ، ئىسكىنە بىلەن قۇيما بىر موزاينى ياساتقۇزدى. شۇنىڭ بىلەن ئۇلار: ــ ئەي ئىسرائىل، سېنى مىسىر زېمىنىدىن چىقىرىپ كەلگەن خۇدايىڭلار مانا بۇدۇر! ــ دېيىشتى.
002	EXO	032	005	ھارۇن ئۇنى كۆرۈپ ئۇنىڭ ئالدىدا بىر قۇربانگاھنى ياسىتىپ ئاندىن: «ئەتە پەرۋەردىگار ئۈچۈن بىر ھېيت ئۆتكۈزۈلىدۇ»، دەپ ئېلان قىلدى.
002	EXO	032	006	ئەتىسى ئۇلار سەھەر قوپۇپ، كۆيدۈرمە قۇربانلىقلارنى سۇنۇپ، ئىناقلىق قۇربانلىقلىرىنىمۇ كەلتۈردى؛ ئاندىن خالايىق ئولتۇرۇپ يەپ-ئىچىشتى، قوپۇپ ئەيش-ئىشرەت قىلىشتى.
002	EXO	032	007	شۇ چاغدا پەرۋەردىگار مۇساغا: ــ ئورنۇڭدىن تۇر، تېزدىن پەسكە چۈشكىن! چۈنكى سەن مىسىر زېمىنىدىن چىقىرىپ كەلگەن خەلقىڭ بۇزۇقچىلىققا بېرىلىپ كەتتى.
002	EXO	032	008	مەن ئۇلارغا بۇيرۇغان يولدىن شۇنچە تېزلا چەتنەپ، ئۆزلىرى ئۈچۈن بىر قۇيما موزاينى ياساپ، ئۇنىڭغا چوقۇنۇپ قۇربانلىق كەلتۈرۈشتى ھەمدە: «ئەي ئىسرائىل، سېنى مىسىر زېمىنىدىن چىقىرىپ كەلگەن خۇدايىڭ مانا شۇدۇر!»، دېيىشتى، ــ دېدى.
002	EXO	032	009	ئاندىن پەرۋەردىگار مۇساغا: ــ مانا، بۇ خەلقنى كۆرۈپ قويدۇم؛ مانا، ئۇلار دەرۋەقە بوينى قاتتىق بىر خەلقتۇر.
002	EXO	032	010	ئەمدى مېنى توسما، مەن غەزەپ ئوتۇمنى ئۇلارنىڭ ئۈستىگە چۈشۈرۈپ، ئۇلارنى يۇتۇۋېتىمەن؛ ئاندىن سېنى ئۇلۇغ بىر ئەل قىلىمەن، ــ دېدى.
002	EXO	032	011	لېكىن مۇسا خۇداسى پەرۋەردىگاردىن ئۆتۈنۈپ ئىلتىجا قىلىپ مۇنداق دېدى: ــ ئەي پەرۋەردىگار، نېمىشقا سەن غەزەپ ئوتۇڭنى ئۆزۈڭ زور قۇدرەت ۋە كۈچلۈك قول بىلەن مىسىر زېمىنىدىن چىقىرىپ كەلگەن خەلقىڭنىڭ ئۈستىگە چۈشۈرىسەن؟
002	EXO	032	012	مىسىرلىقلار مازاق قىلىپ: ــ ئۇلارنىڭ بېشىغا بالا چۈشۈرۈش ئۈچۈن، ئۇلارنى تاغلارنىڭ ئۈستىدە ئۆلتۈرۈپ يەر يۈزىدىن يوقىتىش ئۈچۈن، [ئۇلارنىڭ خۇداسى] ئۇلارنى ئېلىپ كەتتى، ــ دېيىشسۇنمۇ؟ ئۆز ئوتلۇق غەزىپىڭدىن يېنىپ، ئۆز خەلقىڭگە بالايىئاپەت كەلتۈرۈش نىيىتىڭدىن يانغايسەن!
002	EXO	032	013	ئۆز قۇللىرىڭ ئىبراھىم، ئىسھاق ۋە ئىسرائىلنى ياد قىلغىن؛ سەن ئۇلارغا قەسەم بىلەن ۋەدە قىلىپ: «نەسلىڭلارنى ئاسماندىكى يۇلتۇزلاردەك ئاۋۇتىمەن، ئۆزۈم ئۇنىڭ توغرىسىدا سۆزلىگەن مۇشۇ زېمىننىڭ ھەممىسىنى نەسلىڭلارغا بېرىمەن، ئۇلار ئۇنىڭغا مەڭگۈ ئىگىدارچىلىق قىلىدىغان بولىدۇ» دېگەنىدىڭغۇ، ــ دېدى.
002	EXO	032	014	شۇنىڭ بىلەن پەرۋەردىگار ئۆز خەلقىنىڭ ئۈستىگە: «بالايىئاپەت چۈشۈرىمەن» دېگەن نىيىتىدىن ياندى.
002	EXO	032	015	مۇسا كەينىگە بۇرۇلۇپ، ئىككى ھۆكۈم-گۇۋاھلىق تاختىيىنى قولىغا ئېلىپ تاغدىن چۈشتى. تاختايلارنىڭ ئىككى تەرىپىگە سۆزلەر پۈتۈلگەنىدى؛ ئۇ يۈزىگىمۇ، بۇ يۈزىگىمۇ پۈتۈكلۈك ئىدى.
002	EXO	032	016	بۇ تاختايلار بولسا خۇدانىڭ ئۆزىنىڭ ياسىغىنى، پۈتۈلگەنلىرى بولسا خۇدانىڭ ئۆزىنىڭ پۈتكىنى ئىدى، ئۇ تاختايلارغا ئويۇلغانىدى.
002	EXO	032	017	يەشۇئا خەلقنىڭ كۆتۈرگەن چۇقان-سۈرەنلىرىنى، ۋارقىراشلىرىنى ئاڭلاپ مۇساغا: ــ چېدىرگاھدىن جەڭنىڭ خىتابى چىقىۋاتىدۇ، دېدى.
002	EXO	032	018	لېكىن ئۇ جاۋاب بېرىپ: ــ ئاڭلىنىۋاتقان ئاۋاز نە نۇسرەت تەنتەنىسى ئەمەس، نە مەغلۇبىيەتنىڭ پەريادى ئەمەس، بەلكى ناخشا-كۈي ساداسى! ــ دېدى.
002	EXO	032	019	مۇسا چېدىرگاھغا يېقىن كېلىپ، موزاينى ۋە جامائەتنىڭ ئۇسسۇلغا چۈشۈپ كەتكەنلىكىنى كۆرۈپ شۇنداق دەرغەزەپ بولدىكى، تاختايلارنى قولىدىن تاشلاپ تاغنىڭ تۈۋىدە چېقىۋەتتى.
002	EXO	032	020	ئاندىن ئۇلار ياسىغان موزاينى ئوتقا سېلىپ كۆيدۈرۈپ، ئۇنى يانجىپ كۇكۇم-تالقان قىلىپ، سۇ ئۈستىگە چېچىپ ئىسرائىللارنى ئىچىشكە مەجبۇرلىدى.
002	EXO	032	021	ئاندىن مۇسا ھارۇنغا: سەن ئۇلارنى شۇنچە ئېغىر گۇناھقا پاتقۇزغۇدەك، مۇشۇ خەلق ساڭا نېمە قىلدى؟ ــ دېدى.
002	EXO	032	022	ھارۇن جاۋاب بېرىپ: ــ خوجامنىڭ غەزەپ-ئاچچىقى تۇتاشمىغاي! بۇ خەلقنىڭ قانداق ئىكەنلىكىنى، ئۇلارنىڭ زەزىللىككە مايىل ئىكەنلىكىنى ئوبدان بىلىسەن.
002	EXO	032	023	ئۇلار ماڭا: ــ «بىزگە ئالدىمىزدا يول باشلاپ ماڭىدىغان بىر ئىلاھنى ياساپ بەرگىن؛ چۈنكى بىزنى مىسىر زېمىنىدىن چىقىرىپ كەلگەن مۇسا دېگەن شۇ ئادەمگە نېمە بولغىنىنى بىلمەيمىز»، دېدى.
002	EXO	032	024	مەن ئۇلارغا: «كىمدە ئالتۇن بولسا شۇنى چىقىرىپ بەرسۇن» دېسەم، ئۇلار ماڭا تاپشۇرۇپ بەردى؛ مەن ئۇنى ئوتقا تاشلىۋىدىم، مانا، بۇ موزاي چىقتى، ــ دېدى.
002	EXO	032	025	مۇسا خەلقنىڭ قانداقسىگە تىزگىنسىز بولۇپ كەتكەنلىكىنى كۆردى؛ چۈنكى ھارۇن ئۇلارنى دۈشمەنلىرىنىڭ ئالدىدا مەسخىرە ئوبيېكتى بولۇشقا ئۆز مەيلىگە قويۇۋەتكەنىدى.
002	EXO	032	026	مۇسا چېدىرگاھنىڭ كىرىش ئېغىزىغا بېرىپ، شۇ يەردە تۇرۇپ: ــ كىمكى پەرۋەردىگارنىڭ تەرىپىدە بولسا مېنىڭ يېنىمغا كەلسۇن! ــ دېدى. شۇنى دېۋىدى، لاۋىيلارنىڭ ھەممىسى ئۇنىڭ قېشىغا يىغىلدى.
002	EXO	032	027	ئۇ ئۇلارغا: ــ ئىسرائىلنىڭ خۇداسى پەرۋەردىگار مۇنداق دەيدۇ: ــ «ھەربىر كىشى ئۆز قىلىچىنى يانپىشىغا ئېسىپ، چېدىرگاھنىڭ ئىچىگە كىرىپ، بۇ چېتىدىن ئۇ چېتىگىچە كېزىپ يۈرۈپ، ھەربىرى ئۆز قېرىندىشىنى، ئۆز دوست-بۇرادىرىنى، ئۆز قوشنىسىنى ئۆلتۈرسۇن!» ــ دېدى.
002	EXO	032	028	شۇنىڭ بىلەن لاۋىيلار مۇسانىڭ بۇيرۇغىنى بويىچە ئىش كۆردى؛ شۇ كۈنى خەلقنىڭ ئىچىدىن ئۈچ مىڭ كىشى ئۆلتۈرۈلدى.
002	EXO	032	029	ئاندىن مۇسا: ــ ھەربىرىڭلار بۈگۈن ئۆزۈڭلارنى پەرۋەردىگارغا خاس بولۇشقا ئاتىدىڭلار؛ چۈنكى ھەربىرىڭلار ھەتتا ئۆز ئوغلۇڭلار ھەم قېرىندىشىڭلارنىمۇ ئايىمىدىڭلار؛ شۇنىڭ بىلەن بۈگۈن بەخت-بەرىكەتنى ئۈستۈڭلارغا چۈشۈردۇڭلار، دېدى.
002	EXO	032	030	ئەتىسى مۇسا خەلققە سۆز قىلىپ: ــ سىلەر دەرۋەقە ناھايىتى ئېغىر بىر گۇناھ سادىر قىلدىڭلار. ئەمدى مانا، مەن پەرۋەردىگارنىڭ ئالدىغا چىقىمەن؛ گۇناھىڭلار ئۈچۈن كەفارەت كەلتۈرەلەيمەنمىكىن، ــ دېدى.
002	EXO	032	031	شۇنىڭ بىلەن مۇسا پەرۋەردىگارنىڭ ئالدىغا يېنىپ بېرىپ: ــ ھەي...! بۇ خەلق دەرۋەقە ئېغىر بىر گۇناھ سادىر قىلىپ، ئۆزلىرىگە ئالتۇندىن ئىلاھلارنى ياساپتۇ!
002	EXO	032	032	لېكىن ئەمدى سەن ئۇلارنىڭ گۇناھىنى ئەپۇ قىلىشقا ئۇنىغايسەن...، ئۇنىمىساڭ، ئىسمىمنى ئۆزۈڭ يازغان دەپتىرىڭدىن ئۆچۈرۈۋەتكىن! ــ دېدى.
002	EXO	032	033	پەرۋەردىگار مۇساغا جاۋاب بېرىپ: ــ كىمكى مېنىڭ ئالدىمدا گۇناھ قىلغان بولسا، ئۇنىڭ ئېتىنى ئۆز دەپتىرىمدىن ئۆچۈرۈۋېتىمەن.
002	EXO	032	034	ئەمدى سەن بېرىپ، مەن ساڭا ئېيتقان جايغا خەلقنى باشلاپ بارغىن. مانا، مېنىڭ پەرىشتەم ئالدىڭدا ماڭىدۇ. لېكىن ئۇلارغا جازا بېرىدىغان كۈنۈم كەلگەندە، ئۇلارغا گۇناھى ئۈچۈن جازا بېرىمەن، دېدى.
002	EXO	032	035	بۇ سۆزدىن كېيىن پەرۋەردىگار خەلقنىڭ ھارۇننىڭ قولى بىلەن موزاينى قۇيدۇرۇپ ياساتقىنى ئۈچۈن ئۇلارنى ۋابا بىلەن جازالىدى.
002	EXO	033	001	پەرۋەردىگار مۇساغا مۇنداق دېدى: ــ سەن ئورنۇڭدىن تۇرۇپ، ئۆزۈڭ مىسىر زېمىنىدىن ئېلىپ كەلگەن خەلق بىلەن بىللە مۇشۇ يەردىن كېتىپ: «مەن سېنىڭ نەسلىڭگە ئۇنى بېرىمەن» دەپ قەسەم قىلىپ ئىبراھىمغا، ئىسھاققا ۋە ياقۇپقا ۋەدە قىلغان زېمىنغا بارغىن.
002	EXO	033	002	شۇنىڭ بىلەن سېنىڭ ئالدىڭدا بىر پەرىشتە ئەۋەتىپ، قانائانىي، ئامورىي، ھىتتىي، پەرىززىيلەرنى، ھىۋىي بىلەن يەبۇسىيلارنى ھەيدەپ چىقىرىپ،
002	EXO	033	003	سېنى سۈت بىلەن ھەسەل ئېقىپ تۇرىدىغان زېمىنغا كەلتۈرىمەن. چۈنكى سىلەر بوينى قاتتىق بىر خەلق بولغاچقا، يولدا سىلەرنى ھالاك قىلىۋەتمەسلىكىم ئۈچۈن، ئۆزۈم سىلەرنىڭ ئاراڭلاردا بولۇپ، شۇ [زېمىنغا] بىللە چىقمايمەن، ــ دېدى.
002	EXO	033	004	خالايىق بۇ قاتتىق سۆزنى ئاڭلاپ، قايغۇغا چۆمۈپ ھېچقايسىسى ئۆز زىبۇ-زىننەتلىرىنى تاقىمىدى.
002	EXO	033	005	چۈنكى پەرۋەردىگار مۇساغا سۆز قىلىپ: ــ سەن بېرىپ ئىسرائىللارغا: «[پەرۋەردىگار]: ــ سىلەر بوينى قاتتىق بىر خەلق ئىكەنسىلەر؛ ئەگەر مەن پەرۋەردىگار ئاراڭلارغا چىقىپ بىر دەقىقىلا تۇرسام، سىلەرنى يوقىتىۋەتكەن بولاتتىم. ئەمدى سىلەر ئۆزۈڭلاردىكى زىبۇ-زىننەتلەرنى ئېلىۋېتىڭلار؛ شۇ چاغدا مەن سىلەرگە نېمە قىلىدىغىنىمنى بىلىمەن، دېدى»، دەپ ئېيتقىن، ــ دېگەنىدى.
002	EXO	033	006	شۇڭا ئىسرائىللار ھورەب تېغىدىن ئايرىلىپلا زىبۇ-زىننەتلىرىنى ئۆزلىرىدىن ئېلىۋەتتى.
002	EXO	033	007	شۇنىڭ بىلەن مۇسا ئۆز چېدىرىنى ئېلىپ، ئۇنى چېدىرگاھنىڭ سىرتىدا، چېدىرگاھدىن نېرىراق بىر جايغا تىكىپ، ئۇنى «كۆرۈشۈش چېدىرى» دەپ ئاتىدى. كىمكى پەرۋەردىگارنى ئىزدەپ، يول سورىماقچى بولسا چېدىرگاھنىڭ سىرتىدىكى «كۆرۈشۈش چېدىرى»غا باراتتى.
002	EXO	033	008	شۇنداق بولاتتىكى، ھەر قېتىم مۇسا چېدىرغا چىقسا، پۈتكۈل خالايىق قوپۇپ، ھەربىرى ئۆز چېدىرىنىڭ ئىشىكىدە ئۆرە تۇرۇپ، مۇسا چېدىرغا كىرىپ بولغۇچە ئۇنىڭ كەينىدىن قارىشىپ تۇراتتى.
002	EXO	033	009	ئاندىن مۇسا ھەر قېتىم چېدىرغا كىرىپ كەتسە شۇنداق بولاتتىكى، بۇلۇت تۈۋرۈكى چۈشۈپ، چېدىرنىڭ كىرىش ئېغىزىدا توختايتتى؛ شۇنىڭ بىلەن پەرۋەردىگار مۇسا بىلەن سۆزلىشەتتى.
002	EXO	033	010	پۈتكۈل خالايىق بۇلۇت تۈۋرۈكىنىڭ جامائەت چېدىرىنىڭ كىرىش ئېغىزىدا توختىغىنىنى كۆرەتتى؛ ئۇنى كۆرگىنىدە خەلقنىڭ ھەممىسى قوپۇپ، ھەربىرى ئۆز چېدىرىنىڭ ئىشىكىدە تۇرۇپ سەجدە قىلىشاتتى.
002	EXO	033	011	شۇ چاغلاردا پەرۋەردىگار مۇسا بىلەن كىشىلەر ئۆز دوست-بۇرادىرى بىلەن سۆزلەشكەندەك، يۈزمۇيۈز سۆزلىشەتتى. ئاندىن مۇسا چېدىرگاھغا يېنىپ كېلەتتى؛ لېكىن ئۇنىڭ خىزمەتكارى بولغان نۇننىڭ ئوغلى يەشۇئا دېگەن ياش يىگىت چېدىرنىڭ ئىچىدىن چىقمايتتى.
002	EXO	033	012	مۇسا پەرۋەردىگارغا مۇنداق دېدى: ــ مانا، سەن دائىم ماڭا: «بۇ خەلقنى ئېلىپ چىققىن» دەپ كەلدىڭ؛ لېكىن ئۆزۈڭ ماڭا: «مەن سېنى ئىسمىڭنى بىلىپ تونۇيمەن»، ۋە شۇنىڭدەك «نەزىرىم ئالدىدا ئىلتىپات تاپتىڭ» دېگەن بولساڭمۇ، سەن مېنىڭ بىلەن بىرگە كىمنى ئەۋەتىدىغىنىڭنى ماڭا ئايان قىلمىدىڭ.
002	EXO	033	013	ئەگەر مەن راستتىنلا نەزىرىڭدە ئىلتىپات تاپقان بولسام، ئۆزۈمنىڭ سېنى تونۇشۇم ئۈچۈن، نەزىرىڭدە ئىلتىپات تېپىۋېرىشىم ئۈچۈن ماڭا ئۆز يولۇڭنى ئايان قىلغايسەن؛ مانا، بۇ خەلقنىڭ ئۆز خەلقىڭ بولغىنىنى نەزىرىڭدە تۇتقايسەن! ــ دېدى.
002	EXO	033	014	ئۇ جاۋاب بېرىپ: مەن ئۆزۈم [سەن] بىللە بىللە بېرىپ، ساڭا ئارام ئاتا قىلىمەن، ــ دېدى.
002	EXO	033	015	مۇسا ئۇنىڭغا جاۋابەن: ــ ئەگەر سەن ئۆزۈڭ [بىز] بىلەن بىللە ماڭمىساڭ، بىزنى بۇ يەردىن چىقارمىغايسەن؛
002	EXO	033	016	چۈنكى، مەن ۋە خەلقىڭ نەزىرىڭدە ئىلتىپات تاپقىنىمىز نېمىدىن بىلىنىدۇ؟ ئەجەبا، ئۆزۈڭنىڭ بىز بىلەن بىللە ماڭغىنىڭدىن بىلىنمەمدۇ؟ شۇ سەۋەبتىن مەن ۋە خەلقىڭ يەر يۈزىدىكى ھەربىر تائىپىلەردىن ئالاھىدە پەرقلەنمەمدۇق؟! ــ دېدى.
002	EXO	033	017	پەرۋەردىگار مۇساغا: ــ مۇشۇ ئىلتىجايىڭنىمۇ ئىجابەت قىلىمەن؛ چۈنكى سەن نەزىرىمدە ئىلتىپات تاپتىڭ ۋە مەن سېنى ئىسمىڭنى بىلىپ تونۇيمەن، دېدى.
002	EXO	033	018	شۇنىڭ بىلەن مۇسا: ــ ئۆز شان-شەرپىڭنى ماڭا كۆرسەتكەيسەن، ــ دېدى.
002	EXO	033	019	[پەرۋەردىگار]: ــ ئۆزۈمنىڭ پۈتكۈل مېھرىبانلىقىمنى سېنىڭ كۆز ئالدىڭدىن ئۆتكۈزىمەن ۋە ئالدىڭدا «ياھۋەھ» دېگەن نامنى جاكارلايمەن. كىمگە شاپائەت قىلماقچى بولسام شۇنىڭغا شاپائەت كۆرسىتىمەن، كىمگە رەھىم-شەپقەت كۆرسەتمەكچى بولسام، شۇنىڭغا رەھىم-شەپقەت كۆرسىتىمەن، دېدى.
002	EXO	033	020	پەرۋەردىگار ئۇنىڭغا: ــ سەن يۈزۈمنى كۆرەلمەيسەن؛ چۈنكى ھېچ ئادەمزات مېنى كۆرسە تىرىك قالمايدۇ، دېدى.
002	EXO	033	021	ئاندىن پەرۋەردىگار: ــ مانا، يېنىمدا بىر جاي باردۇر؛ سەن شۇ يەردىكى قورام تاشنىڭ ئۈستىدە تۇرغىن.
002	EXO	033	022	مېنىڭ شان-شەرىپىم ئۆتىدىغان ۋاقىتتا، شۇنداق بولىدۇكى، مەن سېنى شۇ قورام تاشنىڭ يېرىقىدا تۇرغۇزۇپ، مەن ئۆتۈپ بولغۇچە سېنى قولۇم بىلەن يېپىپ تۇرىمەن.
002	EXO	033	023	ئاندىن قولۇمنى تارتىۋالىمەن؛ شۇنىڭ بىلەن سەن مېنىڭ ئارقا تەرىپىمنى كۆرىسەن، لېكىن يۈزۈم كۆرۈنمەيدۇ، ــ دېدى.
002	EXO	034	001	پەرۋەردىگار مۇساغا: ــ سەن ئاۋۋالقىغا ئوخشاش ئۆزۈڭ ئۈچۈن تاشتىن ئىككى تاختاينى يونۇپ كەل؛ مەن بۇ تاختايلارغا سەن ئىلگىرى چېقىۋەتكەن تاختايلاردىكى سۆزلەرنى يېزىپ قويىمەن.
002	EXO	034	002	سەن ئەتە ئەتىگەنگىچە تەييار بولۇپ، سەھەردە سىناي تېغىغا چىقىپ، شۇ يەردە تاغنىڭ چوققىسىدا مېنىڭ ئالدىمدا ھازىر بولغىن.
002	EXO	034	003	لېكىن ھېچ كىشى سەن بىلەن بىللە چىقمىسۇن ۋە ياكى تاغنىڭ ھېچ يېرىدە باشقا ئادەم كۆرۈنمىسۇن، قوي-كالىلارمۇ تاغنىڭ تۈۋىدە ئوتلىمىسۇن، ــ دېدى.
002	EXO	034	004	مۇسا ئاۋۋالقىغا ئوخشاش تاشتىن ئىككى تاختاينى يونۇپ، ئەتىسى تاڭ سەھەر قوپۇپ، بۇ ئىككى تاش تاختاينى قولىدا ئېلىپ، پەرۋەردىگارنىڭ بۇيرۇغىنى بويىچە سىناي تېغىغا چىقتى.
002	EXO	034	005	شۇنىڭ بىلەن پەرۋەردىگار بۇلۇتتا چۈشۈپ، شۇ يەردە مۇسانىڭ قېشىدا تۇرۇپ، «ياھۋەھ» دېگەن نامىنى جاكارلىدى.
002	EXO	034	006	پەرۋەردىگار ئۇنىڭ كۆز ئالدىدىن ئۆتۈپ: ــ «پەرۋەردىگار، پەرۋەردىگار، رەھىمدىل ۋە مېھىر-شەپقەتلىكتۇر، ئاسان غەزەپلەنمەيدىغان، شاپائەت بىلەن ۋاپاسى كەڭ تەڭرىدۇر،
002	EXO	034	007	مىڭلىغان-ئون مىڭلىغانلارغا رەھىم-شاپائەت كۆرسىتىپ، قەبىھلىك، ئاسىيلىق ۋە گۇناھنى كەچۈرگۈچىدۇر؛ لېكىن ئۇ گۇناھكارلارنى ھەرگىز گۇناھسىز دەپ قارىمايدىغان، بەلكى ئاتىلارنىڭ قەبىھلىكىنىڭ جازاسىنى بالىلىرى ۋە نەۋرلىرىگىچە، شۇنداقلا ئۈچىنچى ۋە تۆتىنچى ئەۋلادىغىچە يۈكلەيدىغان [تەڭرىدۇر]» ــ دەپ جاكارلىدى.
002	EXO	034	008	شۇنىڭ بىلەن مۇسا دەرھال يەرگە باش قويۇپ سەجدە قىلىپ: ــ
002	EXO	034	009	ــ ئەي رەب، ئەگەر مەن راستتىنلا نەزىرىڭدە ئىلتىپات تاپقان بولسام، ئۇنداقتا ئى رەب، ئارىمىزدا بىز بىلەن ماڭغايسەن؛ چۈنكى بۇ خەلق دەرۋەقە بوينى قاتتىق بىر خەلقتۇر؛ بىزنىڭ قەبىھلىكىمىزنى ۋە گۇناھىمىزنى كەچۈرگەيسەن، بىزنى ئۆز مىراسىڭ بولۇشقا قوبۇل قىلغايسەن! ــ دېدى.
002	EXO	034	010	شۇنىڭ بىلەن ئۇ مۇساغا: ــ مانا، مەن بىر ئەھدە تۈزىمەن؛ سېنىڭ بارلىق خەلقىڭ ئالدىدا پۈتكۈل يەر يۈزىنىڭ ھېچبىر جايىدا ياكى ھېچبىر ئەل ئارىسىدا قىلىنىپ باقمىغان مۆجىزىلەرنى يارىتىمەن. شۇنىڭ بىلەن سەن ئارىسىدا بولغان خەلقىڭنىڭ ھەممىسى پەرۋەردىگارنىڭ [كارامەت] ئەمەلىنى كۆرىدۇ؛ چۈنكى مېنىڭ سىلەرگە قىلىدىغان ئەمەلىم دەرۋەقە دەھشەتلىك ئىش بولىدۇ.
002	EXO	034	011	مەن بۈگۈن ساڭا تاپىلايدىغان ئەمرلىرىمنى تۇتقىن؛ مانا، مەن سىلەرنىڭ ئالدىڭلاردىن ئامورىي، قانائانىي، ھىتتىي، پەرىززىي، ھىۋىي ۋە يەبۇسىيلارنى ھەيدەپ چىقىرىمەن.
002	EXO	034	012	ئەمدى ھېزى بولغىنكى، سەن بارىدىغان زېمىندا تۇرۇۋاتقانلار بىلەن ھېچ ئەھدە باغلاشمىغىن؛ بولمىسا، بۇ ئىش سىلەرگە تۇزاق بولىدۇ؛
002	EXO	034	013	بەلكى سىلەر ئۇلارنىڭ قۇربانگاھلىرىنى چۇۋۇپ، بۇت تۈۋرۈكلىرىنى سۇندۇرۇپ، «ئاشەراھ» بۇتلىرىنى كېسىپ تاشلاڭلار.
002	EXO	034	014	چۈنكى سەن ھېچقانداق باشقا ئىلاھقا ئىبادەت قىلماسلىقىڭ كېرەك ــ چۈنكى مەنكى پەرۋەردىگارنىڭ نامى «ۋاپاسىزلىققا ھەسەت قىلغۇچى» بولۇپ، ھەسەت قىلغۇچى بىر ئىلاھدۇرمەن.
002	EXO	034	015	بولمىسا، شۇ زېمىندا تۇرۇۋاتقانلار بىلەن ئەھدە تۈزۈشۈڭ مۇمكىن؛ ئاندىن ئۇلار ئىلاھلىرىنىڭ كەينىدىن يۈرۈپ بۇزۇقچىلىق قىلىپ، ئىلاھلىرىغا قۇربانلىقلار ئۆتكۈزگىنىدە، سىلەرنى چاقىرسا ئۇلارنىڭ قۇربانلىقلىرىدىن يەپ كېتىشىڭلار مۇمكىن؛
002	EXO	034	016	سەن شۇنداقلا يەنە ئۇلارنىڭ قىزلىرىنى ئوغۇللىرىڭغا خوتۇنلۇققا ئېلىپ بېرىشىڭ مۇمكىن؛ ئۇ قىزلار ئۆز ئىلاھلىرىنىڭ كەينىدىن يۈرۈپ بۇزۇقچىلىق قىلغىنىدا، ئۇلار ئوغۇللىرىڭنىمۇ ئۆز ئىلاھلىرىنىڭ ئارقىسىدىن ماڭغۇزۇپ، بۇزۇقچىلىق قىلدۇرۇشى مۇمكىن.
002	EXO	034	017	ئۆزۈڭ ئۈچۈن ھېچقانداق قۇيما بۇتلارنى ياساتمىغىن.
002	EXO	034	018	پېتىر نان ھېيتىنى تۇتۇڭلار؛ مېنىڭ ئەمر قىلغىنىمدەك ئابىب ئېيىدا، بېكىتىلگەن ۋاقىتتا يەتتە كۈن پېتىر نان يەڭلار. چۈنكى سىلەر ئابىب ئېيىدا مىسىردىن چىققانسىلەر.
002	EXO	034	019	بالىياتقۇنىڭ تۇنجى مېۋىسى مېنىڭكى بولىدۇ؛ چارپاي ماللىرىڭنىڭ ئىچىدىن دەسلەپ تۇغۇلغان ئەركەكلەر، كالا بولسۇن، قوي بولسۇن ئۇلارنىڭ تۇنجىلىرىنىڭ ھەممىسى مېنىڭكى بولسۇن.
002	EXO	034	020	لېكىن ئېشەكلەرنىڭ تۇنجى تەخەيلىرىنىڭ ئورنىغا قوزا بىلەن بەدەل تۆلىشىڭ لازىم بولىدۇ. ئەگەر ئورنىغا [قوزا] بەرمىسەڭ، تەخەينىڭ بوينىنى سۇندۇرۇۋەتكىن. تۇنجى ئوغۇللىرىڭنى بولسا، ئۇلارغا بەدەل تۆلەپ قايتۇرۇۋال. ھېچكىم مېنىڭ ھۇزۇرۇمغا قۇرۇق قول كەلمىسۇن.
002	EXO	034	021	سەن ئالتە كۈن ئىچىدە ئىش-ئەمەلىڭنى قىلىپ، يەتتىنچى كۈنى ئارام ئېلىشىڭ زۆرۈر؛ يەر ھەيدەش ۋاقتى بولسۇن، ئورما ۋاقتى بولسۇن، ئارام ئېلىشىڭ زۆرۈر.
002	EXO	034	022	يېڭى بۇغداينىڭ تۇنجى ھوسۇلىنى تەبرىكلەيدىغان «ھەپتىلەر ھېيتى»نى ئۆتكۈزۈڭلار؛ يىلنىڭ ئاخىرىدا «ھوسۇل يىغىش ھېيتى»نى ئۆتكۈزۈڭلار.
002	EXO	034	023	سېنىڭ ھەربىر ئەركەك كىشىلىرىڭ يىلدا ئۈچ قېتىم ئىسرائىلنىڭ خۇداسى بولغان رەب پەرۋەردىگارنىڭ ئالدىغا ھازىر بولسۇن.
002	EXO	034	024	چۈنكى مەن تائىپىلەرنى ئالدىڭدىن ھەيدىۋېتىپ، چېگرالىرىڭنى كېڭەيتىمەن؛ شۇنىڭدەك سەن يىلدا ئۈچ قېتىم پەرۋەردىگار خۇدايىڭنىڭ ئالدىغا ھازىر بولۇشقا چىقىپ بارساڭ، ھېچكىم يېرىڭگە كۆز قىرىنى سالمايدۇ.
002	EXO	034	025	ماڭا سۇنۇلىدىغان قۇربانلىقنىڭ قېنىنى بولدۇرۇلغان نان بىلەن بىللە سۇنمىغىن؛ ياكى ئۆتۈپ كېتىش ھېيتىنىڭ قۇربانلىقىنىڭ گۆشىنى ئەتىگە قالدۇرما.
002	EXO	034	026	زېمىنىڭنىڭ دەسلەپكى ھوسۇلىدىن تۇنجى مەھسۇلاتلارنى پەرۋەردىگار خۇدايىڭنىڭ ئۆيىگە كەلتۈرۈپ ئاتا. ئوغلاقنى ئانىسىنىڭ سۈتىدە قاينىتىپ پىشۇرما.
002	EXO	034	027	پەرۋەردىگار مۇساغا: ــ بۇ سۆزلەرنى ئۆزۈڭ ئۈچۈن يېزىۋالغىن؛ چۈنكى مەن مۇشۇ سۆزلەرنى ئاساس قىلىپ سەن بىلەن ۋە ئىسرائىل بىلەن ئەھدە باغلىدىم، دېدى.
002	EXO	034	028	ئۇ ۋاقىتتا مۇسا شۇ يەردە پەرۋەردىگارنىڭ ھۇزۇرىدا قىرىق كېچە-كۈندۈز تۇردى؛ ئۇ ھېچنەرسە يېمىدى، ھېچ سۇ ئىچمىدى. ئۇ يەردە [پەرۋەردىگار] تاختايلارغا ئەھدىنىڭ سۆزلىرى بولغان ئون ئەمرنى پۈتتى.
002	EXO	034	029	مۇسا سىناي تېغىدىن چۈشكەندە شۇنداق بولدىكى (ئۇ تاغدىن چۈشكەندە ئىككى ھۆكۈم-گۇۋاھلىق تاختىيى ئۇنىڭ قولىدا ئىدى)، ئۆزىنىڭ [پەرۋەردىگار] بىلەن سۆزلەشكىنى ئۈچۈن يۈزىنىڭ پارقىراپ كەتكىنىنى بىلمەيتتى.
002	EXO	034	030	ئەمدى ھارۇن ۋە بارلىق ئىسرائىللار مۇسانى كۆردى، مانا، ئۇنىڭ يۈز تېرىسى پارقىراپ تۇراتتى؛ ئۇلار ئۇنىڭغا يېقىن بېرىشتىن قورقۇشتى.
002	EXO	034	031	لېكىن مۇسا ئۇلارنى چاقىرىۋىدى، ھارۇن ۋە جامائەتنىڭ بارلىق باشلىرى يېنىپ، ئۇنىڭ قېشىغا كەلدى؛ مۇسا ئۇلار بىلەن سۆزلەشتى.
002	EXO	034	032	شۇنىڭدىن كېيىن، بارلىق ئىسرائىللار ئۇنىڭ يېنىغا كەلدى؛ ئۇ ۋاقىتتا مۇسا پەرۋەردىگار ئۆزىگە سىناي تېغىدا سۆز قىلغىنىدا تاپشۇرغان بارلىق ئەمرلەرنى ئۇلارغا تاپىلىدى.
002	EXO	034	033	مۇسا ئۇلارغا دەيدىغىنىنى دەپ تۈگەتتى. ئۇ [سۆزلىگەندە] يۈزىگە بىر چۈمپەردە تارتىۋالغانىدى؛
002	EXO	034	034	قاچانكى مۇسا پەرۋەردىگار بىلەن سۆزلىشىشكە ئۇنىڭ ھۇزۇرىغا كىرسە، چۈمپەردىنى ئېلىۋېتەتتى، تاكى ئۇ يېنىپ چىققۇچە شۇنداق بولاتتى؛ يېنىپ چىققاندا ئۆزىگە نېمە تاپىلانغان بولسا، شۇنى ئىسرائىللارغا ئېيتىپ بېرەتتى.
002	EXO	034	035	ئىسرائىللار مۇسانىڭ يۈز تېرىسىنىڭ پارقىراپ تۇرغىنىنى كۆرەتتى؛ شۇڭا مۇسا يەنە تاكى پەرۋەردىگار بىلەن سۆزلەشكىلى ئۇنىڭ ھۇزۇرىغا كىرگۈچە يۈزىگە چۈمپەردە تارتىۋالاتتى.
002	EXO	035	001	مۇسا ئىسرائىللارنىڭ پۈتكۈل جامائىتىنى يىغىپ ئۇلارغا: ــ پەرۋەردىگار سىلەرگە قىلىشقا بۇيرۇغان ئەمرلەر مۇنۇلاردۇر: ــ
002	EXO	035	002	ئالتە كۈن ئىش-ئەمگەك كۈنى بولسۇن؛ لېكىن يەتتىنچى كۈنى سىلەرگە نىسبەتەن مۇقەددەس بىر كۈن بولۇپ، پەرۋەردىگارغا ئاتالغان ئارام ئالىدىغان شابات كۈنى بولسۇن. ھەركىم شۇ كۈنىدە ئىش-ئەمگەك قىلسا ئۆلۈمگە مەھكۇم قىلىنسۇن.
002	EXO	035	003	شابات كۈنىدە بارلىق تۇرالغۇلىرىڭلاردا ھەرگىز ئوت قالىماڭلار، ــ دېدى.
002	EXO	035	004	مۇسا ئىسرائىللارنىڭ پۈتكۈل جامائىتىگە سۆز قىلىپ مۇنداق دېدى: ــ «پەرۋەردىگار بۇيرۇغان ئەمر مانا شۇكى: ــ
002	EXO	035	005	ئۆزۈڭلارنىڭ ئاراڭلاردىن پەرۋەردىگارغا بىر «كۆتۈرمە ھەدىيە» كەلتۈرۈڭلار؛ كۆڭلى خالىغانلارنىڭ ھەربىرى پەرۋەردىگارغا بىر «كۆتۈرمە ھەدىيە»سىنى كەلتۈرسۇن: يەنى ئالتۇن، كۈمۈش، مىس،
002	EXO	035	006	كۆك، سۆسۈن ۋە قىزىل يىپ، ئاق كاناپ رەخت، ئۆچكە تىۋىتى،
002	EXO	035	007	قىزىل بويالغان قوچقار تېرىسى، دېلفىن تېرىسى، ئاكاتسىيە ياغىچى،
002	EXO	035	008	چىراغدان ئۈچۈن زەيتۇن مېيى، «مەسىھلەش مېيى» بىلەن خۇشبۇي ئۈچۈن ئىشلىتىلىدىغان ئېسىل دورا-دەرمەكلەر،
002	EXO	035	009	ئەفودقا ھەم قوشېنغا ئورنىتىلىدىغان ھېقىق ۋە باشقا ياقۇتلارنى كەلتۈرۈڭلار».
002	EXO	035	010	ــ «ئاراڭلاردىكى بارلىق ماھىر ئۇستىلار كېلىپ پەرۋەردىگار بۇيرۇغاننىڭ ھەممىسىنى ياساپ بەرسۇن:
002	EXO	035	011	ــ [مۇقەددەس] چېدىر بىلەن ئۇنىڭ ئىچكى ۋە تاشقى يوپۇقلىرىنى، ئىلغۇلىرىنى، تاختايلىرىنى، بالداقلىرىنى، خادىلىرىنى ۋە بۇلارنىڭ تەگلىكلىرىنى،
002	EXO	035	012	ئەھدە ساندۇقى ۋە ئۇنىڭ بالداقلىرىنى، «كەفارەت تەختى»نى، «ئايرىما پەردە-يوپۇق»نى،
002	EXO	035	013	شىرە ۋە ئۇنىڭ بالداقلىرىنى، ئۇنىڭ بارلىق قاچا-قۇچىلىرىنى ۋە «تەقدىم نانلىرى»نى،
002	EXO	035	014	يورۇقلۇق ئۈچۈن ياسالغان چىراغدان ۋە ئۇنىڭ ئەسۋابلىرىنى، ئۇنىڭ چىراغلىرى ۋە چىراغ مېيىنى،
002	EXO	035	015	خۇشبۇيگاھ ۋە ئۇنىڭ بالداقلىرىنى، «مەسىھلەش مېيى»نى، دورا-دەرمەكلەردىن ئىشلەنگەن خۇشبۇينى، مۇقەددەس چېدىرىنىڭ كىرىش ئېغىزىدىكى «ئىشىك پەردىسى»نى،
002	EXO	035	016	كۆيدۈرمە قۇربانلىق قۇربانگاھى ۋە ئۇنىڭ مىس شالاسىنى، بالداقلىرىنى ۋە بارلىق ئەسۋابلىرىنى، يۇيۇنۇش دېسى ۋە ئۇنىڭ تەگلىكىنى،
002	EXO	035	017	ھويلىنىڭ پەردىلىرىنى، ئۇنىڭ خادىلىرى ۋە ئۇلارنىڭ تەگلىكلىرىنى، ھويلىنىڭ كىرىش ئېغىزىدىكى پەردىنى،
002	EXO	035	018	چېدىرنىڭ مىخ-قوزۇقلىرىنى، ھويلىنىڭ مىخ-قوزۇقلىرىنى، شۇنداقلا بارلىق تانىلىرىنى،
002	EXO	035	019	توقۇلىدىغان كىيىملەر، يەنى مۇقەددەس جاينىڭ خىزمىتىگە كاھىنلىق خىزمىتىدە كىيىلىدىغان، ھارۇن كاھىننىڭ مۇقەددەس كىيىملىرىنى ھەم ئۇنىڭ ئوغۇللىرىنىڭ كىيىملىرىنى تەييار قىلسۇن».
002	EXO	035	020	شۇنىڭ بىلەن پۈتكۈل ئىسرائىل جامائىتى مۇسانىڭ يېنىدىن چىقىپ كېتىشتى.
002	EXO	035	021	ئاندىن كۆڭلى تارتقانلارنىڭ ھەربىرى، روھى ئۆزلىرىگە تۈرتكە بولغانلارنىڭ ھەربىرى كېلىپ، جامائەت چېدىرىنى ياساشقا، شۇنداقلا چېدىرنىڭ خىزمىتىدە ئىشلىتىلىدىغان بارلىق سەرەمجانلارنى ياساشقا ۋە مۇقەددەس كىيىملەرنى تىكىشكە پەرۋەردىگارغا ئاتالغان «پۇلاڭلاتما ھەدىيە»نى كەلتۈرگىلى تۇردى.
002	EXO	035	022	ئۇلار ئەرلەرمۇ، ئاياللارمۇ كېلىپ، سۇنۇشقا كۆڭلى خۇش بولغانلارنىڭ ھەربىرى ھەدىيە كەلتۈرۈپ، بۇلاپكا، زىرە-ھالقا، ئۈزۈك، زۇننار-بىلەزۈك قاتارلىق ھەرخىل ئالتۇن بۇيۇملارنى ئېلىپ كەلدى؛ ئالتۇننى «كۆتۈرمە ھەدىيە» قىلىپ بېرەي دېگەنلەرنىڭ ھەربىرى ئۇنى پەرۋەردىگارغا سۇندى.
002	EXO	035	023	كىمدە كۆك، سۆسۈن، قىزىل يىپ بىلەن ئاق كاناپ رەخت، ئۆچكە تىۋىتى، قىزىل بويالغان قوچقار تېرىسى ۋە دېلفىن تېرىسى بولسا، شۇلارنى ئېلىپ كېلىشتى.
002	EXO	035	024	كۈمۈش يا مىستىن كۆتۈرمە ھەدىيە كەلتۈرەي دېگەنلەرنىڭ ھەربىرى شۇنى پەرۋەردىگارغا ھەدىيە قىلىپ سۇندى. كىمدە چېدىرنىڭ خىزمىتىدە ئىشلىتىلىدىغان ھەرخىل سەرەمجانلارغا يارىغۇدەك ئاكاتسىيە ياغىچى بولسا، ئۇنى ئېلىپ كەلدى.
002	EXO	035	025	قولى چېۋەر ئاياللارنىڭ ھەربىرى ئۆز قوللىرى بىلەن ئېگىرىپ، شۇ ئېگىرگەن يىپ ۋە رەختلەرنى، يەنى كۆك، سۆسۈن ۋە قىزىل يىپ بىلەن ئاق كاناپ رەختلەرنى كەلتۈردى،
002	EXO	035	026	شۇنىڭدەك كۆڭلى قوزغالغان ئاياللارنىڭ ھەممىسى ھۈنىرىنى ئىشلىتىپ ئۆچكە تىۋىتىدىن يىپ ئېگىرىشتى.
002	EXO	035	027	ئەمىرلەر ئەفود ۋە قوشېنغا ئورنىتىلىدىغان ھېقىقلار ۋە ياقۇتلارنى،
002	EXO	035	028	دورا-دەرمەكلەرنى، چىراغقا ۋە مەسىھلەش مېيىغا ئىشلىتىلىدىغان زەيتۇن مېيىنى، خۇشبۇيغا ئىشلىتىلىدىغان ئېسىل دورا-دەرمەكلەرنى كەلتۈردى.
002	EXO	035	029	شۇ تەرىقىدە ئىسرائىللار پەرۋەردىگار مۇسانىڭ ۋاسىتىسى بىلەن بۇيرۇغان ئىشلارنىڭ ھەرقايسىغا بىر نەرسە بېرىشكە كۆڭلى تارتقان بولسا، ئەر بولسۇن ئايال بولسۇن ھەربىرى شۇنى ئېلىپ كېلىپ، پەرۋەردىگارغا ئاتاپ ئىختىيارىي ھەدىيە بەردى.
002	EXO	035	030	ئاندىن مۇسا ئىسرائىللارغا مۇنداق دېدى: ــ «مانا، پەرۋەردىگار يەھۇدا قەبىلىسىدىن خۇرنىڭ نەۋرىسى، ئۇرىنىڭ ئوغلى بەزالەلنى ئىسمىنى ئاتاپ چاقىرىپ،
002	EXO	035	031	ئۇنى خۇدانىڭ روھى بىلەن تولدۇرۇپ، ئۇنىڭغا دانالىق، ئەقىل-پاراسەت، ئىلىم-ھېكمەت ئىگىلىتىپ، ئۇنى ھەرتۈرلۈك ئىشنى قىلىشقا قابىلىيەتلىك قىلىپ،
002	EXO	035	032	ئۇنى تۈرلۈك-تۈرلۈك ھۈنەرلەرنى قىلالايدىغان ــ ئالتۇن، كۈمۈش ۋە مىس ئىشلىرىنى قىلالايدىغان،
002	EXO	035	033	ياقۇتلارنى كېسىپ-ئويالايدىغان، زىننەت بۇيۇملىرىغا ئورنىتالايدىغان، ياغاچلارغا نەقىش چىقىرالايدىغان، ھەرخىل ھۈنەر ئىشلىرىنى قاملاشتۇرالايدىغان قىلدى.
002	EXO	035	034	ئۇ يەنە ئۇنىڭ كۆڭلىگە، شۇنىڭدەك ھەم دان قەبىلىسىدىن بولغان ئاھىساماقنىڭ ئوغلى ئوھولىيابنىڭ كۆڭلىگە [باشقىلارغا] ھۈنەر ئۆگىتىش نىيەت-ئىستىكىنى سېلىپ،
002	EXO	035	035	ئۇلارنىڭ كۆڭۈللىرىنى دانالىق-ھېكمەت بىلەن تولدۇرۇپ، ئۇلارنى ھەرخىل نەققاشلىق-ئويمىچىلىق ئىشلىرىغا ماھىر قىلىپ، كۆك، سۆسۈن ۋە قىزىل يىپ بىلەن ئاق كاناپ رەخت بىلەن كەشتىچىلىك قىلىشقا ھەمدە باپكارلىققا ئىقتىدارلىق قىلدى. شۇنىڭ بىلەن ئۇلار ھەرخىل ھۈنەر ئىشلىرىنىڭ ۋە ھەرخىل لايىھىلەش ئىشلىرىنىڭ ھۆددىسىدىن چىقالايدىغان بولدى.
002	EXO	036	001	شۇنىڭ بىلەن بەزالەل ۋە ئوھولىيابلار، شۇنىڭدەك پەرۋەردىگار مۇقەددەس چېدىر ياساشنىڭ ھەرخىل ئىشلىرىغا كېرەك بولغان دانالىق-ھېكمەت ۋە ئەقىل-پاراسەتنى ئاتا قىلغان ماھىر ئۇستىلارنىڭ ھەربىرى ئۇلارغا قوشۇلۇپ، شۇ ئىشنى ئۇنىڭ ئەمر قىلغىنى بويىچە ئەمەلگە ئاشۇرىدۇ».
002	EXO	036	002	شۇ ۋاقىتتا مۇسا بەزالەل ۋە ئوھولىيابنى، شۇنداقلا پەرۋەردىگار دانالىق-ھېكمەت بىلەن كۆڭۈللىرىنى تولدۇرغان، كۆڭلى ئۆزىنى شۇ ئىشنى قىلىشقا قاتنىشىشقا دالالەت قىلغان بارلىق ھۈنەرۋەن-كاسىپلارنى چاقىرىپ يىغدى.
002	EXO	036	003	ئۇلار كېلىپ مۇقەددەس چېدىرنى ياساشقا، شۇنداقلا ئۇنىڭ ئىش-خىزمەتلىرىگە كېرەكلىك سەرەمجانلارنى ياساشقا ئىسرائىللار ئېلىپ كەلتۈرگەن بارلىق «كۆتۈرمە ھەدىيە»لەرنى مۇسادىن تاپشۇرۇۋالدى. ئىسرائىل خەلقى يەنىلا ئۆز مەيلى بىلەن ھەر كۈنى ئەتىگىنى مۇساغا ئىختىيارىي ھەدىيە كەلتۈرۈپ تۇراتتى.
002	EXO	036	004	ئاندىن مۇقەددەس چېدىرنىڭ ئىشلىرىنى قىلىۋاتقان ئۇستىلارنىڭ ھەممىسى قولىدىكى ئىشىنى قويۇپ قويۇپ كېلىپ،
002	EXO	036	005	مۇساغا: ــ خەلقنىڭ ئېلىپ كەلگىنى پەرۋەردىگار بىزگە قىلىشقا بۇيرۇغان ئىشنى پۈتكۈزۈشكە ئېھتىياج بولغىنىدىن كۆپ ئېشىپ كەتتى! ــ دېيىشتى.
002	EXO	036	006	ئاندىن مۇسا ئەمر قىلىپ، پۈتكۈل چېدىرگاھ بويىچە: «مانا، ئەر بولسۇن، ئايال بولسۇن، ھېچكىم مۇقەددەس چېدىرنى ياساش ئۈچۈن «كۆتۈرمە ھەدىيە» سۈپىتىدە يەنە ھېچقانداق نەرسە تەييارلاپ كەلمىسۇن!» دەپ جاكارلاتتى. بۇنىڭ بىلەن كۆپچىلىك ھەدىيەلەر كەلتۈرۈشتىن توختىتىلدى.
002	EXO	036	007	چۈنكى ئۇلار تەييارلىغان ماتېرىياللار پۈتكۈل قۇرۇلۇش ئىشىغا يېتەتتى، ھەتتا ئېشىپ قالاتتى.
002	EXO	036	008	مۇقەددەس چېدىرنىڭ قۇرۇلۇش ئىشىنى قىلىۋاتقان ئۇستىلارنىڭ ھەربىرى نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ ئىشلەنگەن ئون پارچە يوپۇق ياساپ، كېرۇبلارنىڭ سۈرىتىنى يوپۇقلارغا چېۋەرلىك بىلەن لايىھىلەپ نەپىس قىلىپ كەشتىلەپ چىقتى.
002	EXO	036	009	ھەربىر يوپۇقنىڭ ئۇزۇنلۇقى يىگىرمە سەككىز گەز، كەڭلىكى تۆت گەز بولۇپ، ھەربىر يوپۇق ئوخشاش چوڭ-كىچىكلىكتە قىلىندى.
002	EXO	036	010	[بەزالەل] يوپۇقلارنىڭ بەشىنى بىر-بىرىگە ئۇلىدى، قالغان بەش يوپۇقنىمۇ ھەم بىر-بىرىگە ئۇلىدى.
002	EXO	036	011	ئۇ ئۇلاپ چىقىلغان بىرىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىنىڭ بىر تەرىپىگە رەڭگى كۆك ئىزمىلەرنى قادىدى، شۇنىڭدەك ئۇلاپ چىقىلغان ئىككىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكىسىنىڭ بىر تەرىپىگىمۇ شۇنداق قىلدى.
002	EXO	036	012	بىرىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا ئەللىك ئىزمە قادىدى، ئىككىنچى چوڭ پارچىنىڭ ئەڭ چېتىدىكىسىگىمۇ ئەللىك ئىزمە قادىدى. ئىزمىلەر بىر-بىرىگە ئۇدۇلمۇئۇدۇل قىلىندى.
002	EXO	036	013	مۇقەددەس چېدىر بىر پۈتۈن بولسۇن ئۈچۈن ئۇ ئالتۇندىن ئەللىك ئىلغۇ ياساپ، ئىككى پارچە يوپۇقنى شۇ ئىلغۇلار بىلەن بىر-بىرىگە تۇتاشتۇردى.
002	EXO	036	014	ئۇ مۇقەددەس چېدىرنى يېپىش ئۈچۈن ئۆچكە تىۋىتىدىن يوپۇقلارنى ياسىدى؛ يوپۇقتىن ئون بىر پارچە ياسىدى.
002	EXO	036	015	يوپۇقلارنىڭ ھەربىرىنىڭ ئۇزۇنلۇقى ئوتتۇز گەز، كەڭلىكى تۆت گەز بولۇپ، ئون بىر يوپۇقنىڭ ھەممىسى ئوخشاش چوڭ-كىچىكلىكتە قىلىندى.
002	EXO	036	016	يوپۇقلارنىڭ بەشىنى ئۇ ئۇلاپ بىر قىلىپ، قالغان ئالتە يوپۇقنىمۇ ئۇلاپ بىر قىلدى.
002	EXO	036	017	ئۇ بىرىنچى ئۇلاپ چىقىلغان چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا ئەللىك ئىزمە، ئىككىنچى ئۇلاپ چىقىلغان چوڭ پارچىنىڭ ئەڭ چېتىدىكى قىسمىغا ئەللىك ئىزمە قادىدى.
002	EXO	036	018	ئۇ چېدىر بىر پۈتۈن بولسۇن ئۈچۈن ھەم مىستىن ئەللىك ئىلغۇ ياساپ، ئىككى چوڭ پارچىنى ئۇلاپ قويدى.
002	EXO	036	019	ئۇ بۇنىڭدىن باشقا چېدىرغا قىزىل بويالغان قوچقار تېرىسىدىن يوپۇق ياساپ ياپتى، ئاندىن ئۇنىڭ ئۈستىدىنمۇ دېلفىن تېرىسىدىن ياسالغان يەنە بىر يوپۇقنى قاپلىدى.
002	EXO	036	020	ئۇ مۇقەددەس چېدىرنىڭ تىك تاختايلىرىنى ئاكاتسىيە ياغىچىدىن ياساپ تىكلىدى.
002	EXO	036	021	ھەربىر تاختاينىڭ ئۇزۇنلۇقى ئون گەز، كەڭلىكى بىر يېرىم گەز قىلىندى.
002	EXO	036	022	ھەربىر تاختاينىڭ ئىككىدىن تۇرۇمى بار ئىدى، ھەر ئىككى تاختاي شۇلار بىلەن بىر-بىرىگە چېتىلدى؛ ئۇ چېدىرنىڭ بارلىق تاختايلىرىنى شۇنداق ياسىدى.
002	EXO	036	023	ئۇ چېدىرنىڭ تاختايلىرىنى شۇنداق ياسىدى؛ يىگىرمىسى جەنۇب تەرەپكە ئورنىتىلدى؛
002	EXO	036	024	ئۇ بۇ يىگىرمە تاختاينىڭ تېگىگە كۈمۈشتىن قىرىق تەگلىك ياسىدى؛ بىر تاختاينىڭ [ئاستىدىكى] ئىككى تۇرۇمى ئۈچۈن ئىككىدىن تەگلىك، يەنە بىر تاختاينىڭ ئىككى تۇرۇمى ئۈچۈن ئىككىدىن تەگلىكنى ياسىدى.
002	EXO	036	025	شۇنىڭدەك ئۇ چېدىرنىڭ ئۇدۇل تەرىپىگە، يەنى شىمال تەرىپىگە يىگىرمە تاختاي ياسىدى،
002	EXO	036	026	شۇنداقلا بۇلارنىڭ قىرىق تەگلىكىنى كۈمۈشتىن ياسىدى؛ بىر تاختاينىڭ تېگىگە ئىككىدىن تەگلىك، يەنە بىر تاختاينىڭ تېگىگە ئىككىدىن تەگلىك ئورۇنلاشتۇرۇلدى.
002	EXO	036	027	چېدىرنىڭ كەينى تەرىپىگە، يەنى غەرب تەرەپكە ئالتە تاختاينى ياساپ ئورناتتى.
002	EXO	036	028	ئۇ چېدىرنىڭ كەينى تەرىپىدىكى ئىككى بۇلۇڭغا ئىككى تاختاينى ياساپ ئورناتتى.
002	EXO	036	029	بۇ بۇلۇڭ تاختايلىرى ئاستىدىن ئۈستىگىچە ئىككى قات قىلىپ [تاختايلارنى] ئۆزئارا چېتىشتۇردى، ئۈستى بىر ھالقىغا بېكىتىلدى. ئۇ ھەر ئىككىسىنى شۇنداق ياساپ، ئىككى بۇلۇڭغا ئورناتتى.
002	EXO	036	030	شۇڭلاشقىمۇ ئۇ تەرىپىدە سەككىز تاختاي بولدى، ئۇلارنىڭ كۈمۈشتىن ياسالغان ئون ئالتە تەگلىكى بار ئىدى؛ بىر تاختاينىڭ تېگىدە ئىككى تەگلىك، يەنە بىر تاختاينىڭ تېگىدە ئىككى تەگلىك بار ئىدى.
002	EXO	036	031	بۇنىڭدىن باشقا ئۇ ئاكاتسىيە ياغىچىدىن بالداق ياسىدى؛ چېدىرنىڭ بۇ تەرىپىدىكى تاختايلارغا بەش بالداقنى،
002	EXO	036	032	چېدىرنىڭ ئۇ تەرىپىدىكى تاختايلارغا بەش بالداقنى، چېدىرنىڭ ئارقا تەرىپىدىكى تاختايلارغا، يەنى غەرب تەرىپىدىكى تاختايلارغىمۇ بەش بالداقنى ياسىدى.
002	EXO	036	033	ئۇ تاختايلارنىڭ ئوتتۇرىدىكى ئوتتۇرا بالداقنى بۇ تەرەپتىن ئۇ تەرەپكە يەتكۈزۈپ ياسىدى.
002	EXO	036	034	ئۇ تاختايلارنى ئالتۇن بىلەن قاپلاپ، بالداقلار ئۆتكۈزۈلىدىغان ھالقىلارنى ئالتۇندىن ياساپ، بالداقلارنى ئالتۇن بىلەن قاپلىدى.
002	EXO	036	035	ئۇ نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ ئىشلەنگەن بىر پەردە ياسىدى؛ ئۇنى كېرۇبلارنىڭ سۈرىتىنى چېۋەرلىك بىلەن لايىھىلەپ نەپىس قىلىپ چۈشۈرۈپ، كەشتىلەپ چىقاردى.
002	EXO	036	036	ئۇنى ئېسىشقا ئۇ ئاكاتسىيە ياغىچىدىن تۆت خادا ياساپ، ئالتۇن بىلەن قاپلىدى. ئۇلارنىڭ ئىلمەكلىرى ئالتۇندىن ياسالدى؛ خادىلارغا ئۇ كۈمۈشتىن تۆت تەگلىكنى قۇيۇپ ياسىدى.
002	EXO	036	037	ئۇ چېدىرنىڭ كىرىش ئېغىزىغا نەپىس توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ ئىشلەنگەن بىر پەردە ياسىدى، ئۇنى كەشتىچىگە كەشتىلەتتى.
002	EXO	036	038	ئۇ يەنە بۇ پەردىنىڭ بەش خادىسىنى ئىلمەكلىرى بىلەن قوشۇپ ياسىدى؛ ئۇلارنىڭ باشلىرىنى ۋە بالداقلىرىنى ئالتۇن بىلەن قاپلىدى؛ ئۇلارنىڭ بەش تەگلىكى مىستىن ياسالدى.
002	EXO	037	001	ئاندىن بەزالەل ئەھدە ساندۇقىنى ئاكاتسىيە ياغىچىدىن ياسىدى؛ ئۇنىڭ ئۇزۇنلۇقى ئىككى يېرىم گەز، ئېگىزلىكى بىر يېرىم گەز، كەڭلىكى بىر يېرىم گەز ئىدى.
002	EXO	037	002	ئۇ ئۇنىڭ ئىچى ۋە سىرتىنى ساپ ئالتۇن بىلەن قاپلىدى، ئۇنىڭ ئۈستۈنكى قىسمىنىڭ چۆرىسىگە ئالتۇندىن گىرۋەك چىقاردى.
002	EXO	037	003	ئۇ ئۇنىڭ ئۈچۈن ئالتۇندىن تۆت ھالقا قۇيۇپ، ئۇلارنى ئۇنىڭ تۆت چېتىقىغا بېكىتتى؛ بىر تەرىپىگە ئىككى ھالقا، يەنە بىر تەرىپىگە ئىككى ھالقا بېكىتتى.
002	EXO	037	004	ئۇ ھەم ئاكاتسىيە ياغىچىدىن ئىككى بالداق ياساپ، ھەر ئىككىسىنى ئالتۇن بىلەن قاپلىدى؛
002	EXO	037	005	ئاندىن ساندۇق ئۇلار ئارقىلىق كۆتۈرۈلسۇن دەپ، بالداقلارنى ساندۇقنىڭ ئىككى يېنىدىكى ھالقىلىرىدىن ئۆتكۈزۈپ قويدى.
002	EXO	037	006	ئۇ [ساندۇقنىڭ ياپقۇچى سۈپىتىدە] ئالتۇندىن ئۇزۇنلۇقى ئىككى يېرىم گەز، كەڭلىكى بىر يېرىم گەز بولغان بىر «كەفارەت تەختى» ياسىدى.
002	EXO	037	007	ئۇ ئىككى كېرۇبنى ئالتۇندىن سوقۇپ ياسىدى؛ ئۇلارنى كەفارەت تەختىنىڭ ئىككى تەرىپىگە ئورناتتى؛
002	EXO	037	008	بىر كېرۇبنى بىر تەرىپىگە، يەنە بىر كېرۇبنى يەنە بىر تەرىپىگە ئورناتتى. ئۇ ئىككى تەرىپىدىكى كېرۇبلارنى كەفارەت تەختى بىلەن بىر گەۋدە قىلدى.
002	EXO	037	009	كېرۇبلار بىر-بىرىگە يۈزلىنىپ، قاناتلىرىنى كەفارەت تەختىنىڭ ئۈستىگە كېرىپ، قاناتلىرى بىلەن ئۇنى يېپىپ تۇراتتى؛ كېرۇبلارنىڭ يۈزى كەفارەت تەختىگە قارىتىلدى.
002	EXO	037	010	ئۇ ھەم شىرەنى ئاكاتسىيە ياغىچىدىن ياسىدى؛ ئۇنىڭ ئۇزۇنلۇقى ئىككى گەز، كەڭلىكى بىر گەز، ئېگىزلىكى بىر يېرىم گەز ئىدى.
002	EXO	037	011	ئۇ ئۇنى ساپ ئالتۇن بىلەن قاپلاپ، ئۇنىڭ ئۈستۈنكى قىسمىنىڭ چۆرىسىگە ئالتۇندىن گىرۋەك چىقاردى.
002	EXO	037	012	ئۇ شىرەنىڭ چۆرىسىگە تۆت ئىلىك ئېگىزلىكتە بىر لەۋ ياسىدى؛ بۇ لەۋنىڭ چۆرىسىگىمۇ ئالتۇندىن بىر گىرۋەك چىقاردى.
002	EXO	037	013	ئۇ شىرەگە ئالتۇندىن تۆت ھالقا ياساپ، بۇ ھالقىلارنى شىرەنىڭ تۆت بۇرجىكىدىكى چېتىققا ئورناتتى.
002	EXO	037	014	شىرەنى كۆتۈرۈشكە بالداقلار ئۆتكۈزۈلسۇن دەپ، ھالقىلار شىرە لېۋىگە يېقىن بېكىتىلدى.
002	EXO	037	015	شىرە ئۈچۈن ئۇ بالداقلارنى ئاكاتسىيە ياغىچىدىن ياساپ، ئالتۇن بىلەن قاپلىدى؛ شىرە ئۇلار بىلەن كۆتۈرۈلەتتى.
002	EXO	037	016	ئۇ شىرەنىڭ ئۈستىگە قويۇلىدىغان بارلىق بۇيۇملارنى، يەنى لېگەنلىرىنى، قاچا-قۇچا تەخسىلىرىنى، [شاراب ھەدىيەلىرىنى] قۇيىدىغان قەدەھ ۋە پىيالىلەرنىڭ ھەممىسىنى ساپ ئالتۇندىن ياسىدى.
002	EXO	037	017	ئۇ ھەم چىراغداننى ساپ ئالتۇندىن ياسىدى؛ چىراغداننى سوقۇپ ياسىدى؛ چىراغداننىڭ پۇتى، غولى، قەدەھلىرى، غۇنچىلىرى ۋە گۈللىرى بىر پۈتۈن ئالتۇندىن سوقۇلدى.
002	EXO	037	018	چىراغداننىڭ غولىنىڭ ئىككى يېنىدىن ئالتە شاخچە چىقىرىلدى ــ چىراغداننىڭ بىر يېنىدىن ئۈچ شاخچە، ئۇنىڭ يەنە بىر يېنىدىن ئۈچ شاخچە چىقىرىلدى؛
002	EXO	037	019	بىر يېنىدىكى ھەربىر شاخچىدە بادام گۈلى شەكلىدە غۇنچىسى ۋە چېچىكى بولغان ئۈچ قەدەھ چىقىرىلدى، يەنە بىر يېنىدىكى ھەربىر شاخچىدە بادام گۈلى شەكلىدە غۇنچىسى ۋە چېچىكى بولغان ئۈچ قەدەھ چىقىرىلدى. چىراغدانغا چىقىرىلغان ئالتە شاخچىنىڭ ھەممىسى شۇنداق ياسالدى.
002	EXO	037	020	چىراغداننىڭ [غولىدىن] بادام گۈلى شەكلىدە غۇنچىسى ۋە چېچىكى بولغان تۆت قەدەھ چىقىرىلدى.
002	EXO	037	021	بۇلاردىن باشقا [بىرىنچى] ئىككى شاخچىنىڭ ئاستىدا بىر غۇنچە، [ئىككىنچى] ئىككى شاخچىنىڭ ئاستىدا بىر غۇنچە، [ئۈچىنچى] ئىككى شاخچىنىڭ ئاستىدا بىر غۇنچە ياسالغانىدى؛ چىراغدانغا چىقىرىلغان ئالتە شاخچىنىڭ ئاستىنىڭ ھەممىسى شۇنداق ئىدى.
002	EXO	037	022	ئۇنىڭ شۇ غۇنچىلىرى ھەم شاخچىلىرى چىراغدان بىلەن بىر گەۋدە قىلىندى ــ بىر پۈتۈن ساپ ئالتۇندىن سوقۇپ ياسالدى.
002	EXO	037	023	ئۇ چىراغداننىڭ يەتتە چىرىغىنى، شۇنداقلا ئۇنىڭ پىلىك قايچىلىرى بىلەن كۈلدانلىرىنى ساپ ئالتۇندىن ياسىدى.
002	EXO	037	024	ئۇ چىراغدان ۋە ئۇنىڭ بارلىق ئەسۋابلىرىنى بىر تالانت ساپ ئالتۇندىن ياسىدى.
002	EXO	037	025	ئۇ يەنە خۇشبۇيگاھنى ئاكاتسىيە ياغىچىدىن ياسىدى. ئۇنىڭ ئۇزۇنلۇقى بىر گەز، كەڭلىكى بىر گەز، ئېگىزلىكى ئىككى گەز بولۇپ، تۆت چاسا قىلىپ ياسالدى؛ [تۆت بۇرجىكىدىكى] مۈڭگۈزلەر ئۇنىڭ بىلەن بىر پۈتۈن قىلىپ ياسالدى.
002	EXO	037	026	ئۇ ئۇنى، يەنى ئۇنىڭ ئۈستىنى، تۆت ئەتراپىنى ھەم مۈڭگۈزلىرىنى ساپ ئالتۇن بىلەن قاپلىدى؛ ئۇنىڭ ئۈستى قىسمىنىڭ چۆرىسىگە ئالتۇندىن گىرۋەك چىقاردى.
002	EXO	037	027	ئۇنىڭغا ئالتۇندىن ئىككى ھالقا ياساپ، ئۇنىڭ گىرۋىكىنىڭ ئاستىغا بېكىتتى؛ ئۇلارنى ئىككى يېنىغا ئۇدۇلمۇئۇدۇل بېكىتتى. خۇشبۇيگاھنى كۆتۈرىدىغان ئىككى بالداقنى سېلىش ئۈچۈن بۇلارنى خۇشبۇيگاھنىڭ ئىككى تەرىپىگە ئورۇنلاشتۇردى.
002	EXO	037	028	ئۇ بالداقلارنى ئاكاتسىيە ياغىچىدىن ياساپ، ئالتۇن بىلەن قاپلىدى.
002	EXO	037	029	ئۇ ھەم مۇقەددەس مەسىھلەش مېيىنى ياسىدى، ئاندىن ئەتىرچى چىقارغاندەك دورا-دەرمەكلەرنى تەڭشەپ ساپ خۇشبۇينى ياسىدى.
002	EXO	038	001	ئۇ كۆيدۈرمە قۇربانلىق قۇربانگاھىنى ئاكاتسىيە ياغىچىدىن ياسىدى. قۇربانگاھ تۆت چاسا بولۇپ، ئۇزۇنلۇقى بەش گەز، كەڭلىكى بەش گەز، ئېگىزلىكى ئۈچ گەز قىلىندى.
002	EXO	038	002	ئۇ ئۇنىڭ تۆت بۇرجىكىگە قويۇلىدىغان مۈڭگۈزلىرىنى ياسىدى؛ مۈڭگۈزلىرى قۇربانگاھ بىلەن بىر گەۋدە قىلىندى. قۇربانگاھنى مىس بىلەن قاپلىدى.
002	EXO	038	003	ئۇ قۇربانگاھنىڭ بارلىق ئەسۋابلىرىنى ــ ئۇنىڭغا خاس بولغان داسلارنى، گۈرجەكلەرنى، كورىلارنى، لاخشىگىرلارنى ۋە ئوتدانلارنىمۇ ياسىدى؛ ئۇنىڭ بارلىق ئەسۋابلىرىنى مىستىن ياسىدى.
002	EXO	038	004	قۇربانگاھ ئۈچۈن مىستىن بىر شالا ياسىدى؛ شالانى قۇربانگاھنىڭ قاپ بېلىنىڭ ئاستىدىكى گىرۋەكتىن تۆۋەنرەك تۇرىدىغان قىلدى؛ شالا قۇربانگاھنىڭ دەل ئوتتۇرىسىدا ئىدى.
002	EXO	038	005	ئۇ شالانىڭ تۆت بۇرجىكىگە بالداقلار ئۆتكۈزۈلىدىغان تۆت مىس ھالقىنى قۇيۇپ ياسىدى.
002	EXO	038	006	ئۇ بالداقلارنى ئاكاتسىيە ياغىچىدىن ياساپ، ئۇلارنى مىس بىلەن قاپلىدى.
002	EXO	038	007	ئاندىن ئۇ قۇربانگاھنى كۆتۈرۈش ئۈچۈن بالداقلارنى قۇربانگاھنىڭ ئىككى يېنىدىكى ھالقىلارغا ئۆتكۈزۈپ قويدى. ئۇ قۇربانگاھنى تاختايلاردىن، ئىچىنى بوش قىلىپ ياسىدى.
002	EXO	038	008	ئۇ يەنە يۇيۇنۇش دېسىنى مىستىن، ئۇنىڭ تەگلىكىنىمۇ مىستىن ياسىدى؛ ئۇ بۇلارنى «كۆرۈشۈش چېدىرى»نىڭ كىرىش ئېغىزىنىڭ ئالدىدا خىزمەتتە بولغان ئاياللارنىڭ مىس ئەينەكلىرىدىن ياسىدى.
002	EXO	038	009	ئاندىن ئۇ چېدىرنىڭ ھويلىسىنىمۇ ياسىدى. ھويلىنىڭ جەنۇبىغا، يەنى جەنۇبقا يۈزلەنگەن تەرىپىگە نېپىز توقۇلغان ئاق كاناپ رەختتىن پەردىلەرنى ياسىدى؛ ئۇنىڭ ئۇزۇنلۇقى يۈز گەز ئىدى.
002	EXO	038	010	پەردىلەرنى ئېسىشقا يىگىرمە خادا ۋە خادىلارنىڭ يىگىرمە تەگلىكىنى ئۇ مىستىن ياسىدى. خادىلارنىڭ ئىلمەكلىرى ۋە بالداقلىرى كۈمۈشتىن ياسالغانىدى.
002	EXO	038	011	شۇنىڭغا ئوخشاش شىمال تەرىپىدىمۇ ئۇزۇنلۇقى يۈز گەز كېلىدىغان پەردە بار ئىدى. پەردىلەرنى ئېسىشقا يىگىرمە خادا ۋە خادىلارنىڭ يىگىرمە تەگلىكىنى ئۇ مىستىن ياسىدى. خادىلارنىڭ ئىلمەكلىرى ۋە بالداقلىرى كۈمۈشتىن ياسالغانىدى.
002	EXO	038	012	شۇنىڭغا ئوخشاش غەرب تەرىپىدە ئۇزۇنلۇقى ئەللىك گەز كېلىدىغان پەردە بار ئىدى؛ پەردىلەرنى ئېسىشقا ئون خادا ۋە خادىلارنىڭ ئون تەگلىكىنى ئۇ مىستىن ياسىدى. خادىلارنىڭ ئىلمەكلىرى ۋە بالداقلىرى كۈمۈشتىن ياسالدى.
002	EXO	038	013	ھويلىنىڭ شەرق تەرىپى، يەنى كۈن چىقىشقا يۈزلەنگەن تەرىپىنىڭ كەڭلىكى ئەللىك گەز ئىدى.
002	EXO	038	014	بىر تەرىپىدە ئون بەش گەز كېلىدىغان پەردە بولۇپ، ئۇنىڭ ئۈچ خادىسى بىلەن ئۈچ تەگلىكى بار ئىدى.
002	EXO	038	015	يەنە بىر تەرىپىدىمۇ ئون بەش گەز كېلىدىغان پەردە بولۇپ، ئۇنىڭ ئۈچ خادىسى بىلەن ئۈچ تەگلىكى بار ئىدى.
002	EXO	038	016	ھويلىنىڭ چۆرىسىدىكى پەردىلەرنىڭ ھەممىسى نېپىز توقۇلغان ئاق كاناپ رەختتىن تىكىلگەنىدى.
002	EXO	038	017	ھويلىنىڭ چۆرىسىدىكى ھەممە خادىلارنىڭ تەگلىكى مىستىن، ئۇلارنىڭ ئىلمەكلىرى ۋە بالداقلىرى كۈمۈشتىن ياسالدى؛ خادىلارنىڭ باشلىرىمۇ كۈمۈشتىن قاپلانغانىدى. ھويلىنىڭ چۆرىسىدىكى ھەممە خادىلار كۈمۈشتىن ياسالغان بالداقلار بىلەن بىر-بىرىگە چېتىلدى.
002	EXO	038	018	ھويلىنىڭ كىرىش ئېغىزىدىكى پەردە نېپىز توقۇلغان ئاق كاناپ رەختكە كۆك، سۆسۈن ۋە قىزىل يىپلار ئارىلاشتۇرۇلۇپ، كەشتىچىلەر تەرىپىدىن كەشتىلەندى؛ ئۇنىڭ ئۇزۇنلۇقى يىگىرمە گەز، ئېگىزلىكى ھويلىدىكى پەردىلەرنىڭ ئېگىزلىكىگە ئوخشاش بولۇپ بەش گەز ئىدى.
002	EXO	038	019	ئۇنىڭ تۆت خادىسى بىلەن مىستىن ياسالغان تۆت تەگلىكى بار ئىدى؛ خادىلارنىڭ ئىلمەكلىرى كۈمۈشتىن ياسالدى، ئۇلارنىڭ باشلىرى كۈمۈش بىلەن قاپلاندى ۋە بالداقلىرى كۈمۈشتىن ياسالدى.
002	EXO	038	020	مۇقەددەس چېدىرنىڭ ھەم چۆرىسىدىكى ھويلىنىڭ بارلىق مىق-قوزۇقلىرى مىستىن ياسالدى.
002	EXO	038	021	مۇقەددەس چېدىر، يەنى «ھۆكۈم-گۇۋاھلىقى چېدىرى» ئۈچۈن ئاتالغان ماتېرىياللارنىڭ سانى تۆۋەندە خاتىرىلەنگەن (ئۇلار مۇسانىڭ بۇيرۇقى بىلەن، كاھىن ھارۇننىڭ ئوغلى ئىتامارنىڭ قول ئاستىدىكى لاۋىيلار مەسئۇل بولۇپ ساناقتىن ئۆتكۈزۈلۈپ، [خۇداغا] ئاتالغانىدى): ــ
002	EXO	038	022	يەھۇدا قەبىلىسىدىن بولغان خۇرنىڭ نەۋرىسى، ئۇرىنىڭ ئوغلى بەزالەل پەرۋەردىگار مۇساغا بۇيرۇغاننىڭ ھەممىسىنى ئادا قىلدى؛
002	EXO	038	023	دان قەبىلىسىدىن بولغان ئاھىساماقنىڭ ئوغلى ئوھولىياب ئۇنىڭ ياردەمچىسى ئىدى؛ ئۇ بولسا نەققاشلىق-ئويمىچىلىق ئۇستىسى، لايىھىلىگۈچى ھەمدە كۆك، سۆسۈن، قىزىل يىپتىن ئاق كاناپ رەختكە كەشتە تىكەلەيدىغان ئۇستا ئىدى.
002	EXO	038	024	مۇقەددەس چېدىرنى ياساشقا ئىشلىتىلگەن ئالتۇن، يەنى «پۇلاڭلاتما ھەدىيە» سۈپىتىدە كەلتۈرۈلگەن ئالتۇننىڭ ھەممىسى مۇقەددەس جايدىكى شەكەلنىڭ ئۆلچەم بىرلىكى بويىچە يىگىرمە توققۇز تالانت يەتتە يۈز ئوتتۇز شەكەل ئىدى.
002	EXO	038	025	جامائەت ئارىسىدىن ساناقتىن ئۆتكۈزۈلگەن ئادەملەر تەرىپىدىن كەلتۈرۈلگەن كۈمۈش بولسا مۇقەددەس جايدىكى شەكەلنىڭ ئۆلچەم بىرلىكى بويىچە بىر يۈز تالانت بىر مىڭ يەتتە يۈز يەتمىش بەش شەكەل ئىدى.
002	EXO	038	026	بۇ كۈمۈش نوپۇسى رويخەتكە ئېلىنغان كىشىلەردىن ئېلىنغانىدى ــ دېمەك، كىمكى يىگىرمە ياش يا ئۇنىڭدىن چوڭ، ساناقتىن ئۆتكۈزۈلگەنلەرنىڭ ھەربىرى بىر بېكا، يەنى مۇقەددەس جايدىكى شەكەلنىڭ ئۆلچەم بىرلىكى بويىچە يېرىم شەكەل كۈمۈش بەردى. ساناقتىن ئۆتكەن كىشى ئالتە يۈز ئۈچ مىڭ بەش يۈز ئەللىك كىشى ئىدى.
002	EXO	038	027	مۇقەددەس جاينىڭ تەگلىكلىرىنى ھەم ئوتتۇرىسىدىكى پەردىنىڭ تەگلىكلىرىنى قۇيۇشقا يۈز تالانت كۈمۈش كەتتى؛ يۈز تالانت كۈمۈشتىن يۈز تەگلىك ياسىلىپ، ھەربىر تەگلىك ئۈچۈن بىر تالانت ئىشلىتىلدى.
002	EXO	038	028	ئۇ قالغان بىر مىڭ يەتتە يۈز يەتمىش بەش شەكەل كۈمۈشتىن خادىلارنىڭ ئىلمەكلىرىنى ياسىدى، ئۇلارنىڭ باشلىرىنى قاپلىدى، شۇنىڭدەك ئۇلارنى بىر-بىرىگە چاتىدىغان بالداقلارنى ياسىدى.
002	EXO	038	029	«پۇلاڭلاتما ھەدىيە» سۈپىتىدە كەلتۈرۈلگەن مىس بولسا يەتمىش تالانت، ئىككى مىڭ تۆت يۈز شەكەل چىقتى.
002	EXO	038	030	بۇنىڭدىن ئۇ جامائەت چېدىرىنىڭ كىرىش ئېغىزىنىڭ تەگلىكلىرىنى، مىس قۇربانگاھنى، ئۇنىڭ مىس شالاسى ۋە قۇربانگاھنىڭ بارلىق ئەسۋابلىرىنى،
002	EXO	038	031	ھويلىنىڭ چۆرىسىدىكى خادا تەگلىكلىرىنى، ھويلىنىڭ كىرىش ئېغىزىدىكى تەگلىكلەرنى، چېدىرنىڭ بارلىق قوزۇقلىرىنى ۋە ھويلىنىڭ چۆرىسىدىكى قوزۇقلارنىڭ ھەممىسىنى ياسىدى.
002	EXO	039	001	پەرۋەردىگار مۇساغا بۇيرۇغىنىدەك كۆك، سۆسۈن ۋە قىزىل يىپلار ئىشلىتىلىپ، مۇقەددەس چېدىرنىڭ خىزمىتىدە كىيىلىدىغان [كاھىنلىق] كىيىملەر، شۇنداقلا ھارۇننىڭ مۇقەددەس كىيىملىرى تەييار قىلىندى.
002	EXO	039	002	[بەزالەل] ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار بىلەن نېپىز توقۇلغان ئاق كاناپ رەختلەردىن ئەفودنى ياساپ تەييارلىدى.
002	EXO	039	003	ئۇلار ئالتۇننى سوقۇپ نېپىز قىلىپ، ئۇنى كېسىپ يىپ قىلدى، ئاندىن بۇلارنى ماھىرلىق بىلەن كۆك يىپلار، سۆسۈن يىپلار ۋە قىزىل يىپلاردىن ئاق كاناپ رەختكە لاھايىلەنگەن نۇسخىلار ئۈستىگە توقۇدى.
002	EXO	039	004	ئۇلار ئەفودنىڭ [ئالدى ۋە كەينى] قىسمىنى بىر-بىرگە تۇتاشتۇرۇپ تۇرىدىغان ئىككى مۈرىلىك تاسما ياسىدى؛ ئەفودنىڭ ئىككى تەرىپى بىر-بىرىگە تۇتاشتۇرۇلدى.
002	EXO	039	005	ئەفودنىڭ ئۈستىگە باغلايدىغان بەلۋاغ ئەفود بىلەن بىر پۈتۈن قىلىنغان بولۇپ، ئۇنىڭغا ئوخشاش سىپتا ئىشلىنىپ، ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار ۋە نېپىز توقۇلغان ئاق كاناپ رەختتىن ياسالدى؛ ھەممىسى پەرۋەردىگارنىڭ مۇساغا بۇيرۇغىنىدەك قىلىندى.
002	EXO	039	006	ئۇلار ئىككى ئاق ھېقىقنى ئىككى ئالتۇن كۆزلۈككە ئورنىتىپ، ئۇلارنىڭ ئۈستىگە خۇددى مۆھۈر ئويغاندەك ئىسرائىلنىڭ ئوغۇللىرىنىڭ ناملىرىنى ئويۇپ ياسىدى.
002	EXO	039	007	ئىسرائىلنىڭ ئوغۇللىرىغا ئەسلەتمە تاش بولسۇن ئۈچۈن، پەرۋەردىگار مۇساغا بۇيرۇغاندەك ئىككى ياقۇتنى ئەفودنىڭ ئىككى مۈرىلىك تاسمىسىغا بېكىتىپ قويدى.
002	EXO	039	008	ئۇ قوشېننى چېۋەر قوللارغا نەپىس قىلىپ كەشتىلىتىپ ياسىدى؛ ئۇنى ئەفودنى ئىشلىگەن ئۇسۇلدا ئالتۇن ۋە كۆك، سۆسۈن، قىزىل يىپلار بىلەن نېپىز توقۇلغان ئاق كاناپ رەختتىن ياسىدى.
002	EXO	039	009	ئۇلار قوشېننى ئىككى قات، تۆت چاسا قىلىپ ياسىدى؛ ئىككى قات قىلىنغاندا ئۇزۇنلۇقى بىر غېرىچ، كەڭلىكىمۇ بىر غېرىچ كېلەتتى.
002	EXO	039	010	ئۇنىڭ ئۈستىگە تۆت قاتار قىلىپ گۆھەرلەرنى ئورناتتى: ــ بىر قاتاردىكىسى قىزىل ياقۇت، سېرىق گۆھەر ۋە زۇمرەتلەر ئىدى؛ بۇ بىرىنچى قاتار ئىدى.
002	EXO	039	011	ئىككىنچى قاتارغا كۆك قاشتېشى، كۆك ياقۇت ۋە ئالماس،
002	EXO	039	012	ئۈچىنچى قاتارغا سۆسۈن ياقۇت، پىروزا ۋە سۆسۈن كۋارتس،
002	EXO	039	013	تۆتىنچى قاتارغا بېرىل ياقۇت، ئاق ھېقىق ۋە ئانارتاش ئورنىتىلدى؛ بۇلارنىڭ ھەممىسى ئالتۇن كۆزلۈككە بېكىتىلدى.
002	EXO	039	014	بۇ گۆھەرلەر ئىسرائىلنىڭ ئوغۇللىرىنىڭ ناملىرىغا ۋەكىل قىلىنىپ، ئۇلارنىڭ سانىدەك ئون ئىككى بولۇپ، مۆھۈر ئويغاندەك ھەربىر گۆھەرگە ئون ئىككى قەبىلىنىڭ نامى بىردىن-بىردىن پۈتۈلدى.
002	EXO	039	015	ئۇلار قوشېنغا شوينىدەك ئېشىلگەن ساپ ئالتۇندىن [ئىككى] ئېشىلمە زەنجىر ياسىدى؛
002	EXO	039	016	ئۇلار قوشېنغا ئالتۇندىن ئىككى كۆزلۈك ۋە ئىككى ھالقا ئېتىپ، ئىككى ھالقىنى قوشېننىڭ [يۇقىرىقى] ئىككى بۇرجىكىگە بېكىتتى؛
002	EXO	039	017	ئاندىن شۇ ئالتۇندىن ئېشىلىپ ياسالغان ئىككى زەنجىرنى قوشېننىڭ [يۇقىرىقى] ئىككى بۇرجىكىدىكى ھالقىدىن ئۆتكۈزۈپ،
002	EXO	039	018	ئېشىلگەن شۇ زەنجىرلەرنىڭ ئىككى ئۇچىنى ئىككى كۆزلۈككە بېكىتىپ، [كۆزلۈكلەرنى] ئەفودنىڭ ئىككى مۈرىلىك تاسمىسىنىڭ ئالدى قىسمىغا ئورناتتى.
002	EXO	039	019	بۇنىڭدىن باشقا ئۇلار ئالتۇندىن ئىككى ھالقا ياساپ، ئۇلارنى قوشېننىڭ [ئاستى تەرىپىدىكى] ئىككى بۇرجىكىگە بېكىتتى؛ ئۇلار ئەفودقا تېگىشىپ تۇرىدىغان قىلىنىپ ئىچىگە قادالدى.
002	EXO	039	020	مۇندىن باشقا ئۇلار ئالتۇندىن [يەنە] ئىككى ھالقا ياساپ، ئۇلارنى ئەفودنىڭ ئىككى مۈرىلىك تاسمىسىنىڭ ئالدى تۆۋەنكى قىسمىغا، ئەفودقا ئۇلىنىدىغان جايغا يېقىن، كەشىتىلەنگەن بەلۋاغدىن ئېگىزرەك قىلىپ بېكىتتى.
002	EXO	039	021	ئۇلار قوشېننىڭ ئەفودنىڭ بەلۋېغىدىن يۇقىرىراق تۇرۇشى، قوشېننىڭ ئەفودتىن ئاجراپ كەتمەسلىكى ئۈچۈن كۆك شوينا بىلەن قوشېننىڭ ھالقىسىنى ئەفودنىڭ ھالقىسىغا چېتىپ قويدى. بۇلارنىڭ ھەممىسى پەرۋەردىگارنىڭ مۇساغا بۇيرۇغىنىدەك قىلىندى.
002	EXO	039	022	[بەزالەل] ئەفودنىڭ [ئىچىدىكى] توننى پۈتۈنلەي كۆك رەڭلىك قىلدى.
002	EXO	039	023	توننىڭ [باشقا كىيىلىدىغان] تۆشۈكى دەل ئوتتۇرىسىدا، خۇددى ساۋۇتنىڭ ياقىسىدەك ئىشلەنگەنىدى؛ يىرتىلىپ كەتمەسلىكى ئۈچۈن ئۇنىڭ چۆرىسىگە پەۋاز ئىشلەندى.
002	EXO	039	024	ئۇلار توننىڭ ئېتىكىنىڭ چۆرىسىگە كۆك، سۆسۈن ۋە قىزىل يىپتىن ئانارلارنى توقۇپ ئېسىپ قويدى.
002	EXO	039	025	ئۇلار ھەمدە ئالتۇن قوڭغۇراقلارنى ياساپ، قوڭغۇراقلارنى توننىڭ ئېتىكىنىڭ چۆرىسىگە، ئانارلارنىڭ ئارىلىقىغا بىردىن ئېسىپ قويدى؛ ھەر ئىككى ئانارنىڭ ئوتتۇرىسىغا بىر قوڭغۇراق ئېسىپ قويۇلدى.
002	EXO	039	026	[كاھىنلىق] خىزمىتىگە ئائىت [قوڭغۇراقلار] توننىڭ ئېتىكىنىڭ چۆرىسىگە بېكىتىلدى؛ بىر ئالتۇن قوڭغۇراق، بىر ئانار، بىر ئالتۇن قوڭغۇراق، بىر ئانار قىلىپ بېكىتىلدى؛ ھەممىسى پەرۋەردىگارنىڭ مۇساغا بۇيرۇغىنىدەك قىلىندى.
002	EXO	039	027	ئۇلار ھارۇن بىلەن ئۇنىڭ ئوغۇللىرىغا نېپىز توقۇلغان ئاق كاناپ رەختتىن خالتا كۆڭلەكلەرنى تىكتى؛
002	EXO	039	028	سەللىنى ئاق كاناپ رەختتە ياسىدى، شۇنداقلا چىرايلىق ئېگىز بۆكلەرنى ئاق كاناپ رەختتە، تامباللارنى نېپىز توقۇلغان ئاق كاناپ رەختتە تەييارلىدى؛
002	EXO	039	029	بۇنىڭدىن باشقا ئۇلار بەلۋاغنىمۇ كۆك، سۆسۈن ۋە قىزىل يىپ ئارىلاشتۇرۇلۇپ كەشتىلەنگەن، نېپىز توقۇلغان ئاق كاناپ رەختتە تەييارلىدى؛ بۇلارنىڭ ھەممىسى پەرۋەردىگارنىڭ مۇساغا بۇيرۇغىنىدەك قىلىندى.
002	EXO	039	030	ئۇلار يەنە نەپىس تاختاينى، يەنى مۇقەددەس ئوتۇغاتنى ساپ ئالتۇندىن ياساپ، ئۇنىڭ ئۈستىگە مۆھۈر ئويغاندەك: «پەرۋەردىگارغا مۇقەددەس قىلىندى» دەپ ئويۇپ پۈتتى؛
002	EXO	039	031	ئۇلار ئوتۇغاتقا كۆك رەڭلىك يىپنى باغلاپ، ئۇنىڭ بىلەن ئوتۇغاتنى سەللىگە تاقىدى، بۇلار پەرۋەردىگارنىڭ مۇساغا بۇيرۇغىنىدەك قىلىندى.
002	EXO	039	032	شۇ تەرىقىدە جامائەتنىڭ ئىبادەت چېدىرىنىڭ ھەممە قۇرۇلۇشى پۈتكۈزۈلدى؛ ئىسرائىللار پەرۋەردىگارنىڭ مۇساغا بۇيرۇغىنىنىڭ ھەممىسىنى شۇ بويىچە قىلدى؛ شۇ تەرىقىدە ھەممىسىنى پۈتتۈردى.
002	EXO	039	033	ئۇلار چېدىرنى مۇسانىڭ يېنىغا ئېلىپ كەلدى ــ چېدىر يوپۇقلىرىنى، ئۇنىڭ بارلىق ئەسۋابلىرىنى، ئىلمەكلىرىنى، تاختايلىرىنى، بالداقلىرىنى، خادىلىرى بىلەن تەگلىكلىرىنى،
002	EXO	039	034	شۇنىڭدەك قىزىل بويالغان قوچقار تېرىسىدىن ياسالغان يوپۇق بىلەن دېلفىن تېرىسىدىن ياسالغان يوپۇقنى، «ئايرىما پەردە»نى،
002	EXO	039	035	ئەھدە ساندۇقى ۋە ئۇنىڭ بالداقلىرىنى، «كەفارەت تەختى»نى،
002	EXO	039	036	شىرە ۋە ئۇنىڭ بارلىق ئەسۋابلىرىنى، شۇنداقلا «تەقدىم نانلار»نى،
