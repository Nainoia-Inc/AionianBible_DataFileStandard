019	PSA	147	015	ئۇ ئۆز ئەمر-بېشارەتلىرىنى يەر يۈزىگە ئەۋەتىدۇ؛ ئۇنىڭ سۆز-كالامى ئىنتايىن تېز يۈگۈرىدۇ.
019	PSA	147	016	ئۇ ئاق قارنى يۇڭدەك بېرىدۇ، قىراۋنى كۈللەردەك تارقىتىدۇ.
019	PSA	147	017	ئۇنىڭ مۇزىنى نان ئۇۋاقلىرىدەك قىلىپ پارچىلىۋېتىدۇ؛ ئۇنىڭ سوغۇقى ئالدىدا كىم تۇرالىسۇن؟
019	PSA	147	018	ئۇ سۆزىنى ئەۋەتىپ، ئۇلارنى ئېرىتىدۇ؛ ئۇنىڭ شامىلىنى چىقىرىپ، سۇلارنى ئاققۇزىدۇ.
019	PSA	147	019	ئۇ ئۆز سۆز-كالامىنى ياقۇپقا، بەلگىلىمىلىرىنى ھەم ھۆكۈملىرىنى ئىسرائىلغا ئايان قىلىدۇ؛
019	PSA	147	020	ئۇ باشقا ھېچبىر ئەلگە مۇنداق مۇئامىلە قىلمىغاندۇر؛ ئۇنىڭ ھۆكۈملىرىنى بولسا، ئۇلار بىلىپ باققان ئەمەس. ھەمدۇسانا!
019	PSA	148	001	ھەمدۇسانا! پەرۋەردىگارنى ئاسمانلاردىن مەدھىيىلەڭلار؛ يۇقىرى جايلاردا ئۇنى مەدھىيىلەڭلار؛
019	PSA	148	002	ئۇنى مەدھىيىلەڭلار، بارلىق پەرىشتىلىرى؛ ئۇنى مەدھىيىلەڭلار، بارلىق قوشۇنلىرى!
019	PSA	148	003	ئۇنى مەدھىيىلەڭلار، ئى قۇياش ھەم ئاي، ئۇنى مەدھىيىلەڭلار، ھەممە پارلاق يۇلتۇزلار؛
019	PSA	148	004	ئۇنى مەدھىيىلەڭلار، ئاسمانلارنىڭ ئاسمانلىرى، ئاسماندىن يۇقىرى جايلاشقان سۇلار!
019	PSA	148	005	بۇلار پەرۋەردىگارنىڭ نامىنى مەدھىيىلىگەي؛ چۈنكى ئۇ بۇيرۇغان ھامان، ئۇلار ياراتىلغاندۇر؛
019	PSA	148	006	ئۇ ئۇلارنى ئەبەدىلئەبەدگىچە تۇرغۇزدى؛ ئۇلار ئۈچۈن ۋاقتى ئۆتمەيدىغان بەلگىلىمىنى بۇيرۇغان.
019	PSA	148	007	پەرۋەردىگارنى زېمىندىن مەدھىيىلەڭلار، دېڭىزدىكى بارلىق ئەجدىھالار، دېڭىزنىڭ بارلىق تەگلىرى؛
019	PSA	148	008	ئوت، مۆلدۈز، قار، تۇمان، ئۇنىڭ سۆزىگە ئەمەل قىلىدىغان جۇدۇنلۇق شامال؛
019	PSA	148	009	تاغلار ھەم بارلىق دۆڭلەر، مېۋىلىك دەرەخلەر، بارلىق كېدىر دەرەخلىرى،
019	PSA	148	010	ياۋايى ھايۋانلار، بارلىق مال-ۋارانلار، ئۆمىلىگۈچىلەر ھەم ئۇچار-قاناتلار؛
019	PSA	148	011	جاھان پادىشاھلىرى ۋە بارلىق قوۋملار، ئەمىرلەر ھەم يەر يۈزىدىكى بارلىق ھاكىم-سوتچىلار؛
019	PSA	148	012	ھەم يىگىتلەر ھەم قىزلار، بوۋايلار ۋە ياشلار، ــ
019	PSA	148	013	ھەممىسى پەرۋەردىگارنىڭ نامىنى مەدھىيىلىگەي؛ چۈنكى پەقەتلا ئۇنىڭ نامى ئالىيدۇر؛ ئۇنىڭ ھەيۋىتى يەر ھەم ئاسماندىن ئۈستۈن تۇرىدۇ.
019	PSA	148	014	ھەم ئۇ ئۆز خەلقىنىڭ مۈڭگۈزىنى، يەنى بارلىق مۇقەددەس بەندىلىرىنىڭ مەدھىيىسىنى ئېگىز كۆتۈرگۈزگەن؛ ئۇلار ئىسرائىل بالىلىرى، ئۆزىگە يېقىن بىر خەلقتۇر! ھەمدۇسانا!
019	PSA	149	001	ھەمدۇسانا! پەرۋەردىگارغا ئاتاپ يېڭى بىر ناخشىنى ئوقۇڭلار؛ مۆمىن بەندىلەرنىڭ جامائىتىدە ئۇنىڭ مەدھىيىسىنى ئېيتىڭلار!
019	PSA	149	002	ئىسرائىل ئۆز ياراتقۇچىسىدىن شادلانغاي؛ زىئون ئوغۇللىرى ئۆز پادىشاھىدىن خۇش بولغاي!
019	PSA	149	003	ئۇلار ئۇنىڭ نامىنى ئۇسسۇل بىلەن مەدھىيىلىگەي؛ ئۇنىڭغا كۈيلەرنى داپ ھەم چىلتارغا تەڭشەپ ئېيتقاي!
019	PSA	149	004	چۈنكى پەرۋەردىگار ئۆز خەلقىدىن سۆيۈنەر؛ ئۇ ياۋاش مۆمىنلەرنى نىجاتلىق بىلەن بېزەيدۇ؛
019	PSA	149	005	ئۇنىڭ مۆمىن بەندىلىرى شان-شەرەپتە روھلىنىپ شاد بولغاي، ئورۇنلىرىدا يېتىپ شاد ئاۋازىنى ياڭراتقاي!
019	PSA	149	006	ئاغزىدا تەڭرىگە يۈكسەك مەدھىيىلىرى بولغاي، قوللىرىدا قوش بىسلىق قىلىچ تۇتۇلغاي؛
019	PSA	149	007	شۇنىڭ بىلەن ئۇلار ئەللەر ئۈستىدىن قىساس، خەلقلەرگە جازا بەجا يۈرگۈزىدۇ؛
019	PSA	149	008	ئەللەرنىڭ پادىشاھلىرىنى زەنجىرلەر بىلەن، ئاقسۆڭەكلىرىنى تۆمۈر كىشەنلىرى بىلەن باغلايدۇ؛
019	PSA	149	009	ئۇلارنىڭ ئۈستىگە پۈتۈلگەن ھۆكۈمنى بەجا كەلتۈرىدۇ ــ ئۇنىڭ بارلىق مۆمىن بەندىلىرى مۇشۇ شەرەپكە نېسىپ بولىدۇ! ھەمدۇسانا!
019	PSA	150	001	ھەمدۇسانا! تەڭرىنى ئۇنىڭ مۇقەددەس جايىدا مەدھىيىلەڭلار؛ قۇدرىتى پارلاپ تۇرىدىغان ئەرشلەردە ئۇنى مەدھىيىلەڭلار؛
019	PSA	150	002	ئۇنى قۇدرەتلىك ئىشلىرى ئۈچۈن مەدھىيىلەڭلار؛ غايەت ئۇلۇغلۇقى ئۈچۈن ئۇنى مەدھىيىلەڭلار؛
019	PSA	150	003	ئۇنى بۇرغا ساداسى بىلەن مەدھىيىلەڭلار؛ ئۇنى راۋاب ھەم چىلتار بىلەن مەدھىيىلەڭلار؛
019	PSA	150	004	ئۇنى داپ ھەم ئۇسسۇل بىلەن مەدھىيىلەڭلار؛ ئۇنى تارلىق سازلار ھەم نەي بىلەن مەدھىيىلەڭلار؛
019	PSA	150	005	ئۇنى جاراڭلىق جاڭلار ھەم ياڭراق جاڭلار بىلەن مەدھىيىلەڭلار؛
019	PSA	150	006	بارلىق نەپەس ئىگىلىرى ياھنى مەدھىيىلىغاي! ھەمدۇسانا!
#
# BOOK	020	PRO	Proverbs	پەند-نەسىھەتلەر
020	PRO	001	001	ئىسرائىل پادىشاھى داۋۇتنىڭ ئوغلى سۇلايماننىڭ پەند-نەسىھەتلىرى: ــ
020	PRO	001	002	بۇ پەند-نەسىھەتلەر ساڭا ئەقىل-پاراسەت، ئەدەپ-ئەخلاقنى ئۆگىتىپ، سېنى ئىبرەتلىك سۆزلەرنى چۈشىنىدىغان قىلىدۇ؛
020	PRO	001	003	ساڭا دانالىق، ھەققانىيلىق، پەم-پاراسەت ۋە دۇرۇسلۇقنىڭ يوليورۇق-تەربىيىسىنى قوبۇل قىلدۇرىدۇ.
020	PRO	001	004	بۇ [پەند-نەسىھەتلەر] نادانلارنى زېرەك قىلىپ، ياشلارنى بىلىملىك ۋە سەزگۈر قىلىدۇ؛
020	PRO	001	005	بۇلارغا قۇلاق سېلىشى بىلەن دانالار بىلىمىنى ئاشۇرىدۇ، يورۇتۇلغان كىشىلەر تېخىمۇ دانا مەسلىھەتكە ئېرىشىدۇ،
020	PRO	001	006	شۇنداقلا پەند-نەسىھەتلەر ھەم تەمسىللەرنىڭ مەنىسىنى، دانىشمەنلەرنىڭ ھېكمەتلىرى ھەم تىلسىم سۆزلىرىنى چۈشىنىدىغان قىلىنىدۇ.
020	PRO	001	007	پەرۋەردىگاردىن قورقۇش بىلىمنىڭ باشلىنىشىدۇر؛ ئەخمەقلەر دانالىقنى ۋە تەربىيىنى كۆزگە ئىلمايدۇ.
020	PRO	001	008	ئى ئوغلۇم، ئاتاڭنىڭ تەربىيىسىگە قۇلاق سال، ئاناڭنىڭ سۆز-نەسىھەتىدىن ئايرىلما؛
020	PRO	001	009	چۈنكى ئۇلار سېنىڭ بېشىڭغا تاقالغان گۈل چەمبىرەك، بوينۇڭغا ئېسىلغان مارجان بولىدۇ.
020	PRO	001	010	ئى ئوغلۇم، يامانلار سېنى ئازدۇرسا، ئۇلارغا ئەگەشمىگىن.
020	PRO	001	011	ئەگەر ئۇلار: ــ يۈر، تۇزاق قۇرۇپ ئادەم ئۆلتۈرەيلى؛ يوشۇرۇنۇۋېلىپ، بىرەر بىگۇناھ كەلگەندە ئۇرايلى!
020	PRO	001	012	تەھتىسارادەك ئۇلارنى يۇتۇۋېتەيلى، ساق بولسىمۇ، ھاڭغا چۈشكەنلەردەك ئۇلارنى يىقىتايلى؛
020	PRO	001	013	ئۇلاردىن خىلمۇخىل قىممەتلىك مال-دۇنياغا ئىگە بولۇپ، ئۆيلىرىمىزنى ئولجا بىلەن تولدۇرىمىز.
020	PRO	001	014	بىز بىلەن شېرىك بول، ھەميانىمىز بىر بولسۇن، دېسە، ــ
020	PRO	001	015	ئى ئوغلۇم، ئۇلارغا يولداش بولما، ئۆزۈڭنى ئۇلارنىڭ ئىزىدىن نېرى قىل!
020	PRO	001	016	چۈنكى ئۇلارنىڭ پۇتلىرى رەزىللىككە يۈگۈرىدۇ، قولىنى قان قىلىش ئۈچۈن ئالدىرايدۇ.
020	PRO	001	017	ھەرقانداق ئۇچار قانات تۇيۇپ قالغاندا تۇزاق قويۇش بىكار ئاۋارىچىلىكتۇر؛
020	PRO	001	018	لېكىن بۇلار دەل ئۆز قېنىنى تۆكۈش ئۈچۈن ساقلايدۇ؛ ئۆز جانلىرىغا زامىن بولۇشنى كۈتىدۇ.
020	PRO	001	019	نەپسى يوغىناپ كەتكەن ھەربىر ئادەمنىڭ يوللىرىنىڭ ئاقىۋىتى مانا شۇنداق؛ [ھارام مال-دۇنيا] ئۆز ئىگىلىرىنىڭ جېنىنى ئالىدۇ.
020	PRO	001	020	[بۈيۈك] دانالىق كوچىدا ئوچۇق-ئاشكارا خىتاب قىلماقتا، چوڭ مەيدانلاردا ساداسىنى ئاڭلاتماقتا.
020	PRO	001	021	كوچا دوقمۇشلىرىدا ئادەملەرنى چاقىرماقتا، شەھەر دەرۋازىلىرىدا سۆزلىرىنى جاكارلىماقتا: ــ
020	PRO	001	022	ئى ساددىلار، قاچانغىچە مۇشۇنداق نادانلىققا بېرىلىسىلەر؟ مەسخىرە قىلغۇچىلار قاچانغىچە مەسخىرىلىكتىن ھۇزۇر ئالسۇن؟ ئەخمەقلەر قاچانغىچە بىلىمدىن نەپرەتلەنسۇن؟!
020	PRO	001	023	تەنبىھلىرىمگە قۇلاق سېلىپ ماڭغان يولۇڭلاردىن يانغان بولساڭلار ئىدى! روھىمنى سىلەرگە تۆكۈپ بېرەتتىم، سۆزلىرىمنى سىلەرگە بىلدۈرگەن بولاتتىم.
020	PRO	001	024	لېكىن چاقىرسام، ئاڭلىمىدىڭلار؛ قولۇمنى ئۇزارتسام، ھېچقايسىڭلار قارىمىدىڭلار.
020	PRO	001	025	نەسىھەتلىرىمنىڭ ھەممىسىگە پەرۋا قىلمىدىڭلار، تەنبىھىمنى ئاڭلاشنى قىلچە خالىمىدىڭلار.
020	PRO	001	026	شۇڭا، بېشىڭلارغا بالايىقازا كەلگەندە كۈلىمەن، ۋەھىمە سىلەرگە يېتىشى بىلەن مەسخىرە قىلىمەن.
020	PRO	001	027	ھالاكەت ئېلىپ كەلگەن ۋەھىمە ئۈستۈڭلارغا چۈشكەندە، ۋەيرانچىلىق سىلەرگە قۇيۇنتازدەك كەلگەندە، سىلەر ئېغىر قايغۇغا ۋە ئازابقا مۇپتىلا بولغىنىڭلاردا ــ
020	PRO	001	028	ئۇ چاغدا مۇشۇ كىشىلەر مەندىن ئۆتۈنۈپ چاقىرىدۇ، مەن پەرۋا قىلمايمەن، مېنى تەلمۈرۈپ ئىزدىسىمۇ، تاپالمايدۇ.
020	PRO	001	029	ئۇلار بىلىمگە نەپرەتلەنگىنىدىن، پەرۋەردىگاردىن ئەيمىنىشنى تاللىمىغىنىدىن،
020	PRO	001	030	مېنىڭ نەسىھىتىمنى قىلچە قوبۇل قىلغۇسى يوقلۇقىدىن، تەنبىھىمگىمۇ پەرۋا قىلمىغىنىڭلاردىن،
020	PRO	001	031	ئۇلار ئۆز بېشىنى يەيدۇ، ئۆز قەستلىرىدىن تولۇق ئازاب تارتىدۇ؛
020	PRO	001	032	چۈنكى ساددىلارنىڭ يولدىن چىقىشى ئۆز جېنىغا زامىن بولىدۇ؛ ئەخمەقلەر راھەتلىك تۇرمۇشىدىن ئۆزلىرىنى ھالاك قىلىدۇ.
020	PRO	001	033	لېكىن ماڭا قۇلاق سالغانلار ئامان-ئېسەن ياشايدۇ، بالايىقازالاردىن، غەم-ئەندىشلەردىن خالىي بولۇپ، خاتىرجەم تۇرىدۇ.
020	PRO	002	001	ئى ئوغلۇم، ئەگەر سۆزلىرىمنى قوبۇل قىلساڭ، نەسىھەتلىرىمنى قەلبىڭگە پۈكسەڭ،
020	PRO	002	002	ئەگەردە دانالىققا قۇلاق سالساڭ، يورۇقلۇققا ئېرىشىشكە كۆڭۈل بەرسەڭ،
020	PRO	002	003	ئەگەر ئەقىل-پاراسەتكە تەشنا بولۇپ ئىلتىجا قىلساڭ، يورۇقلۇققا ئېرىشىش ئۈچۈن يۇقىرى ئاۋازدا يېلىنساڭ،
020	PRO	002	004	ئەگەر كۈمۈشكە ئىنتىلگەندەك ئىنتىلسەڭ، يوشۇرۇن گۆھەرنى ئىزدىگەندەك ئىزدىسەڭ،
020	PRO	002	005	ئۇنداقتا پەرۋەردىگاردىن [ھەقىقىي] قورقۇشنى بىلىدىغان بولىسەن، ۋە ساڭا خۇدانى تونۇش نېسىپ بولىدۇ.
020	PRO	002	006	چۈنكى پەرۋەردىگار دانالىق بەرگۈچىدۇر؛ ئۇنىڭ ئاغزىدىن بىلىم بىلەن يورۇقلۇق چىقىدۇ.
020	PRO	002	007	ئۇ دۇرۇس ياشاۋاتقانلار ئۈچۈن مول ھېكمەت تەييارلاپ قويغاندۇر، ئۇ ۋىجدانلىق ئادەملەر ئۈچۈن قالقاندۇر.
020	PRO	002	008	ئۇ ئادىللىق قىلغۇچىلارنىڭ يوللىرىنى ئاسرايدۇ، ئىخلاسمەن بەندىلىرىنىڭ يولىنى قوغدايدۇ.
020	PRO	002	009	ئۇ چاغدا ھەققانىيلىق، ئادىللىق ۋە دۇرۇسلۇقنى، شۇنداقلا ھەرقانداق گۈزەل يولنى چۈشىنىدىغان بولىسەن.
020	PRO	002	010	دانالىق قەلبىڭگە كىرىشى بىلەنلا، بىلىم كۆڭلۈڭگە يېقىشى بىلەنلا،
020	PRO	002	011	پەم-پاراسەت سېنى قوغدايدۇ، يورۇقلۇق سېنى ساقلايدۇ.
020	PRO	002	012	ئۇلار سېنى يامان يولدىن، تىلى زەھەر ئادەملەردىن قۇتقۇزىدۇ؛
