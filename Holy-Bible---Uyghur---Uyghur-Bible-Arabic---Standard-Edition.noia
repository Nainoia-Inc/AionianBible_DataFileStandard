001	GEN	050	007	شۇنىڭ بىلەن يۈسۈپ ئاتىسىنى دەپنە قىلغىلى ماڭدى. پىرەۋننىڭ بارلىق خىزمەتكارلىرى، ئوردىنىڭ ئاقساقاللىرى ھەم مىسىر زېمىنىدىكى ئاقساقاللار ئۇنىڭ بىلەن ھەمراھ بولۇپ ماڭدى.
001	GEN	050	008	يۈسۈپنىڭ ئۆيىدىكى ھەممىسى، قېرىنداشلىرى ۋە ئاتىسىنىڭ ئۆيىدىكىلەرمۇ بىللە باردى؛ ئۇلار پەقەت كىچىك بالىلىرى، قوي-كالا پادىلىرىنى گوشەن يۇرتىدا قويۇپ كەتتى.
001	GEN	050	009	ئۇنىڭ بىلەن يەنە جەڭ ھارۋىلىرى ۋە ئاتلىقلارمۇ بىللە باردى؛ شۇنىڭ بىلەن ئۇلار ناھايىتى چوڭ بىر قوشۇن بولدى.
001	GEN	050	010	ئۇلار ئىئوردان دەرياسىنىڭ ئۇ تەرىپىدىكى «ئاتادنىڭ خامىنى»غا يېتىپ كەلگەندە، شۇ يەردە قاتتىق ۋە ھەسرەتلىك يىغا-زار قىلىپ ماتەم تۇتۇپ يىغلاشتى. يۈسۈپ ئاتىسى ئۈچۈن يەتتە كۈن ماتەم تۇتتى.
001	GEN	050	011	شۇ يۇرتتا ئولتۇرۇشلۇق قانائانىيلار ئاتادنىڭ خامىنىدا بولغان بۇ ماتەمنى كۆرۈپ: ــ بۇ مىسىرلىقلارنىڭ ئىنتايىن قاتتىق تۇتقان ھازىسى بولدى، دېيىشتى. بۇ سەۋەبتىن ئۇ جاينىڭ نامى «ئابەل-مىزرائىم» دەپ ئاتالدى؛ ئۇ ئىئوردان دەرياسىنىڭ ئۇ تەرىپىدىدۇر.
001	GEN	050	012	ياقۇپنىڭ ئوغۇللىرى ئۇنىڭ ئۆزلىرىگە تاپىلىغىنىدەك قىلدى؛
001	GEN	050	013	ئۇنىڭ ئوغۇللىرى ئۇنى قانائان زېمىنىغا ئېلىپ بېرىپ، مامرەنىڭ ئۇدۇلىدا، ماكپېلاھنىڭ ئېتىزلىقىنىڭ ئىچىدىكى غاردا دەپنە قىلدى. شۇ غارنى ئىبراھىم قەبرىستانلىق قىلاي دەپ ماكپېلاھنىڭ ئېتىزلىقى بىلەن قوشۇپ ھىتتىي ئەفروندىن سېتىۋالغانىدى.
001	GEN	050	014	يۈسۈپ ئاتىسىنى دەپنە قىلغاندىن كېيىن، ئۆزى، قېرىنداشلىرى، شۇنداقلا ئاتىسىنى دەپنە قىلىشقا ئۇنىڭغا ھەمراھ بولۇپ چىققان ھەممە خەلقلەر مىسىرغا يېنىپ كەلدى.
001	GEN	050	015	لېكىن يۈسۈپنىڭ قېرىنداشلىرى ئاتىسىنىڭ ئۆلۈپ كەتكىنىنى كۆرگەندە: ــ ئەمدى يۈسۈپ بىزگە دۈشمەن بولۇپ بىزنىڭ ئۇنىڭغا قىلغان بارلىق يامانلىقىمىزنى ئۈستىمىزگە ياندۇرارمىكىن، دېيىشتى.
001	GEN	050	016	ئۇلار يۈسۈپنىڭ قېشىغا ئادەم ئەۋەتىپ: ــ ئاتىلىرى ئۆلۈشتىن ئىلگىرى بىزگە ۋەسىيەت قىلىپ تاپىلاپ: ــ
001	GEN	050	017	«سىلەر يۈسۈپكە: ــ ئاكىلىرىڭ ساڭا رەزىللىك قىلغانىدى؛ ئەمدى ئۇلارنىڭ ئاسىيلىقى ھەم گۇناھىنى كەچۈرگىن! ــ دەڭلار» ــ دېگەنىدى. ھازىر سىلىدىن ئۆتۈنۈمىزكى، ئاتىلىرىنىڭ خۇداسىنىڭ بەندىلىرىنىڭ ئاسىيلىقىنى كەچۈرگەيلا! ــ دېدى. يۈسۈپ بۇ گەپلەرنى ئاڭلاپ يىغلىدى.
001	GEN	050	018	ئاندىن ئاكىلىرى كېلىپ ئۇنىڭ ئالدىدا ئۆزلىرىنى يەرگە ئېتىپ: ــ مانا، بىز سىلىنىڭ قۇللىرىدۇرمىز! ــ دېدى.
001	GEN	050	019	لېكىن يۈسۈپ ئۇلارغا جاۋابەن: ــ قورقماڭلار! مەن خۇدانىڭ ئورنىدا تۇرۇۋاتامدىم؟
001	GEN	050	020	سىلەر دەرۋەقە ماڭا شۇ ئىشنى يامان نىيەت بىلەن قىلدىڭلار؛ لېكىن خۇدا بۈگۈنكى كۈندىكىدەك نۇرغۇنلىغان خەلقنىڭ جېنىنى تىرىك ساقلاپ قېلىش ئۈچۈن شۇ ئىشنى ياخشىلىققا بېكىتكەنىدى.
001	GEN	050	021	شۇڭا ئەمدى قورقماڭلار؛ مەن ھەم سىلەرنى ھەم بالا-چاقىلىرىڭلارنى باقىمەن، ــ دېدى ۋە ئۇلارنىڭ كۆڭلىنى خاتىرجەم قىلىپ مېھىرلىك گەپ قىلدى.
001	GEN	050	022	يۈسۈپ ئاتىسىنىڭ جەمەتى بىلەن بىللە مىسىردا تۇرۇپ قالدى. يۈسۈپ بىر يۈز ئون يىل ئۆمۈر كۆردى.
001	GEN	050	023	بۇ تەرىقىدە يۈسۈپ ئەفرائىمنىڭ ئۈچىنچى ئەۋلادىنى كۆردى؛ ماناسسەھنىڭ ئوغلى ماكىرنىڭ بالىلىرىمۇ ئۇنىڭ تىزلىرى ئۈستىدە تۇغۇلدى.
001	GEN	050	024	يۈسۈپ قېرىنداشلىرىغا: ــ مەن ئۆلۈپ كېتىمەن؛ لېكىن خۇدا چوقۇم سىلەرنى يوقلاپ سىلەرنى بۇ زېمىندىن چىقىرىپ، ئىبراھىم، ئىسھاق ۋە ياقۇپقا بېرىشكە قەسەم قىلىپ ۋەدە قىلغان زېمىنغا يەتكۈزىدۇ، ــ دېدى.
001	GEN	050	025	ئاندىن يۈسۈپ يەنە قېرىنداشلىرىغا قەسەم ئىچكۈزۈپ: «خۇدا سىلەرنى چوقۇم يوقلايدۇ؛ شۇ چاغدا سىلەر مېنىڭ سۆڭەكلىرىمنى ئېلىپ، بۇ يەردىن چىقىپ كېتىشىڭلار كېرەك»، ــ دېدى.
001	GEN	050	026	يۈسۈپ بىر يۈز ئون ياشقا كىرگەندە ۋاپات تاپتى. ئۇلار ئۇنى مۇمىيا قىلىپ، مىسىردا بىر مېيىت ساندۇقىغا سېلىپ قويدى.
#
# BOOK	002	EXO	Exodus	مىسىردىن‭ ‬چىقىش‭ ‬
002	EXO	001	001	ۋە تۆۋەندىكىلەر ئىسرائىل [بىلەن بىللە] مىسىرغا بارغان ئوغۇللىرىنىڭ ئىسىملىرى (ئۇلار ھەرقايسىسى ئۆز بالا-چاقىلىرىنى ئېلىپ، ياقۇپ بىلەن بىللە مىسىرغا بارغانىدى): ــ
002	EXO	001	002	رۇبەن، شىمېئون، لاۋىي، يەھۇدا،
002	EXO	001	003	ئىسساكار، زەبۇلۇن، بىنيامىن،
002	EXO	001	004	دان، نافتالى، گاد ۋە ئاشىر.
002	EXO	001	005	ئەمدى ياقۇپنىڭ پۇشتىدىن بولغانلار جەمئىي بولۇپ يەتمىش ئادەم ئىدى. بۇ ۋاقىتتا يۈسۈپ مىسىردا ئىدى.
002	EXO	001	006	كېيىن يۈسۈپ، ئۇنىڭ بارلىق قېرىنداشلىرى ھەمدە بارلىق زامانداشلىرى ئۆلۈپ تۈگىدى.
002	EXO	001	007	شۇنداقتىمۇ، ئىسرائىللار كۆپ تۇغۇلۇپ، تېز ئاۋۇپ، ئىنتايىن كۈچەيدى؛ ئۇلار زېمىنغا بىر كەلدى.
002	EXO	001	008	ئۇ ۋاقىتلاردا يۈسۈپنى بىلمەيدىغان يېڭى بىر پادىشاھ مىسىردا تەختكە چىقتى.
002	EXO	001	009	ئۇ خەلقىگە: مانا، ئىسرائىللارنىڭ خەلقى بىزدىن زىيادە ئاۋۇپ ھەمدە بىزدىنمۇ كۈچلىنىپ كەتتى.
002	EXO	001	010	ئەمدى بىز ئۇلارغا نىسبەتەن ئاقىلانە ئىش تۇتايلى؛ بولمىسا، ئۇلار تېخىمۇ ئاۋۇپ كېتىدۇ، مۇبادا ئۇرۇش پارتلاپ قالسا، شۇنداق بولىدۇكى، ئۇلار دۈشمەنلىرىمىز تەرەپكە ئۆتۈپ، بىزگە ھۇجۇم قىلىپ، يۇرتتىن چىقىپ كېتىشى مۇمكىن، ــ دېدى.
002	EXO	001	011	شۇنىڭ بىلەن ئۇلار ئۇلارنى قىلىۋاتقان ئەمگەكلەردە خارلاش ئۈچۈن ئىش باشلىرىنى تەيىنلەپ نازارەتچىلىككە قويدى. شۇنىڭ بىلەن ئىسرائىللار پىرەۋن ئۈچۈن پىتوم بىلەن رائامسەس دېگەن ماددىي ئەشيا ساقلايدىغان شەھەرلەرنى ياساپ بەردى.
002	EXO	001	012	لېكىن ئۇلارنى [قانچە] ئەزگەنسېرى، بۇلار شۇنچە كۆپىيىپ ھەممە يەرنى قاپلىدى؛ بۇنىڭ بىلەن مىسىرلىقلار ئىسرائىللارغا ئۆچ بولۇپ كەتتى.
002	EXO	001	013	شۇنىڭ بىلەن مىسىرلىقلار ئىسرائىللارغا زۇلۇم قىلىپ، ئۇلارنى تېخىمۇ قاتتىق ئىشلىتىپ ئېغىر ئىشلارغا سالدى.
002	EXO	001	014	مىسىرلىقلار ئۇلارنى لايچىلىق، خىش-كېسەك قۇيۇش ۋە ئېتىزلارنىڭ ھەرخىل ئەمگەكلىرىگە سېلىپ، ئىشنىڭ قاتتىقلىقى بىلەن ئۇلارنىڭ تۇرمۇشىغا قاتتىق ئېغىرچىلىق سالدى؛ ئۇلارنى نېمە ئەمگەككە سالمىسۇن، ئىنتايىن جاپالىق ئىدى.
002	EXO	001	015	مىسىر پادىشاھى ئىككى ئىبرانىي تۇغۇت ئانىسىغا سۆز قىلىپ (ئۇلارنىڭ بىرىنىڭ ئىسمى شىفراھ، يەنە بىرىنىڭ ئىسمى پۇئاھ ئىدى):
002	EXO	001	016	ــ سىلەر قاچانلىكى ئىبرانىي خوتۇنلارنى تۇغدۇرساڭلار، تۇغقاندا ئوبدان قاراڭلار؛ بوۋاق ئوغۇل بولسا، ئۆلتۈرۈۋېتىڭلار؛ قىز بولسا، تىرىك قويۇڭلار، ــ دېدى.
002	EXO	001	017	لېكىن تۇغۇت ئانىلىرى خۇدادىن قورقۇپ، مىسىرنىڭ پادىشاھى ئۇلارغا ئېيتقاندەك قىلماي، بەلكى ئوغۇل بوۋاقلارنى تىرىك قويدى.
002	EXO	001	018	شۇڭا مىسىرنىڭ پادىشاھى تۇغۇت ئانىلىرىنى چاقىرتىپ ئۇلاردىن: ــ بۇ نېمە قىلغىنىڭلار؟! ئوغۇل بالىلارنى نېمىشقا تىرىك قويدۇڭلار؟ ــ دەپ سورىدى.
002	EXO	001	019	تۇغۇت ئانىلىرى پىرەۋنگە جاۋاب بېرىپ: ــ ئىبرانىي ئاياللار مىسىرلىق ئاياللارغا ئوخشىمايدۇ. ئۇلار كۈچلۈك، ساغلام-تىمەن بولغىنى ئۈچۈن تۇغۇت ئانىلىرى ئۇلارنىڭ قېشىغا يېتىپ بارغۇچە، ئۆزلىرى تۇغۇپ بولىدۇ، ــ دېدى.
002	EXO	001	020	نەتىجىدە، خۇدا تۇغۇت ئانىلىرىغا ئىلتىپات كۆرسەتتى؛ ئىسرائىل خەلقى داۋاملىق كۆپىيىپ، تېخىمۇ كۈچەيدى.
002	EXO	001	021	شۇنداق بولدىكى، تۇغۇت ئانىلىرى خۇدادىن قورقىدىغان ئىخلاسمەن بولغانلىقى ئۈچۈن خۇدا ئۇلارنى ئائىلىلىك بولۇشقا مۇيەسسەر قىلدى.
002	EXO	001	022	بۇنىڭ بىلەن پىرەۋن بارلىق پۇقرالىرىغا: ــ ئىسرائىللاردىن يېڭى تۇغۇلغان ئوغۇل بالىلارنىڭ ھەممىسىنى دەرياغا تاشلاڭلار، لېكىن قىز بالىلارنىڭ ھەممىسىنى تىرىك قالدۇرۇڭلار، دەپ ئەمر قىلدى.
002	EXO	002	001	لاۋىينىڭ جەمەتىدىن بولغان بىر كىشى بېرىپ، لاۋىينىڭ نەسلىدىن بولغان بىر قىزنى خوتۇنلۇققا ئالدى.
002	EXO	002	002	بۇ ئايال ھامىلىدار بولۇپ، بىر ئوغۇل تۇغدى. ئانا ئۇنىڭ چىرايلىق ئىكەنلىكىنى كۆرۈپ، ئۇنى ئۈچ ئاي يوشۇرۇپ ساقلىدى.
002	EXO	002	003	ئۇنى يەنە يوشۇرۇشقا ئامالسىز قالغاندا، قومۇشتىن بىر سېۋەت ياساپ، ئۇنىڭغا ياريېلىم ۋە موم سۇۋاپ، بالىنى ئىچىگە سېلىپ، دەريانىڭ قىرغىقىدىكى قومۇشلۇق ئارىسىغا قويۇپ قويدى.
002	EXO	002	004	ئاندىن بالىنىڭ ھەدىسى ئۇنىڭغا نېمە بولاركىن دەپ يىراقتىن قاراپ تۇردى.
002	EXO	002	005	ئۇ ۋاقىتتا پىرەۋننىڭ قىزى سۇغا چۆمۈلگىلى دەريا تەرەپكە كەلدى؛ ئۇنىڭ چۆرىلىرى دەريا بويىدا ئايلىنىپ يۈردى. پىرەۋننىڭ قىزى قومۇشلۇقنىڭ ئارىسىدا تۇرغان سېۋەتنى كۆرۈپ، خاس چۆرىسىنى ئۇنى ئېلىپ چىقىشقا ئەۋەتتى.
002	EXO	002	006	ئۇ سېۋەتنى ئېچىپ قارىۋىدى، مانا، بىر ئوغۇل بالىنى كۆردى ۋە ئۇ بالا يىغلاپ كەتتى. مەلىكە ئۇنىڭغا ئىچ ئاغرىتىپ: ــ بۇ شۈبھىسىزكى ئىبرانىيلارنىڭ بالىلىرىدىن بىرى ئىكەن، دېدى.
002	EXO	002	007	ئۇ چاغدا بالىنىڭ ھەدىسى پىرەۋننىڭ قىزىدىن: ــ مەن بېرىپ، سىلى ئۈچۈن بالىنى ئېمىتىپ باقىدىغان بىر ئىبرانىي ئىنىكئانا تېپىپ كېلەيمۇ؟ ــ دەپ سورىدى.
002	EXO	002	008	پىرەۋننىڭ قىزى ئۇنىڭغا: ــ بارغىن، دېدى. قىز بېرىپ بوۋاقنىڭ ئانىسىنى چاقىرىپ كەلدى.
002	EXO	002	009	پىرەۋننىڭ قىزى ئۇنىڭغا: ــ بۇ بالىنى ئېلىپ كېتىپ مەن ئۈچۈن ئېمىتىپ بېقىپ بەر؛ ھەققىڭنى بېرىمەن، دېدى. شۇنىڭ بىلەن ئايال بالىنى ئېلىپ كېتىپ، ئۇنى ئېمىتىپ باقتى.
002	EXO	002	010	بالا چوڭ بولغاندا ئۇنى پىرەۋننىڭ قىزىنىڭ قېشىغا ئېلىپ باردى؛ ئۇ ئۇنىڭغا ئوغۇل بولدى. ئۇ: «مەن ئۇنى سۇدىن چىقىرىۋالغان» دەپ ئۇنىڭغا مۇسا دېگەن ئىسىمنى قويدى.
002	EXO	002	011	مۇسا چوڭ بولغاندىن كېيىنكى كۈنلەردە شۇنداق بولدىكى، ئۇ ئۆز قېرىنداشلىرىنىڭ يېنىغا باردى ۋە ئۇلارنىڭ ئېغىر ئەمگەككە سېلىنىۋاتقانلىقىنى ئۆز كۆزى بىلەن كۆردى. ئارىدا، بىر مىسىرلىقنىڭ ئىبرانىي قېرىنداشلىرىدىن بىرىنى ئۇرۇۋاتقانلىقىنى كۆردى.
002	EXO	002	012	ئۇ تۆت ئەتراپىغا قاراپ، ئادەم يوقلۇقىنى كۆرۈپ، ھېلىقى مىسىرلىقنى ئۇرۇپ ئۆلتۈرۈپ، قۇمغا كۆمۈپ يوشۇرۇپ قويدى.
002	EXO	002	013	ئەتىسى ئۇ يەنە چىقىپ قارىۋىدى، مانا ئىككى ئىبرانىي بىر-بىرى بىلەن سوقۇشۇۋاتاتتى؛ ئۇ يولسىزلىق قىلىۋاتقان كىشىگە: ــ ئۆز قېرىندىشىڭنى نېمىشقا ئۇرىسەن؟ ــ دېدى.
002	EXO	002	014	ھېلىقى كىشى جاۋاب بېرىپ: ــ كىم سېنى بىزگە ھاكىم ۋە سوراقچى قىلىپ قويدى؟ ھېلىقى مىسىرلىقنى ئۆلتۈرگىنىڭدەك مېنىمۇ ئۆلتۈرمەكچىمۇسەن؟ ــ دېدى. مۇسا بۇ گەپنى ئاڭلاپ قورقۇپ ئۆز ئىچىدە: «مەن قىلغان ئىش جەزمەن ئاشكارا بولۇپ قاپتۇ!» دەپ ئويلىدى.
002	EXO	002	015	پىرەۋن ھەم بۇ ئىشتىن خەۋەر تېپىپ، مۇسانى ئۆلتۈرمەكچى بولدى؛ لېكىن مۇسا پىرەۋننىڭ ئالدىدىن قېچىپ، مىدىيان زېمىنىغا بېرىپ ئولتۇراقلاشتى. بىر كۈنى، ئۇ قۇدۇقنىڭ يېنىغا كېلىپ ئولتۇردى.
002	EXO	002	016	مىدىياننىڭ كاھىنىنىڭ يەتتە قىزى بار ئىدى؛ ئۇلار كېلىپ، ئاتىسىنىڭ قويلىرىنى سۇغىرىشقا سۇ تارتىپ ئوقۇرلارغا قۇيۇپ تولدۇرۇشقا باشلىدى.
002	EXO	002	017	ئۇ ۋاقىتتا [يەرلىك] پادىچىلار كېلىپ، ئۇلارنى ھەيدىدى، مۇسا قوپۇپ قىزلارغا ياردەم بېرىپ، قويلىرىنى سۇغىرىشىپ بەردى.
002	EXO	002	018	ئۇلار ئاتىسى رېئۇئەلنىڭ قېشىغا يېنىپ كەلگەندە، ئۇلاردىن: ــ نېمىشقا بۈگۈن شۇنچە تېز يېنىپ كەلدىڭلار؟ ــ دەپ سورىدى.
002	EXO	002	019	ئۇلار جاۋاب بېرىپ: ــ بىر مىسىرلىق ئادەم بىزنى پادىچىلارنىڭ قولىدىن قۇتقۇزدى ھەمدە بىز ئۈچۈن سۇ تارتىپ، قوي پادىمىزنى سۇغىرىپمۇ بەردى! ــ دېدى.
002	EXO	002	020	ئۇ قىزلىرىغا: ــ ئۇنداقتا ئۇ كىشى ھازىر نەدە؟! ئۇنى نېمىشقا سىرتتا تاشلاپ كەلدىڭلار؟ ئۇنى تاماققا چاقىرىڭلار، ــ دېدى.
002	EXO	002	021	مۇسا ئۇ كىشى بىلەن بىللە تۇرۇشقا ماقۇل بولدى. ئۇ قىزى زىپپوراھنى ئۇنىڭغا خوتۇنلۇققا بەردى.
002	EXO	002	022	ئۇ ئايال ئۇنىڭغا بىر ئوغۇل تۇغۇپ بەردى؛ مۇسا «مەن ياقا يۇرتتا مۇساپىردۇرمەن» دەپ، ئۇنىڭ ئىسمىنى گەرشوم دەپ قويدى.
002	EXO	002	023	نۇرغۇن كۈنلەر ئۆتۈپ، مىسىرنىڭ پادىشاھى ئۆلدى. ئىسرائىللار ئۆز قۇللۇق ھالىتى تۈپەيلىدىن ئاھ-زار ئۇرۇپ، نالە-پەرياد كۆتۈردى؛ قۇللۇقتىن بولغان پەريادى خۇدانىڭ ھۇزۇرىغا بېرىپ يەتتى.
002	EXO	002	024	خۇدا ئۇلارنىڭ ئاھ-زارلىرىنى ئاڭلاپ، ئۆزىنىڭ ئىبراھىم بىلەن، ئىسھاق بىلەن ۋە ياقۇپ بىلەن تۈزگەن ئەھدىسىنى ئېسىگە ئالدى.
002	EXO	002	025	شۇنىڭ بىلەن خۇدا ئىسرائىللارنىڭ ھال-ئەھۋالىنى كۆردى ۋە خۇدا ئۇلارغا كۆڭۈل بۆلدى.
002	EXO	003	001	مۇسا بولسا قېينئاتىسى مىدىياننىڭ كاھىنى يەترونىڭ قوي پادىسىنى باقاتتى. ئۇ قويلارنى باشلاپ چۆلنىڭ ئەڭ چېتىگە خۇدانىڭ تېغى، يەنى ھورەب تېغىنىڭ باغرىغا كەلدى.
002	EXO	003	002	شۇ يەردە بىر ئازغانلىقتىن ئۆرلەپ چىقىۋاتقان ئوت يالقۇنى ئىچىدىن پەرۋەردىگارنىڭ پەرىشتىسى ئۇنىڭغا كۆرۈندى. مانا، ئازغانلىق ئوتتا كۆيۈۋاتقان بولسىمۇ، لېكىن ئازغان ئۆزى كۆيۈپ كەتمىگەنىدى.
002	EXO	003	003	مۇسا: ــ مەن بېرىپ، بۇ ئاجايىپ مەنزىرىنى كۆرۈپ باقاي؛ ئازغانلىق نېمىشقا كۆيۈپ كەتمەيدىغاندۇ؟ ــ دەپ ئويلىدى.
002	EXO	003	004	پەرۋەردىگار ئۇنىڭ بۇنى كۆرگىلى يولدىن چەتنەپ [ئازغانلىققا] كەلگىنىنى كۆردى؛ خۇدا ئازغانلىق ئىچىدىن ئۇنى: ــ مۇسا! مۇسا! ــ دەپ چاقىردى. ئۇ: مانا مەن! ــ دەپ جاۋاب بەردى.
002	EXO	003	005	ئۇ ئۇنىڭغا: ــ بۇ يەرگە يېقىن كەلمە؛ پۇتلىرىڭدىن كەشىڭنى سالغىن؛ چۈنكى سەن تۇرغان بۇ يەر مۇقەددەس جايدۇر.
002	EXO	003	006	مەن ئاتاڭنىڭ خۇداسى، ئىبراھىمنىڭ خۇداسى، ئىسھاقنىڭ خۇداسى ۋە ياقۇپنىڭ خۇداسىدۇرمەن، ــ دېدى. بۇنى ئاڭلاپ مۇسا خۇداغا قاراشتىن قورقۇپ، يۈزىنى ئېتىۋالدى.
002	EXO	003	007	پەرۋەردىگار ئۇنىڭغا مۇنداق دېدى: ــ بەرھەق، مەن مىسىردا تۇرۇۋاتقان قوۋمىمنىڭ تارتىۋاتقان ئازاب-ئوقۇبەتلىرىنى كۆردۇم، نازارەتچىلەرنىڭ ئۇلارنى [خارلاۋاتقانلىقىدىن] قىلغان پەريادىنى ئاڭلىدىم؛ چۈنكى مەن ئۇلارنىڭ دەردلىرىنى بىلىمەن.
002	EXO	003	008	شۇڭا مەن ئۇلارنى مىسىرلىقلارنىڭ قولىدىن قۇتقۇزۇپ، شۇ زېمىندىن چىقىرىپ، ياخشى ھەم كەڭ بىر زېمىنغا، سۈت بىلەن ھەسەل ئېقىپ تۇرىدىغان بىر زېمىنغا، يەنى قانائانىي، ھىتتىي، ئامورىي، پەرىززىي، ھىۋىي ۋە يەبۇسىيلارنىڭ يۇرتىغا ئېلىپ بېرىشقا چۈشتۈم.
002	EXO	003	009	مانا ئەمدى ئىسرائىللارنىڭ نالە-پەريادى ماڭا يەتتى، مىسىرلىقلارنىڭ ئۇلارغا قانداق زۇلۇم قىلغانلىقىنىمۇ كۆردۈم.
002	EXO	003	010	ئەمدى سەن كەل، مەن سېنى خەلقىم ئىسرائىللارنى مىسىردىن ئېلىپ چىقىرىش ئۈچۈن پىرەۋننىڭ ئالدىغا ئەۋەتىمەن، ــ دېدى.
002	EXO	003	011	لېكىن مۇسا خۇداغا: ــ مەن كىم ئىدىم، پىرەۋننىڭ ئالدىغا بېرىپ ئىسرائىللارنى مىسىردىن چىقىرالىغۇدەك؟ ــ دېدى.
002	EXO	003	012	ئۇ جاۋاب بېرىپ: ــ بەرھەق، مەن سەن بىلەن بىللە بولىمەن؛ سەن قوۋمنى مىسىردىن ئېلىپ چىققاندىن كېيىن بۇ تاغدا خۇداغا ئىبادەت قىلىسىلەر؛ بۇ ئىش مانا ئۆزۈڭگە مېنىڭ سېنى ئەۋەتكىنىمنىڭ ئىسپات-بەلگىسى بولىدۇ، ــ دېدى.
002	EXO	003	013	شۇنىڭ بىلەن مۇسا خۇداغا: ــ مەن ئىسرائىللارنىڭ قېشىغا بېرىپ ئۇلارغا: «ئاتا-بوۋىلىرىڭلارنىڭ خۇداسى مېنى قېشىڭلارغا ئەۋەتتى» دېسەم، ئۇلار مەندىن: «ئۇنىڭ نامى نېمە؟» ــ دەپ سورىسا، ئۇلارغا نېمە دەپ جاۋاب بېرىمەن؟ ــ دېدى.
002	EXO	003	014	خۇدا مۇساغا: ــ مەن «ئەزەلدىن بار بولغۇچى»دۇرمەن ــ دېدى. ئاندىن ئۇ: ــ بېرىپ، ئىسرائىللارغا: ««ئەزەلدىن بار بولغۇچى» مېنى قېشىڭلارغا ئەۋەتتى» دەپ ئېيتقىن، دېدى.
002	EXO	003	015	خۇدا مۇساغا يەنە: ــ ئىسرائىللارغا: ــ «ئاتا-بوۋىلىرىڭلارنىڭ خۇداسى، ئىبراھىمنىڭ خۇداسى، ئىسھاقنىڭ خۇداسى ۋە ياقۇپنىڭ خۇداسى بولغان «ياھۋەھ» مېنى قېشىڭلارغا ئەۋەتتى؛ ئۇ: [ياھۋەھ دېگەن] بۇ نام ئەبەدگىچە مېنىڭ نامىم بولىدۇ، دەۋردىن-دەۋرگىچە مەن شۇ نام بىلەن ئەسكە ئېلىنىمەن، دەيدۇ» ــ دېگىن.
002	EXO	003	016	ــ بېرىپ، ئىسرائىلنىڭ ئاقساقاللىرىنى يىغىپ ئۇلارغا: ــ «ئاتا-بوۋىلىرىڭلارنىڭ خۇداسى، يەنى ئىبراھىم، ئىسھاق ۋە ياقۇپنىڭ خۇداسى بولغان پەرۋەردىگار ماڭا كۆرۈنۈپ: ــ مەن سىلەرنى يوقلاپ كەلدىم، مىسىردا سىلەرگە قانداق مۇئامىلە قىلىنىۋاتقانلىقىنى كۆردۈم؛
002	EXO	003	017	شۇنىڭ ئۈچۈن سۆزۈم شۇدۇركى، مەن سىلەرنى مىسىرنىڭ زۇلۇمىدىن چىقىرىپ، قانائانىيلار، ھىتتىيلار، ئامورىيلار، پەرىززىيلەر، ھىۋىيلار ۋە يەبۇسىيلارنىڭ زېمىنى، يەنى سۈت بىلەن ھەسەل ئېقىپ تۇرىدىغان زېمىنغا ئېلىپ بارىمەن، دېدى، ــ دېگىن، دېدى.
002	EXO	003	018	ــ شۇنىڭ بىلەن ئۇلار سېنىڭ سۆزۈڭگە قۇلاق سالىدىغان بولىدۇ. ئۇ ۋاقىتتا سەن، ئۆزۈڭ ۋە ئىسرائىلنىڭ ئاقساقاللىرى بىلەن بىرگە مىسىر پادىشاھىنىڭ ئالدىغا بېرىپ، ئۇنىڭغا: «ئىبرانىيلارنىڭ خۇداسى پەرۋەردىگار بىز بىلەن كۆرۈشتى. ئەمدى سىزدىن ئۆتۈنىمىزكى، بىزگە ئۈچ كۈنلۈك يولنى بېسىپ، چۆلگە بېرىپ، خۇدايىمىز پەرۋەردىگارغا قۇربانلىق قىلىشقا ئىجازەت بەرگەيسىز» ــ دەڭلار.
002	EXO	003	019	لېكىن مىسىر پادىشاھىنىڭ ھەتتا قۇدرەتلىك بىر قولنىڭ ئاستىدا تۇرۇپمۇ، سىلەرنى يەنىلا قويۇپ بەرمەيدىغىنىنى بىلىمەن.
002	EXO	003	020	شۇڭا قولۇمنى ئۇزىتىپ، مىسىرلىقلارنى مەن ئۆز زېمىنى ئىچىدە كۆرسەتمەكچى بولغان ھەرخىل كارامەت-مۆجىزىلىرىم بىلەن ئۇرىمەن؛ ئاندىن [پىرەۋن] سىلەرنى قويۇپ بېرىدۇ.
002	EXO	003	021	بۇ قوۋمنى مىسىرلىقلارنىڭ ئالدىدا ئىلتىپات تاپتۇرىمەن ۋە شۇنىڭ بىلەن شۇنداق بولىدۇكى، سىلەر شۇ يەردىن چىققىنىڭلاردا، قۇرۇق قول چىقمايسىلەر.
002	EXO	003	022	بەلكى ھەربىر ئايال كىشى ئۆز قوشنىسىدىن ۋە ئۆز ئۆيىدە ئولتۇرۇشلۇق يات ئايالدىن كۈمۈش زىننەت بۇيۇملىرى، ئالتۇن زىننەت بۇيۇملىرى ۋە كىيىم-كېچەكلەرنى تەلەپ قىلىدۇ. بۇ نەرسىلەرنى ئوغۇل-قىزلىرىڭلارغا تاقايسىلەر، كىيدۈرىسىلەر؛ شۇ تەرىقىدە مىسىرلىقلاردىن ئولجا ئالغان بولىسىلەر، ــ دېدى.
002	EXO	004	001	مۇسا جاۋاب بېرىپ: ــ مانا، ئۇلار ماڭا ئىشەنمەي تۇرۇپ، سۆزۈمگە قۇلاق سالمايدۇ، بەلكى: «پەرۋەردىگار ساڭا كۆرۈنمىدى»، دېيىشى مۇمكىن، دېدى.
002	EXO	004	002	پەرۋەردىگار ئۇنىڭغا: ــ قولۇڭدىكى بۇ نېمە؟ ــ دەپ سورىدى. ئۇ: ــ بۇ بىر ھاسا، دەپ جاۋاب بەردى.
002	EXO	004	003	ئۇ: ــ ئۇنى يەرگە تاشلا، دېدى. ئۇنى يەرگە تاشلىۋىدى، ئۇ بىر يىلانغا ئايلاندى؛ مۇسا ئۇنىڭ ئالدىدىن قاچتى.
002	EXO	004	004	ئاندىن پەرۋەردىگار مۇساغا: ــ قولۇڭنى ئۇزىتىپ، ئۇنى قۇيرۇقىدىن تۇت، دېۋىدى، ئۇ قولىنى ئۇزىتىپ، ئۇنى تۇتتى. ئۇ يەنە ئۇنىڭ قولىدا ھاسىغا ئايلاندى.
002	EXO	004	005	[پەرۋەردىگار يەنە]: ــ بۇنىڭ بىلەن ئۇلار ئاتا-بوۋىلىرىنىڭ خۇداسى، يەنى ئىبراھىمنىڭ خۇداسى، ئىسھاقنىڭ خۇداسى ۋە ياقۇپنىڭ خۇداسى بولغان پەرۋەردىگارنىڭ ساڭا كۆرۈنگىنىگە ئىشىنىدۇ، ــ دېدى.
002	EXO	004	006	پەرۋەردىگار ئۇنىڭغا يەنە: ــ قولۇڭنى قوينۇڭغا سالغىن، دېۋىدى، ئۇ قولىنى قوينىغا سېلىپ چىقىرىۋىدى، مانا، قولى پېسە-ماخاۋ كېسىلىگە گىرىپتار بولۇپ قاردەك ئاقىرىپ كەتتى.
002	EXO	004	007	ئاندىن ئۇنىڭغا: ــ قولۇڭنى يەنە قوينۇڭغا سالغىن، دېۋىدى، قولىنى قوينىغا سالدى. ئۇنى يەنە قوينىدىن چىقىرىۋىدى، مانا، ئۆز ئەكسىگە كېلىپ ئەتلىرىنىڭ باشقا يەرلىرىدەك بولدى.
002	EXO	004	008	پەرۋەردىگار يەنە: ــ شۇنداق بولىدۇكى، ئەگەر ئۇلار ساڭا ئىشەنمەي، ئالدىنقى مۆجىزىلىك ئالامەتكە كۆڭۈلشىمىسە، ئۇلار ئىككىنچى مۆجىزىلىك ئالامەتكە ئىشىنىدۇ.
002	EXO	004	009	ھالبۇكى، ئۇلار بۇ ئىككى مۆجىزىگە يەنىلا ئىشەنمىسە ۋە يا سۆزۈڭگە قۇلاق سالمىسا، ئۇنداقتا سەن [نىل] دەرياسىنىڭ سۈيىدىن ئېلىپ، قۇرۇق يەرگە تۆككىن. شۇنىڭ بىلەن سەن دەريادىن ئالغان سۇ قۇرۇق يەر ئۈستىدە قانغا ئايلىنىدۇ، دېدى.
002	EXO	004	010	ئاندىن مۇسا پەرۋەردىگارغا: ــ ئەي ئىگەم، مەن ئەسلىدىنلا گەپكە ئۇستا ئەمەستىم، سەن قۇلۇڭغا سۆز قىلغاندىن كېيىنمۇ يەنىلا شۇنداق؛ چۈنكى مەن ئاغزىم كالۋا ۋە تىلىم ئېغىر ئادەممەن، ــ دېدى.
002	EXO	004	011	پەرۋەردىگار ئۇنىڭغا: ــ كىم ئىنسانغا ئېغىز بەرگەن؟ كىم ئادەمنى گاچا ياكى گاس، كۆرگۈچى ياكى كور قىلغان؟ شۇنداق قىلغۇچى مەن پەرۋەردىگار ئەمەسمۇ؟
002	EXO	004	012	ئەمدى سەن بارغىن، مەن ئۆزۈم سېنىڭ ئاغزىڭ بىلەن بىللە بولىمەن، نېمە سۆزلەيدىغىنىڭنى ساڭا ئۆگىتىپ تۇرىمەن، ــ دېدى.
002	EXO	004	013	لېكىن ئۇ: ــ ئەي ئىگەم! سەندىن ئۆتۈنۈپ قالاي، سەن [بۇ ئىشقا] خالىغان [باشقا] بىرسىنى ئەۋەتىپ، شۇنىڭ قولى بىلەن قىلغىن! ــ دېدى.
002	EXO	004	014	بۇنى ئاڭلاپ پەرۋەردىگارنىڭ غەزىپى مۇساغا تۇتىشىپ: ــ لاۋىيلاردىن بولغان ئاكاڭ ھارۇن بار ئەمەسمۇ؟ ئۇنىڭ گەپنى ئوبدان قىلالايدىغىنىنى بىلىمەن. مانا، ئۇ ئەمدى سېنىڭ ئالدىڭغا چىقىشقا ئاللىقاچان يولغا چىقتى؛ ئۇ سېنى كۆرسە، كۆڭلى تولىمۇ خۇش بولىدۇ.
002	EXO	004	015	ئەمدى دەيدىغان گەپلەرنى ئۇنىڭغا ئېيت؛ مەن ئۆزۈم سېنىڭ ئاغزىڭ بىلەن بىللە ۋە ئۇنىڭ ئاغزى بىلەن بىللە بولىمەن، نېمە قىلىش كېرەكلىكىڭلارنى سىلەرگە ئۆگىتىمەن.
002	EXO	004	016	ھارۇن سېنىڭ ئورنۇڭدا خەلققە سۆزلەيدۇ؛ شۇنداق بولىدۇكى، ئۇ ساڭا ئېغىز بولىدۇ، سەن ئۇنىڭغا خۇدادەك بولىسەن.
002	EXO	004	017	بۇ ھاسىنى قولۇڭغا ئېلىپ، ئۇنىڭ بىلەن شۇ مۆجىزىلىك ئالامەتلەرنى كۆرسىتىسەن، ــ دېدى.
002	EXO	004	018	شۇنىڭ بىلەن مۇسا قېينئاتىسى يەترونىڭ قېشىغا يېنىپ بېرىپ، ئۇنىڭغا: ــ ماڭا ئىجازەت بەرگەيلا، مىسىردىكى قېرىنداشلىرىمنىڭ قېشىغا باراي، ئۇلار ھاياتمۇ، ئەمەسمۇ كۆرۈپ كېلەي، دېدى. يەترو مۇساغا: ــ ئامان-ئېسەن بېرىپ كەلگىن، ــ دېدى.
002	EXO	004	019	مۇسا تېخى مىدىياندىكى ۋاقتىدا، پەرۋەردىگار ئۇنىڭغا يەنە: ــ مىسىرغا يېنىپ بارغىن! چۈنكى سېنىڭ جېنىڭنى ئىستىگەن كىشىلەر ئۆلۈپ كەتتى، ــ دېدى.
002	EXO	004	020	شۇنىڭ بىلەن مۇسا ئايالى ۋە ئوغۇللىرىنى ئېلىپ، ئۇلارنى بىر ئېشەككە مىندۈرۈپ، مىسىر زېمىنىغا بېرىشقا يولغا چىقتى. ماڭغاندا مۇسا خۇدانىڭ ھاسىسىنى ئالغاچ كەتتى.
002	EXO	004	021	پەرۋەردىگار مۇساغا: ــ مىسىرغا يېنىپ بارغىنىڭدا سەن ئاگاھ بول، مەن قولۇڭغا تاپشۇرغان بارلىق كارامەتلەرنى پىرەۋننىڭ ئالدىدا كۆرسەتكىن. لېكىن مەن ئۇنىڭ كۆڭلىنى خەلقنى قويۇپ بەرمىگۈدەك قاتتىق قىلىمەن.
002	EXO	004	022	سەن پىرەۋنگە: ــ «پەرۋەردىگار مۇنداق دەيدۇ: ــ ئىسرائىل مېنىڭ ئوغلۇم، مېنىڭ تۇنجى ئوغلۇم بولىدۇ.
002	EXO	004	023	شۇنىڭ ئۈچۈن مەن ساڭا: ئوغلۇمنى ئۆزۈمگە ئىبادەت قىلىشقا قويۇپ بەر، دېدىم. ئۇنىڭغا يول قويۇشنى رەت قىلىدىغان بولساڭ، سېنىڭ تۇنجى ئوغلۇڭنى ئۆلتۈرىمەن» ــ دېگىن، ــ دېدى.
002	EXO	004	024	ئەمما مۇسا سەپەر قىلىپ بىر قونالغۇغا كەلگەندە، پەرۋەردىگار ئۇنىڭغا ئۇچراپ، ئۇنى ئۆلتۈرۈۋەتمەكچى بولدى.
002	EXO	004	025	شۇنىڭ بىلەن زىپپوراھ بىر چاقماق تېشىنى ئېلىپ، ئوغلىنىڭ خەتنىلىكىنى كېسىپ، ئۇنى ئېرىنىڭ ئايىغىغا تاشلاپ: ــ سەن دەرۋەقە ئالدىمدا قان تۆكەر ئەر ئىكەنسەن! ــ دېدى.
002	EXO	004	026	شۇنىڭ بىلەن پەرۋەردىگار ئۇنى قويۇپ بەردى (بۇ چاغدا زىپپوراھ ئۇنىڭغا: «سەن دەرۋەقە ئالدىمدا قان تۆكەر بىر ئەر ئىكەنسەن!» ــ دېدى. بۇ سۆزىنى ئۇ خەتنە تۈپەيلىدىن ئېيتتى).
002	EXO	004	027	پەرۋەردىگار ھارۇنغا: ــ سەن چۆل-باياۋانغا بېرىپ، مۇسا بىلەن كۆرۈشكىن، دېۋىدى، ئۇ بېرىپ خۇدانىڭ تېغىدا ئۇنىڭ بىلەن ئۇچرىشىپ، ئۇنى سۆيدى.
002	EXO	004	028	مۇسا ئۆزىنى ئەۋەتكەن پەرۋەردىگارنىڭ ھەممە سۆزلىرى بىلەن قىلىشقا بۇيرۇغان بارلىق مۆجىزىلىك ئالامەتلەرنى ھارۇنغا دەپ بەردى.
002	EXO	004	029	ئاندىن مۇسا بىلەن ھارۇن بېرىپ، ئىسرائىللارنىڭ بارلىق ئاقساقاللىرىنى يىغدى.
002	EXO	004	030	ھارۇن پەرۋەردىگارنىڭ مۇساغا ئېيتقان ھەممە سۆزلىرىنى بايان قىلدى ۋە خەلقنىڭ كۆز ئالدىدا شۇ مۆجىزىلىك ئالامەتلەرنى كۆرسەتتى.
002	EXO	004	031	بۇنى كۆرۈپ، خەلق ئىشەندى؛ پەرۋەردىگارنىڭ ئىسرائىللارنى يوقلاپ، ئۇلار ئۇچرىغان خارلىقلارنى كۆرگەنلىكىنى ئاڭلىغان ھامان، باشلىرىنى ئېگىپ سەجدە قىلىشتى.
002	EXO	005	001	ئاندىن مۇسا بىلەن ھارۇن پىرەۋننىڭ ئالدىغا بېرىپ، ئۇنىڭغا: ــ ئىسرائىلنىڭ خۇداسى پەرۋەردىگار ساڭا: ــ «ئۇلارنىڭ بېرىپ چۆلدە ماڭا ئىبادەت قىلىپ، ھېيت ئۆتكۈزۈشىگە قوۋمىمغا يول قويسۇن» دەيدۇ، ــ دېدى.
002	EXO	005	002	لېكىن پىرەۋن جاۋاب بېرىپ: ــ ئۇنىڭ سۆزىگە قۇلاق سېلىپ، مېنى ئىسرائىلغا يول قويغۇزىدىغان قانداق پەرۋەردىگار ئىكەن ئۇ؟ مەن ئۇ پەرۋەردىگارنى تونۇمايمەن ھەم ئىسرائىلغىمۇ يول قويمايمەن، دېدى.
002	EXO	005	003	ئۇلار سۆز قىلىپ: ــ ئىبرانىيلارنىڭ خۇداسى بىز بىلەن كۆرۈشتى. شۇڭا ئۆتۈنىمىزكى، بىزگە پەرۋەردىگار خۇدايىمىزغا قۇربانلىق سۇنۇش ئۈچۈن بىزگە چۆلگە بېرىشقا ئۈچ كۈنلۈك يولغا رۇخسەت بەرگەيسىز. بولمىسا، ئۇ بىزنى ۋابا ياكى قىلىچ بىلەن ئۇرۇشى مۇمكىن، ــ دېدى.
002	EXO	005	004	لېكىن مىسىرنىڭ پادىشاھى ئۇلارغا جاۋاب بېرىپ: ــ ئەي مۇسا ۋە ھارۇن، نېمىشقا ئىككىڭلار خەلقنى ئىشلىرىدىن توختىتىپ قويماقچى بولىسىلەر؟ بېرىپ ئۆز ئەپكىشىڭلارنى كۆتۈرۈڭلار! ــ دېدى.
002	EXO	005	005	پىرەۋن يەنە: ــ مانا، خەلق يۇرتتا زىيادە ئاۋۇپ كەتتى. سىلەر بولساڭلار، ئۇلارنى ئەپكەشلىرىدىن خالاس قىلماقچىسىلەر، دېدى.
002	EXO	005	006	شۇ كۈنى پىرەۋن نازارەتچىلەرگە ۋە نازارەتچىلەرنىڭ قول ئاستىدىكى ئىش باشلىرىغا بۇيرۇق چۈشۈرۈپ: ــ
002	EXO	005	007	ھازىردىن باشلاپ خەلققە ئىلگىرىكىدەك كېسەك قۇيۇشقا سامان بەرمەڭلار! ئۇلار ساماننى ئۆزلىرى يىغسۇن.
002	EXO	005	008	لېكىن ئىلگىرى قانچىلىك كېسەك قۇيۇپ كەلگەن بولسا، ھېلىھەم كەم قىلماي شۇنچىلىك كېسەك قۇيدۇرۇڭلار؛ چۈنكى ئۇلار ھۇرۇنلىشىپ: «خۇدايىمىزغا قۇربانلىق ئۆتكۈزۈشكە بىزنى بارغىلى قوي» دەپ غەلۋە قىلىشىۋاتىدۇ.
002	EXO	005	009	ئەمدى ئۇلارنى ئۆز ئىشىغا تولۇق بەند بولۇپ، يالغان-ياۋىداق گەپلەرگە قۇلاق سالماسلىقى ئۈچۈن، بۇ ئادەملەرنىڭ ئۈستىگە تېخىمۇ ئېغىر ئەمگەكلەرنى يۈكلەڭلار، ــ دېدى.
002	EXO	005	010	شۇنىڭ بىلەن خەلقنىڭ ئۈستىدىكى نازارەتچىلەر بىلەن ئىش باشلىرى چىقىپ خەلققە: پىرەۋن شۇنداق دېدىكى، مەن ئەمدى سىلەرگە سامان بەرمەيدىغان بولدۇم.
002	EXO	005	011	ئۆزۈڭلار بېرىڭلار، ئۆزۈڭلار ئۈچۈن قەيەردىن سامان تاپالىساڭلار، شۇ يەردىن ئېلىپ كېلىڭلار؛ لېكىن قىلىدىغان ئىشلىرىڭلار بولسا قىلچىلىكمۇ كېمەيتىلمەيدۇ، ــ دېدى.
002	EXO	005	012	بۇنىڭ بىلەن خەلق پۈتكۈل مىسىر زېمىنىغا تارىلىپ، ساماننىڭ ئورنىغا پاخال يىغىشقا باشلىدى.
002	EXO	005	013	نازارەتچىلەر بولسا ئۇلارنى قىستاپ: سىلەرگە سامان بېرىلگەن چاغدىكىدەك ھازىرمۇ ھەر كۈنلۈك ئىشنى شۇ كۈنى قىلىڭلار، دېدى.
002	EXO	005	014	ئىسرائىللارنىڭ ئۈستىگە پىرەۋننىڭ نازارەتچىلىرى تەرىپىدىن قويۇلغان ئىسرائىللىق ئىش باشلىرى تاياق يېدى ۋە: ــ تۈنۈگۈن ۋە بۈگۈن نېمىشقا كېسەك قۇيۇش ۋەزىپسىنى بۇرۇنقىدەك توشقۇزۇپ ئورۇنلىمىدىڭلار؟! ــ دەپ تىل ئىشىتتى.
002	EXO	005	015	ئاندىن ئىسرائىللىق ئىش باشلىرى پىرەۋننىڭ ئالدىغا بېرىپ: نېمىشقا ئۆز قۇللىرىغا مۇنداق مۇئامىلە قىلىدىلا؟
002	EXO	005	016	ئۆز قۇللىرىغا ھېچ سامان بېرىلمىدى. لېكىن [نازارەتچىلەر] يەنىلا «كېسەك قۇيدۇرۇڭلار» دەپ بىزنى بۇيرۇيدۇ. مانا، ئۆز قۇللىرى تاياق يەۋاتىدۇ، ئەمما ئەيىب بولسا ئۆزلىرىنىڭ ئادەملىرىدە، دەپ پەرياد قىلدى.
002	EXO	005	017	لېكىن ئۇ يەنە: ــ سىلەر ھۇرۇن ئىكەنسىلەر! ھۇرۇن ئىكەنسىلەر! شۇڭا سىلەر: «بېرىپ پەرۋەردىگارغا قۇربانلىق ئۆتكۈزۈشىمىزگە ئىجازەت بەر دەۋاتىسىلەر.
002	EXO	005	018	قايتىپ بېرىپ ئىشىڭنى قىلىش! سىلەرگە سامان بېرىلمەيدۇ، بىراق كېسەكلەرنى بەلگىلەنگەن سان بويىچە [ئاۋۋالقىدەك] تولۇق تاپشۇرۇشىسەن، دېدى.
002	EXO	005	019	ئىسرائىللىق ئىش باشلىرى [پىرەۋننىڭ]: «سىلەر ھەركۈنلۈك ۋەزىپەڭلارنى، يەنى تەلەپ قىلغان كېسەكلەرنى بەلگىلەنگەن ساندىن كېمەيتسەڭلار قەتىي بولمايدۇ» دېگىنىگە قاراپ، بېشىغا بالا-قازانىڭ چۈشىدىغانلىقىنى بىلىشتى.
002	EXO	005	020	ئۇلار پىرەۋننىڭ ئالدىدىن چىقىپ كېلىۋاتقىنىدا، ئۇلار بىلەن كۆرۈشۈشكە كېلىپ شۇ يەردە ساقلاپ تۇرغان مۇسا ۋە ھارۇن بىلەن ئۇچرىشىپ قالدى.
002	EXO	005	021	ئۇلار مۇسا بىلەن ھارۇنغا: ــ بىزنى پىرەۋننىڭ نەزىرىدە ۋە ئۇنىڭ ئەمەلدارلىرىنىڭ نەزىرىدە سېسىتىپ، بىزنى ئۆلتۈرۈشكە ئۇلارنىڭ قولىغا قىلىچ تۇتقۇزغىنىڭلار ئۈچۈن، پەرۋەردىگار سىلەرنىڭ ئۈستۈڭلارغا ھۆكۈم قىلسۇن! ــ دېدى.
002	EXO	005	022	شۇنىڭ بىلەن مۇسا پەرۋەردىگارنىڭ ئالدىغا يېنىپ بېرىپ ئۇنىڭغا: ــ ئەي ئىگەم، نېمىشقا بۇ خەلقنى بالاغا تىقتىڭ؟ سەن نېمە ئۈچۈن مېنى ئەۋەتتىڭ؟
002	EXO	005	023	چۈنكى مەن پىرەۋننىڭ ئالدىغا كىرىپ سېنىڭ نامىڭ بىلەن سۆز قىلغىنىمدىن تارتىپ، ئۇ بۇ خەلقنىڭ ئۈستىگە تېخىمۇ زىيادە ئازاب قىلغىلى تۇردى. ئەمما سەن تېخىچە قوۋمىڭنى ھېچ قۇتقۇزمىدىڭ، ــ دېدى.
002	EXO	006	001	لېكىن پەرۋەردىگار مۇساغا: ــ ئەمدى سەن مېنىڭ پىرەۋنگە قىلىدىغانلىرىمنى كۆرىسەن؛ چۈنكى ئۇ قۇدرەتلىك بىر قولدىن مەجبۇرلىنىپ، ئۇلارنى قويۇپ بېرىدۇ، قۇدرەتلىك بىر قولنىڭ سەۋەبىدىن ئۆزىنىڭ زېمىنىدىن ئۇلارنى قوغلاپ چىقىرىۋېتىدۇ، ــ دېدى.
002	EXO	006	002	ئاندىن خۇدا مۇساغا [يەنە] سۆز قىلىپ مۇنداق دېدى: ــ مەن پەرۋەردىگاردۇرمەن.
002	EXO	006	003	مەن ئىبراھىمغا، ئىسھاققا ۋە ياقۇپقا قادىر-مۇتلەق تەڭرى سۈپىتىدە كۆرۈندۈم؛ لېكىن «ياھۋەھ» دېگەن نامىم بىلەن ئۇلارغا ئاشكارا تونۇلمىدىم.
002	EXO	006	004	مەن ئۇلار بىلەن: ــ «سىلەر مۇساپىر بولۇپ ئولتۇرغان زېمىننى، يەنى قانائان زېمىنىنى سىلەرگە بېرىمەن» دەپ، ئۇلار بىلەن ئەھدە باغلىشىپ ۋەدە قىلغانمەن.
002	EXO	006	005	ئەمدى مەن مىسىرلىقلار قۇل قىلىپ زۇلۇم سالغان ئىسرائىللارنىڭ ئاھ-زارلىرىنى ئاڭلاپ، قىلغان شۇ ئەھدەمنى ئېسىمگە ئالدىم.
002	EXO	006	006	شۇڭا ئىسرائىللارغا مۇنداق دېگىن: ــ «مەن پەرۋەردىگاردۇرمەن؛ مەن ئۆزۈم سىلەرنى مىسىرلىقلارنىڭ ئېغىر يۈكلىرى ئاستىدىن چىقىرىپ، ئۇلارنىڭ قۇللۇقىدىن ئازاد قىلىپ، قولۇمنى ئۇزىتىپ ئۇلارغا چوڭ بالايىئاپەتلەرنى چۈشۈرۈپ، سىلەرگە ھەمجەمەت بولۇپ ھۆرلۈككە ئېرىشتۈرىمەن.
002	EXO	006	007	سىلەرنى ئۆز قوۋمىم بولۇشقا قوبۇل قىلىمەن ۋە ئۆزۈم خۇدايىڭلار بولىمەن؛ شۇنىڭ بىلەن سىلەر ئۆزۈڭلارنى مىسىرلىقلارنىڭ يۈكلىرىنىڭ ئاستىدىن قۇتقۇزۇپ چىقارغۇچىنىڭ مەن خۇدايىڭلار پەرۋەردىگار ئىكەنلىكىنى بىلىسىلەر.
002	EXO	006	008	مەن شۇنىڭ بىلەن سىلەرنى قول كۆتۈرۈپ ئىبراھىمغا، ئىسھاققا ۋە ياقۇپقا بېرىشكە قەسەم قىلغان زېمىنغا ئېلىپ بارىمەن؛ مەن ئۇ يەرنى سىلەرگە مىراس قىلىپ زېمىنلىققا بېرىمەن؛ مەن پەرۋەردىگاردۇرمەن».
